@model CardDesignDetailVM
@{
    ViewData["Title"] = "Card design · Detail";
}
<main id="content" class="page">
    <a class="back" asp-area="Admin" asp-controller="CardDesign" asp-action="Index">All designs</a>

    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">UI · Cards</p>
            <h1>@Model.Title</h1>
            <p class="lede">One card face used on Home and on the cards customers hold.</p>
        </div>
        <span class="row-actions">
            <a class="btn btn-secondary" asp-area="Admin" asp-controller="CardDesign" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-back" asp-area="Admin" asp-controller="CardDesign" asp-action="Index">Go Back</a>
            <form method="post" asp-area="Admin" asp-controller="CardDesign" asp-action="Delete" asp-route-id="@Model.Id">
                <button type="submit" class="btn btn-danger"
                        data-confirm-title="Delete this design?"
                        data-confirm-text="A design used by a card type or by customer cards cannot be deleted."
                        data-confirm-yes="Delete" data-confirm-danger="true">Delete</button>
            </form>
        </span>
    </header>

    <div class="narrow stack-lg">
        <section class="surface">
            <p class="hint">How the card looks on Home and in the App (sample data)</p>
            <partial name="_CardPreview" model="new CardDesignPreviewVM { Title = Model.Title, Image = Model.Image, Large = true }" />
        </section>

        <section class="surface">
            <dl class="detail-list">
                <div><dt>Id</dt><dd>@Model.Id</dd></div>
                <div><dt>Title</dt><dd>@Model.Title</dd></div>
                <div><dt>Order</dt><dd>@Model.DisplayOrder</dd></div>
                <div>
                    <dt>On Home</dt>
                    <dd>
                        @if (Model.ShowOnHome)
                        {
                            <span class="badge badge-success">Shown</span>
                        }
                        else
                        {
                            <span class="badge badge-neutral">Hidden</span>
                        }
                    </dd>
                </div>
                <div><dt>Image path</dt><dd>@Model.Image</dd></div>
            </dl>
        </section>
    </div>
</main>
