@model ServiceSectionDetailVM
@{
    ViewData["Title"] = "Services heading";
    var cards = Model.Items;
}
<main id="content" class="page">
    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">@T["UI · Home page"]</p>
            <h1>@T["Services heading"]</h1>
            <p class="lede">@T["The heading text above the service cards. The cards are managed in"] <a asp-area="Admin" asp-controller="ServiceItem" asp-action="Index">@T["Service cards"]</a>.</p>
        </div>
        <a class="btn btn-secondary" asp-area="Admin" asp-controller="ServiceSection" asp-action="Edit">@T["Edit"]</a>
    </header>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@T[success]</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@T[error]</p>
    }

    <div class="narrow stack-lg">
        <section class="surface">
            <dl class="detail-list">
                <div><dt>@T["Label"]</dt><dd>@Model.Label</dd></div>
                <div><dt>@T["Title"]</dt><dd>@Model.Title</dd></div>
                <div><dt>@T["Description"]</dt><dd>@Model.Description</dd></div>
            </dl>
        </section>

        <section class="surface surface-tight">
            <div class="toolbar"><h2>@T["Cards ({0})", cards.Count]</h2></div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th class="num">@T["No"]</th><th>@T["Title"]</th><th class="actions">@T["Operations"]</th></tr></thead>
                    <tbody>
                        @foreach (var card in cards)
                        {
                            <tr>
                                <td class="num">@card.Number</td>
                                <td>@card.Title</td>
                                <td class="actions"><a class="btn btn-detail btn-sm" asp-area="Admin" asp-controller="ServiceItem" asp-action="Detail" asp-route-id="@card.Id">@T["Detail"]</a></td>
                            </tr>
                        }
                        @if (cards.Count == 0)
                        {
                            <tr><td colspan="3">@T["No cards yet."]</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
