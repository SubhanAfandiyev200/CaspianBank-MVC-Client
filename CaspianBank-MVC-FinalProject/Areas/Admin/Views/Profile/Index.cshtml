@model CaspianBank_MVC_FinalProject.ViewModels.Profile.ProfilePageVM
@using System.Security.Claims
@{
    ViewData["Title"] = "Profile";

    var roles = User.FindAll(ClaimTypes.Role).Select(claim => claim.Value).ToList();
    var roleNames = new Dictionary<string, string>
    {
        { AppRoles.SuperAdmin, "Super admin" },
        { AppRoles.Admin, "Administrator" },
        { AppRoles.Accountant, "Accountant" },
        { AppRoles.CustomerService, "Customer service" }
    };
    var roleText = string.Join(", ", roles.Where(role => roleNames.ContainsKey(role)).Select(role => T[roleNames[role]].ToString()));

    // Rola görə nə edə bildiyi (qısa)
    var duties = new List<string>();
    if (User.IsInRole(AppRoles.SuperAdmin))
    {
        duties.Add("Everything, including adding staff and changing roles.");
    }
    if (User.IsInRole(AppRoles.Admin))
    {
        duties.Add("Site content, translations, settings, bank rules, card types, loans, freezing accounts, messages and reports.");
    }
    if (User.IsInRole(AppRoles.Accountant))
    {
        duties.Add("Loan decisions, bank rules, card types, deposit terms and the treasury.");
    }
    if (User.IsInRole(AppRoles.CustomerService))
    {
        duties.Add("Customer messages, freezing accounts, reports, suspicious activity and the audit log.");
    }
}
<main id="content" class="page">
    <header class="page-head">
        <p class="eyebrow">@T["Account"]</p>
        <h1>@T["Profile"]</h1>
        <p class="lede">@T["Your staff account details."]</p>
    </header>

    @if (Model.Unavailable || Model.Profile is null)
    {
        <div class="empty">
            <h3>@T["We can't load your profile"]</h3>
            <p>@T["The service is unavailable right now. Please try again in a moment."]</p>
            <a class="btn btn-secondary" asp-action="Index">@T["Try again"]</a>
        </div>
    }
    else
    {
        var p = Model.Profile;
        <section class="surface profile-card">
            <div class="citizen-photo profile-photo staff-photo">
                @if (!string.IsNullOrEmpty(p.PhotoUrl))
                {
                    <img src="@p.PhotoUrl" alt="" onerror="this.remove()" />
                }
            </div>
            <div class="profile-body">
                <h2>@p.Name @p.Surname</h2>
                <dl class="profile-list">
                    <div><dt>@T["First name"]</dt><dd>@p.Name</dd></div>
                    <div><dt>@T["Last name"]</dt><dd>@p.Surname</dd></div>
                    <div><dt>@T["Email"]</dt><dd>@(string.IsNullOrEmpty(p.Email) ? T["Not set"] : p.Email)</dd></div>
                    <div><dt>@T["Role"]</dt><dd>@roleText</dd></div>
                </dl>
            </div>
        </section>

        <section class="surface mt-5">
            <h2>@T["What you can do"]</h2>
            <ul class="dep-notes">
                @foreach (var duty in duties)
                {
                    <li>@T[duty]</li>
                }
            </ul>
        </section>
    }
</main>
