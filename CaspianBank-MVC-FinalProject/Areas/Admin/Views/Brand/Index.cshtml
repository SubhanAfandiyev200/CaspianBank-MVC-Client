
@{
    ViewData["Title"] = "Brands";
}
@model IEnumerable<BrandVM>
<main id="content" class="page">
    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">@T["UI · Home page"]</p>
            <h1>@T["Brands"]</h1>
            <p class="lede">@T["The partner logos in the moving strip under the Home headline."]</p>
        </div>
        <a class="btn btn-primary" asp-area="Admin" asp-controller="Brand" asp-action="Create">@T["Create"]</a>
    </header>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@T[success]</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@T[error]</p>
    }

    <section class="surface surface-tight">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="num">@T["Id"]</th>
                        <th>@T["Logo"]</th>
                        <th>@T["Name"]</th>
                        <th>@T["Image path"]</th>
                        <th class="actions">@T["Operations"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model)
                    {
                        <tr>
                            <td class="num">@item.Id</td>
                            <td><img src="@ApiUrl.ToAbsolute(Configuration["ApiSettings:BaseUrl"], item.Image)" alt="@item.Name" style="display:block;height:32px;width:auto;max-width:120px;object-fit:contain" /></td>
                            <td>@item.Name</td>
                            <td>@item.Image</td>
                            <td class="actions">
                                <span class="row-actions">
                                    <a class="btn btn-detail btn-sm" asp-area="Admin" asp-controller="Brand" asp-action="Detail" asp-route-id="@item.Id">@T["Detail"]</a>
                                    <a class="btn btn-secondary btn-sm" asp-area="Admin" asp-controller="Brand" asp-action="Edit" asp-route-id="@item.Id">@T["Edit"]</a>
                                    <form method="post" asp-area="Admin" asp-controller="Brand" asp-action="Delete" asp-route-id="@item.Id">
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                data-confirm-title="@T["Delete this brand?"]"
                                                data-confirm-text="@T["The logo will disappear from the Home page."]"
                                                data-confirm-yes="@T["Delete"]" data-confirm-danger="true">
                                            @T["Delete"]
                                        </button>
                                    </form>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>
