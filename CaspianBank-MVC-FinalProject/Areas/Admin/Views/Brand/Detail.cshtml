@model BrandDetailVM
@{
    ViewData["Title"] = "Brand · Detail";
}
<main id="content" class="page">
    <a class="back" asp-area="Admin" asp-controller="Brand" asp-action="Index">@T["All brands"]</a>

    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">@T["UI · Home page"]</p>
            <h1>@Model.Name</h1>
            <p class="lede">@T["One partner logo from the moving strip on the Home page."]</p>
        </div>
        <span class="row-actions">
            <a class="btn btn-secondary" asp-area="Admin" asp-controller="Brand" asp-action="Edit" asp-route-id="@Model.Id">@T["Edit"]</a>
            <a class="btn btn-back" asp-area="Admin" asp-controller="Brand" asp-action="Index">@T["Go Back"]</a>
            <form method="post" asp-area="Admin" asp-controller="Brand" asp-action="Delete" asp-route-id="@Model.Id">
                <button type="submit" class="btn btn-danger"
                        data-confirm-title="@T["Delete this brand?"]"
                        data-confirm-text="@T["The logo will disappear from the Home page."]"
                        data-confirm-yes="@T["Delete"]" data-confirm-danger="true">@T["Delete"]</button>
            </form>
        </span>
    </header>

    <div class="narrow stack-lg">
        <section class="surface">
            <dl class="detail-list">
                <div><dt>@T["Id"]</dt><dd>@Model.Id</dd></div>
                <div><dt>@T["Name"]</dt><dd>@Model.Name</dd></div>
                <div><dt>@T["Image path"]</dt><dd>@Model.Image</dd></div>
                <div>
                    <dt>@T["Logo"]</dt>
                    <dd><img src="@ApiUrl.ToAbsolute(Configuration["ApiSettings:BaseUrl"], Model.Image)" alt="@Model.Name" style="display:block;height:48px;width:auto;max-width:200px;object-fit:contain" /></dd>
                </div>
            </dl>
        </section>
    </div>
</main>
