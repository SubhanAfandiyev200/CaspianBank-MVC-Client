@model LoanReviewPageVM
@{
    ViewData["Title"] = "Loans";
    var statuses = new[] { "Pending", "Offered", "Active", "Court", "Closed", "Rejected", "Declined" };

    string PageUrl(int page)
    {
        return Url.Action("Index", "Loans", new { area = "Admin", status = Model.Status, search = Model.Search, page }) ?? "#";
    }
}
<main id="content" class="page">
    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">Credit</p>
            <h1>Loan approvals</h1>
            <p class="lede">Review applications, open the applicant's file and approve or reject. @Model.PendingCount waiting for a decision.</p>
        </div>
    </header>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@success</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@error</p>
    }

    @if (Model.Unavailable)
    {
        <p class="flash flash-error" role="alert">The loan list can't be loaded right now. Please try again in a moment.</p>
    }

    <section class="surface surface-tight">
        <form method="get" asp-area="Admin" asp-controller="Loans" asp-action="Index" class="toolbar filters">
            <div class="field grow">
                <label for="search">Search</label>
                <input class="input" id="search" name="search" type="search" placeholder="Name, FIN or payment code" value="@Model.Search" />
            </div>
            <div class="field">
                <label for="status">Status</label>
                <select class="select" data-wheel id="status" name="status">
                    <option value="" selected="@string.IsNullOrEmpty(Model.Status)">All</option>
                    @foreach (var status in statuses)
                    {
                        <option value="@status" selected="@(Model.Status == status)">@LoanUi.StaffStatusText(status)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <button class="btn btn-primary" type="submit">Filter</button>
            </div>
        </form>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Applicant</th>
                        <th>Loan</th>
                        <th class="num">Amount</th>
                        <th>Purpose</th>
                        <th>Term</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th class="actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@item.ApplicantName</strong>
                                <div class="hint">FIN @(item.Fin ?? "—")</div>
                            </td>
                            <td>@item.ContractNumber</td>
                            <td class="num">
                                @LoanUi.Money(item.RequestedAmount)
                                @if (item.ApprovedAmount.HasValue && item.ApprovedAmount.Value != item.RequestedAmount)
                                {
                                    <div class="hint">approved @LoanUi.Money(item.ApprovedAmount.Value)</div>
                                }
                            </td>
                            <td>@LoanUi.PurposeText(item.Purpose)</td>
                            <td>@item.TermMonths months</td>
                            <td>@LoanUi.Date(item.CreatedAt.ToLocalTime())</td>
                            <td><span class="badge @LoanUi.StatusBadge(item.Status)">@LoanUi.StaffStatusText(item.Status)</span></td>
                            <td class="actions">
                                <span class="row-actions">
                                    <a class="btn @(item.Status == "Pending" ? "btn-primary" : "btn-detail") btn-sm" asp-area="Admin" asp-controller="Loans" asp-action="Detail" asp-route-id="@item.Id">@(item.Status == "Pending" ? "Review" : "Detail")</a>
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8">No loans found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <partial name="_Pager" model="new CaspianBank_MVC_FinalProject.ViewModels.Common.PagerVM { Page = Model.Page, PageSize = Model.PageSize, TotalCount = Model.TotalCount, TotalPages = Model.TotalPages, Url = PageUrl }" />
</main>
