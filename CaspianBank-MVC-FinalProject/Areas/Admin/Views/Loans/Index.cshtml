@model LoanReviewPageVM
@{
    ViewData["Title"] = "Loans";
    var statuses = new[] { "Pending", "AwaitingSuperAdmin", "Offered", "Active", "Court", "Closed", "Rejected", "Declined" };

    string PageUrl(int page)
    {
        return Url.Action("Index", "Loans", new { area = "Admin", status = Model.Status, search = Model.Search, page }) ?? "#";
    }
}
<main id="content" class="page">
    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">@T["Credit"]</p>
            <h1>@T["Loan approvals"]</h1>
            <p class="lede">@T["Review applications, open the applicant's file and approve or reject. {0} waiting for a decision.", Model.PendingCount]@(Model.AwaitingSuperAdminCount > 0 ? " " + T["{0} waiting for the Super Admin.", Model.AwaitingSuperAdminCount] : "")</p>
        </div>
    </header>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@T[success]</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@T[error]</p>
    }

    @if (Model.Unavailable)
    {
        <p class="flash flash-error" role="alert">@T["The loan list can't be loaded right now. Please try again in a moment."]</p>
    }

    <section class="surface surface-tight">
        <form method="get" asp-area="Admin" asp-controller="Loans" asp-action="Index" class="toolbar filters">
            <div class="field grow">
                <label for="search">@T["Search"]</label>
                <input class="input" id="search" name="search" type="search" placeholder="@T["Name, FIN or payment code"]" value="@Model.Search" />
            </div>
            <div class="field">
                <label for="status">@T["Status"]</label>
                <select class="select" data-wheel id="status" name="status">
                    <option value="" selected="@string.IsNullOrEmpty(Model.Status)">@T["All"]</option>
                    @foreach (var status in statuses)
                    {
                        <option value="@status" selected="@(Model.Status == status)">@T[LoanUi.StaffStatusText(status)]</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <button class="btn btn-primary" type="submit">@T["Filter"]</button>
            </div>
        </form>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@T["Applicant"]</th>
                        <th>@T["Loan"]</th>
                        <th class="num">@T["Amount"]</th>
                        <th>@T["Purpose"]</th>
                        <th>@T["Term"]</th>
                        <th>@T["Submitted"]</th>
                        <th>@T["Status"]</th>
                        <th class="actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@item.ApplicantName</strong>
                                <div class="hint">@T["FIN"] @(item.Fin ?? "—")</div>
                            </td>
                            <td>@item.ContractNumber</td>
                            <td class="num">
                                @LoanUi.Money(item.RequestedAmount)
                                @if (item.ApprovedAmount.HasValue && item.ApprovedAmount.Value != item.RequestedAmount)
                                {
                                    <div class="hint">@T["approved {0}", LoanUi.Money(item.ApprovedAmount.Value)]</div>
                                }
                            </td>
                            <td>@T[LoanUi.PurposeText(item.Purpose)]</td>
                            <td>@T["{0} months", item.TermMonths]</td>
                            <td>@LoanUi.Date(item.CreatedAt.ToLocalTime())</td>
                            <td><span class="badge @LoanUi.StatusBadge(item.Status)">@T[LoanUi.StaffStatusText(item.Status)]</span>@if (item.RequiresSuperAdmin) {<span class="badge badge-blacklist" title="@T["Blacklisted customer: the loan staff and the Super Admin must both approve"]">@T["Blacklisted"]</span>}</td>
                            <td class="actions">
                                <span class="row-actions">
                                    <a class="btn @(item.Status == "Pending" || item.Status == "AwaitingSuperAdmin" ? "btn-primary" : "btn-detail") btn-sm" asp-area="Admin" asp-controller="Loans" asp-action="Detail" asp-route-id="@item.Id">@(item.Status == "Pending" || item.Status == "AwaitingSuperAdmin" ? "Review" : "Detail")</a>
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8">@T["No loans found."]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <partial name="_Pager" model="new CaspianBank_MVC_FinalProject.ViewModels.Common.PagerVM { Page = Model.Page, PageSize = Model.PageSize, TotalCount = Model.TotalCount, TotalPages = Model.TotalPages, Url = PageUrl }" />
</main>
