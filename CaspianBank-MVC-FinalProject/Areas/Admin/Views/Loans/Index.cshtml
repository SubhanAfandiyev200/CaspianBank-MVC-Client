@{
    ViewData["Title"] = "Loans";
}
<main id="content" class="page">
    <header class="page-head">
        <p class="eyebrow">Credit</p>
        <h1>Loan approvals</h1>
        <p class="lede">Approve or decline applications that are still pending.</p>
    </header>

    @* Hələlik statik dizayn (nümunə sətirlər) *@
    <section class="surface surface-tight">
        <div class="toolbar filters">
            <div class="field">
                <label for="status">Status</label>
                <select class="select" id="status">
                    <option value="all">All</option>
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Declined">Declined</option>
                </select>
            </div>
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Applicant</th>
                        <th class="num">Amount</th>
                        <th>Purpose</th>
                        <th>Term</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th class="actions"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Leyla Mammadova</td>
                        <td class="num">12,000.00 AZN</td>
                        <td>Education</td>
                        <td>36 months</td>
                        <td>05 Oct 2026</td>
                        <td><span class="badge badge-pending">Pending</span></td>
                        <td class="actions">
                            <button type="button" class="btn btn-primary btn-sm"
                                    data-confirm-title="Approve this loan?"
                                    data-confirm-text="Leyla Mammadova requested 12,000.00 AZN over 36 months."
                                    data-confirm-yes="Approve">Approve</button>
                            <button type="button" class="btn btn-danger btn-sm"
                                    data-confirm-title="Decline this loan?"
                                    data-confirm-text="Leyla Mammadova requested 12,000.00 AZN over 36 months."
                                    data-confirm-yes="Decline" data-confirm-danger="true">Decline</button>
                        </td>
                    </tr>
                    <tr>
                        <td>Rashad Huseynov</td>
                        <td class="num">8,000.00 AZN</td>
                        <td>Car repair</td>
                        <td>18 months</td>
                        <td>06 Oct 2026</td>
                        <td><span class="badge badge-pending">Pending</span></td>
                        <td class="actions">
                            <button type="button" class="btn btn-primary btn-sm"
                                    data-confirm-title="Approve this loan?"
                                    data-confirm-text="Rashad Huseynov requested 8,000.00 AZN over 18 months."
                                    data-confirm-yes="Approve">Approve</button>
                            <button type="button" class="btn btn-danger btn-sm"
                                    data-confirm-title="Decline this loan?"
                                    data-confirm-text="Rashad Huseynov requested 8,000.00 AZN over 18 months."
                                    data-confirm-yes="Decline" data-confirm-danger="true">Decline</button>
                        </td>
                    </tr>
                    <tr>
                        <td>Tural Ismayilov</td>
                        <td class="num">20,000.00 AZN</td>
                        <td>Business stock</td>
                        <td>48 months</td>
                        <td>17 Sep 2026</td>
                        <td><span class="badge badge-success">Approved</span></td>
                        <td class="actions"></td>
                    </tr>
                    <tr>
                        <td>Sevinc Mammadli</td>
                        <td class="num">3,500.00 AZN</td>
                        <td>Travel</td>
                        <td>12 months</td>
                        <td>22 Sep 2026</td>
                        <td><span class="badge badge-danger">Declined</span></td>
                        <td class="actions"></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</main>
