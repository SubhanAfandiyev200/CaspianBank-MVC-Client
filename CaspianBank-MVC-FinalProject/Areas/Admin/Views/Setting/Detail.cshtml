@model SettingDetailVM
@{
    ViewData["Title"] = "Setting · Detail";
}
<main id="content" class="page">
    <a class="back" asp-area="Admin" asp-controller="Setting" asp-action="Index">@T["All settings"]</a>

    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">@T["UI · Site"]</p>
            <h1>@SettingLabels.For(Model.Key)</h1>
            <p class="lede">@SettingLabels.Hint(Model.Key)</p>
        </div>
        <span class="row-actions">
            <a class="btn btn-secondary" asp-area="Admin" asp-controller="Setting" asp-action="Edit" asp-route-id="@Model.Id">@T["Edit"]</a>
            <a class="btn btn-back" asp-area="Admin" asp-controller="Setting" asp-action="Index">@T["Go Back"]</a>
        </span>
    </header>

    <div class="narrow stack-lg">
        <section class="surface">
            <dl class="detail-list">
                <div><dt>@T["Id"]</dt><dd>@Model.Id</dd></div>
                <div><dt>@T["Setting"]</dt><dd>@SettingLabels.For(Model.Key)</dd></div>
                <div><dt>@T["Key"]</dt><dd>@Model.Key</dd></div>
                @if (SettingLabels.IsLogo(Model.Key))
                {
                    <div><dt>@T["Image path"]</dt><dd>@Model.Value</dd></div>
                    <div>
                        <dt>@T["Logo"]</dt>
                        <dd><img src="@ApiUrl.ToAbsolute(Configuration["ApiSettings:BaseUrl"], Model.Value)" alt="@T["Logo"]" style="display:block;height:64px;width:auto;max-width:240px;object-fit:contain" /></dd>
                    </div>
                }
                else
                {
                    <div><dt>@T["Value"]</dt><dd>@Model.Value</dd></div>
                }
            </dl>
        </section>
    </div>
</main>
