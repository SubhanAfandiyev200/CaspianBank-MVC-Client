@model CaspianBank_MVC_FinalProject.ViewModels.Support.TicketPageVM
@using System.Globalization
@{
    ViewData["Title"] = "Contact tickets";
    var inv = CultureInfo.InvariantCulture;

    string PageUrl(int page)
    {
        return Url.Action("Index", "Tickets", new { area = "Admin", status = Model.Status, search = Model.Search, page }) ?? "#";
    }
}
<main id="content" class="page">
    <header class="page-head">
        <p class="eyebrow">Support</p>
        <h1>Contact tickets</h1>
        <p class="lede">Messages from customers. Open one to reply. @Model.PendingCount waiting for an answer.</p>
    </header>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@success</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@error</p>
    }
    @if (Model.Unavailable)
    {
        <p class="flash flash-error" role="alert">The messages can't be loaded right now. Please try again in a moment.</p>
    }

    <section class="surface surface-tight">
        <form method="get" asp-area="Admin" asp-controller="Tickets" asp-action="Index" class="toolbar filters">
            <div class="field grow">
                <label for="search">Search</label>
                <input class="input" id="search" name="search" type="search" placeholder="Subject, customer name or email" value="@Model.Search" autocomplete="off" />
            </div>
            <div class="field">
                <label for="status">Status</label>
                <select class="select" data-wheel id="status" name="status">
                    <option value="" selected="@string.IsNullOrEmpty(Model.Status)">All</option>
                    <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                    <option value="Answered" selected="@(Model.Status == "Answered")">Answered</option>
                    <option value="Closed" selected="@(Model.Status == "Closed")">Closed</option>
                </select>
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <button class="btn btn-primary" type="submit">Filter</button>
            </div>
        </form>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Subject</th>
                        <th>Last activity</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@item.CustomerName</strong>
                                <div class="hint">@item.CustomerEmail</div>
                            </td>
                            <td>
                                <a asp-area="Admin" asp-controller="Tickets" asp-action="Detail" asp-route-id="@item.Id"><strong>@item.Subject</strong></a>
                                <div class="hint">@item.LastMessagePreview</div>
                            </td>
                            <td>@item.LastActivityAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm", inv)</td>
                            <td>
                                @if (item.Status == "Answered")
                                {
                                    <span class="badge badge-success">Answered</span>
                                }
                                else if (item.Status == "Closed")
                                {
                                    <span class="badge badge-neutral">Closed</span>
                                }
                                else
                                {
                                    <span class="badge badge-pending">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="4">No messages found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <partial name="_Pager" model="new CaspianBank_MVC_FinalProject.ViewModels.Common.PagerVM { Page = Model.Page, PageSize = Model.PageSize, TotalCount = Model.TotalCount, TotalPages = Model.TotalPages, Url = PageUrl }" />
</main>
