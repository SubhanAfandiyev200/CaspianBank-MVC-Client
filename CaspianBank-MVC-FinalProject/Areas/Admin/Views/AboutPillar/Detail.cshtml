@model AboutPillarDetailVM
@{
    ViewData["Title"] = "About pillar · Detail";
}
<main id="content" class="page">
    <a class="back" asp-area="Admin" asp-controller="AboutPillar" asp-action="Index">All pillars</a>

    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">UI · Home page</p>
            <h1>@Model.Title</h1>
            <p class="lede">One column of the About block on the Home page.</p>
        </div>
        <span class="row-actions">
            <a class="btn btn-secondary" asp-area="Admin" asp-controller="AboutPillar" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-back" asp-area="Admin" asp-controller="AboutPillar" asp-action="Index">Go Back</a>
            <form method="post" asp-area="Admin" asp-controller="AboutPillar" asp-action="Delete" asp-route-id="@Model.Id">
                <button type="submit" class="btn btn-danger"
                        data-confirm-title="Delete this pillar?"
                        data-confirm-text="It will disappear from the About block on the Home page."
                        data-confirm-yes="Delete" data-confirm-danger="true">Delete</button>
            </form>
        </span>
    </header>

    <div class="narrow stack-lg">
        <section class="surface">
            <dl class="detail-list">
                <div><dt>Id</dt><dd>@Model.Id</dd></div>
                <div><dt>Title</dt><dd>@Model.Title</dd></div>
                <div><dt>Description</dt><dd>@Model.Description</dd></div>
                <div><dt>Image path</dt><dd>@Model.Image</dd></div>
                <div>
                    <dt>Image</dt>
                    <dd><img src="@ApiUrl.ToAbsolute(Configuration["ApiSettings:BaseUrl"], Model.Image)" alt="@Model.Title" style="display:block;height:64px;width:auto;max-width:200px;object-fit:contain" /></dd>
                </div>
            </dl>
        </section>
    </div>
</main>
