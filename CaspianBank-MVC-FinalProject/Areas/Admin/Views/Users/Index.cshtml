@model CaspianBank_MVC_FinalProject.ViewModels.Users.UserPageVM
@{
    ViewData["Title"] = "Users";

    string PageUrl(int page)
    {
        return Url.Action("Index", "Users", new { area = "Admin", search = Model.Search, status = Model.Status, page }) ?? "#";
    }
}
<main id="content" class="page">
    <header class="page-head">
        <p class="eyebrow">@T["Operations"]</p>
        <h1>@T["Users"]</h1>
        <p class="lede">@T["Search the customer book, open a profile, or restrict an account. {0} restricted at the moment.", Model.RestrictedCount]</p>
    </header>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@T[success]</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@T[error]</p>
    }
    @if (Model.Unavailable)
    {
        <p class="flash flash-error" role="alert">@T["The customer list can't be loaded right now. Please try again in a moment."]</p>
    }

    <section class="surface surface-tight">
        <form method="get" asp-area="Admin" asp-controller="Users" asp-action="Index" class="toolbar filters">
            <div class="field grow">
                <label for="search">@T["Search"]</label>
                <input class="input" id="search" name="search" type="search" placeholder="@T["Name, email, phone, FIN, ID or card number"]" value="@Model.Search" autocomplete="off" />
            </div>
            <div class="field">
                <label for="status">@T["Status"]</label>
                <select class="select" data-wheel id="status" name="status">
                    <option value="" selected="@string.IsNullOrEmpty(Model.Status)">@T["All"]</option>
                    <option value="Active" selected="@(Model.Status == "Active")">@T["Active"]</option>
                    <option value="Restricted" selected="@(Model.Status == "Restricted")">@T["Restricted"]</option>
                </select>
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <button class="btn btn-primary" type="submit">@T["Filter"]</button>
            </div>
        </form>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@T["Name"]</th>
                        <th>@T["Email"]</th>
                        <th>@T["Phone"]</th>
                        <th class="num">@T["Cards"]</th>
                        <th class="num">@T["Total balance"]</th>
                        <th>@T["Registered"]</th>
                        <th>@T["Status"]</th>
                        <th class="actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@item.FullName</strong>
                                <div class="hint">@T["FIN"] @(item.Fin ?? "—")</div>
                            </td>
                            <td>@item.Email</td>
                            <td>@(item.Phone ?? "—")</td>
                            <td class="num">@item.CardCount</td>
                            <td class="num">@LoanUi.Money(item.TotalBalance)</td>
                            <td>@LoanUi.Date(item.RegisteredAt.ToLocalTime())</td>
                            <td>
                                @if (item.IsRestricted)
                                {
                                    <span class="badge badge-danger">@T["Restricted"]</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">@T["Active"]</span>
                                }
                            </td>
                            <td class="actions">
                                <span class="row-actions">
                                    <a class="btn btn-detail btn-sm" asp-area="Admin" asp-controller="Users" asp-action="Detail" asp-route-id="@item.Id">@T["View"]</a>
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8">@T["No customers found."]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <partial name="_Pager" model="new CaspianBank_MVC_FinalProject.ViewModels.Common.PagerVM { Page = Model.Page, PageSize = Model.PageSize, TotalCount = Model.TotalCount, TotalPages = Model.TotalPages, Url = PageUrl }" />
</main>
