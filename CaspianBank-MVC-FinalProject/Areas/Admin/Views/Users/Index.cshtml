@model CaspianBank_MVC_FinalProject.ViewModels.Users.UserPageVM
@{
    ViewData["Title"] = "Users";

    string PageUrl(int page)
    {
        return Url.Action("Index", "Users", new { area = "Admin", search = Model.Search, status = Model.Status, page }) ?? "#";
    }
}
<main id="content" class="page">
    <header class="page-head">
        <p class="eyebrow">Operations</p>
        <h1>Users</h1>
        <p class="lede">Search the customer book, open a profile, or restrict an account. @Model.RestrictedCount restricted at the moment.</p>
    </header>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@success</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@error</p>
    }
    @if (Model.Unavailable)
    {
        <p class="flash flash-error" role="alert">The customer list can't be loaded right now. Please try again in a moment.</p>
    }

    <section class="surface surface-tight">
        <form method="get" asp-area="Admin" asp-controller="Users" asp-action="Index" class="toolbar filters">
            <div class="field grow">
                <label for="search">Search</label>
                <input class="input" id="search" name="search" type="search" placeholder="Name, email, phone or FIN" value="@Model.Search" autocomplete="off" />
            </div>
            <div class="field">
                <label for="status">Status</label>
                <select class="select" data-wheel id="status" name="status">
                    <option value="" selected="@string.IsNullOrEmpty(Model.Status)">All</option>
                    <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                    <option value="Restricted" selected="@(Model.Status == "Restricted")">Restricted</option>
                </select>
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <button class="btn btn-primary" type="submit">Filter</button>
            </div>
        </form>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th class="num">Cards</th>
                        <th class="num">Total balance</th>
                        <th>Registered</th>
                        <th>Status</th>
                        <th class="actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@item.FullName</strong>
                                <div class="hint">FIN @(item.Fin ?? "—")</div>
                            </td>
                            <td>@item.Email</td>
                            <td>@(item.Phone ?? "—")</td>
                            <td class="num">@item.CardCount</td>
                            <td class="num">@LoanUi.Money(item.TotalBalance)</td>
                            <td>@LoanUi.Date(item.RegisteredAt.ToLocalTime())</td>
                            <td>
                                @if (item.IsRestricted)
                                {
                                    <span class="badge badge-danger">Restricted</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                            </td>
                            <td class="actions">
                                <span class="row-actions">
                                    <a class="btn btn-detail btn-sm" asp-area="Admin" asp-controller="Users" asp-action="Detail" asp-route-id="@item.Id">View</a>
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8">No customers found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <partial name="_Pager" model="new CaspianBank_MVC_FinalProject.ViewModels.Common.PagerVM { Page = Model.Page, PageSize = Model.PageSize, TotalCount = Model.TotalCount, TotalPages = Model.TotalPages, Url = PageUrl }" />
</main>
