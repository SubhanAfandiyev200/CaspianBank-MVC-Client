@{
    ViewData["Title"] = "Users";
}
<main id="content" class="page">
    <header class="page-head">
        <p class="eyebrow">Operations</p>
        <h1>Users</h1>
        <p class="lede">Search the customer book, open a profile, or restrict an account.</p>
    </header>

    @* Hələlik statik dizayn (nümunə sətirlər): siyahı və axtarış API hazır olanda işləyəcək *@
    <section class="surface surface-tight">
        <div class="toolbar filters">
            <div class="field grow">
                <label for="q">Search</label>
                <input class="input" id="q" type="search" placeholder="Name, email, or phone" />
            </div>
            <div class="field">
                <label for="status">Status</label>
                <select class="select" id="status">
                    <option value="all">All</option>
                    <option value="Active">Active</option>
                    <option value="Restricted">Restricted</option>
                </select>
            </div>
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Registered</th>
                        <th>Status</th>
                        <th class="actions"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Leyla Mammadova</td>
                        <td>leyla.mammadova@gmail.com</td>
                        <td>+994 50 312 44 18</td>
                        <td>18 Apr 2023</td>
                        <td><span class="badge badge-success">Active</span></td>
                        <td class="actions">
                            <a class="btn btn-secondary btn-sm" asp-area="Admin" asp-controller="Users" asp-action="Detail">View</a>
                            <button type="button" class="btn btn-danger btn-sm"
                                    data-confirm-title="Restrict this account?"
                                    data-confirm-text="Leyla Mammadova will be unable to move money until the account is restored."
                                    data-confirm-yes="Restrict account" data-confirm-danger="true">Restrict</button>
                        </td>
                    </tr>
                    <tr>
                        <td>Rashad Huseynov</td>
                        <td>rashad.huseynov@gmail.com</td>
                        <td>+994 55 201 90 14</td>
                        <td>09 Jan 2024</td>
                        <td><span class="badge badge-success">Active</span></td>
                        <td class="actions">
                            <a class="btn btn-secondary btn-sm" asp-area="Admin" asp-controller="Users" asp-action="Detail">View</a>
                            <button type="button" class="btn btn-danger btn-sm"
                                    data-confirm-title="Restrict this account?"
                                    data-confirm-text="Rashad Huseynov will be unable to move money until the account is restored."
                                    data-confirm-yes="Restrict account" data-confirm-danger="true">Restrict</button>
                        </td>
                    </tr>
                    <tr>
                        <td>Elvin Qasimov</td>
                        <td>elvin.qasimov@gmail.com</td>
                        <td>+994 51 440 18 77</td>
                        <td>21 Jun 2025</td>
                        <td><span class="badge badge-danger">Restricted</span></td>
                        <td class="actions">
                            <a class="btn btn-secondary btn-sm" asp-area="Admin" asp-controller="Users" asp-action="Detail">View</a>
                            <button type="button" class="btn btn-danger btn-sm"
                                    data-confirm-title="Restore this account?"
                                    data-confirm-text="Elvin Qasimov will be able to transact again."
                                    data-confirm-yes="Unfreeze">Unfreeze</button>
                        </td>
                    </tr>
                    <tr>
                        <td>Tural Ismayilov</td>
                        <td>tural.ismayil@outlook.com</td>
                        <td>+994 55 673 00 19</td>
                        <td>14 Feb 2021</td>
                        <td><span class="badge badge-success">Active</span></td>
                        <td class="actions">
                            <a class="btn btn-secondary btn-sm" asp-area="Admin" asp-controller="Users" asp-action="Detail">View</a>
                            <button type="button" class="btn btn-danger btn-sm"
                                    data-confirm-title="Restrict this account?"
                                    data-confirm-text="Tural Ismayilov will be unable to move money until the account is restored."
                                    data-confirm-yes="Restrict account" data-confirm-danger="true">Restrict</button>
                        </td>
