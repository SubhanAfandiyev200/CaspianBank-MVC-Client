@model AboutDetailVM
@{
    ViewData["Title"] = "About text";
    var pillars = Model.Pillars;
}
<main id="content" class="page">
    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">UI · Home page</p>
            <h1>About text</h1>
            <p class="lede">The heading text of the About block and its video. The three columns under it are managed in <a asp-area="Admin" asp-controller="AboutPillar" asp-action="Index">About pillars</a>.</p>
        </div>
        <a class="btn btn-secondary" asp-area="Admin" asp-controller="About" asp-action="Edit">Edit</a>
    </header>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@success</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@error</p>
    }

    <div class="narrow stack-lg">
        <section class="surface">
            <dl class="detail-list">
                <div><dt>Label</dt><dd>@Model.Label</dd></div>
                <div><dt>Title</dt><dd>@Model.Title</dd></div>
                <div><dt>Description</dt><dd>@Model.Description</dd></div>
                <div><dt>Video path</dt><dd>@Model.VideoPath</dd></div>
            </dl>
            @if (!string.IsNullOrEmpty(Model.VideoPath))
            {
                <video controls preload="metadata" src="@ApiUrl.ToAbsolute(Configuration["ApiSettings:BaseUrl"], Model.VideoPath)#t=0.5" style="display:block;width:100%;max-width:480px;margin-top:16px;border-radius:12px"></video>
            }
        </section>

        <section class="surface surface-tight">
            <div class="toolbar"><h2>Pillars (@pillars.Count)</h2></div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th class="num">Id</th><th>Title</th><th class="actions">Operations</th></tr></thead>
                    <tbody>
                        @foreach (var pillar in pillars)
                        {
                            <tr>
                                <td class="num">@pillar.Id</td>
                                <td>@pillar.Title</td>
                                <td class="actions"><a class="btn btn-detail btn-sm" asp-area="Admin" asp-controller="AboutPillar" asp-action="Detail" asp-route-id="@pillar.Id">Detail</a></td>
                            </tr>
                        }
                        @if (pillars.Count == 0)
                        {
                            <tr><td colspan="3">No pillars yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
