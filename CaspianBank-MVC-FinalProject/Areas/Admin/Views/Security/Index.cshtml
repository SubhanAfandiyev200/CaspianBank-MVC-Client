@model CaspianBank_MVC_FinalProject.ViewModels.Security.SecurityPageVM
@using System.Globalization
@{
    ViewData["Title"] = "Suspicious activity";
    var inv = CultureInfo.InvariantCulture;

    // API-dəki SecurityAlertKind adları və göstərilən adları
    var kinds = new List<(string Code, string Label)>
    {
        ("LargeTransfer", "Large transfer"),
        ("RapidTransfers", "Many transfers in a short time"),
        ("DailyVolume", "High amount in one day"),
        ("NewAccountOutflow", "New account sending money"),
        ("AccountLockout", "Locked after wrong passwords")
    };

    string KindLabel(string code)
    {
        var found = kinds.FirstOrDefault(k => k.Code == code);
        return found.Label ?? code;
    }

    string StatusLabel(string status)
    {
        switch (status)
        {
            case "Open": return "Needs a look";
            case "Dismissed": return "Marked safe";
            case "Frozen": return "Account frozen";
            default: return status;
        }
    }

    string StatusBadge(string status)
    {
        switch (status)
        {
            case "Open": return "badge-pending";
            case "Dismissed": return "badge-success";
            default: return "badge-danger";
        }
    }

    string Money(decimal value) { return value.ToString("N2", inv) + " AZN"; }

    string PageUrl(int page)
    {
        return Url.Action("Index", "Security", new { area = "Admin", status = Model.Status, severity = Model.Severity, kind = Model.Kind, search = Model.Search, page }) ?? "#";
    }
}
<main id="content" class="page">
    <header class="page-head">
        <p class="eyebrow">Controls</p>
        <h1>Suspicious activity</h1>
        <p class="lede">The system watches transfers and sign-ins and raises an alert when something looks unusual. Nothing is blocked automatically: look at each alert, then mark it safe or freeze the account.</p>
    </header>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@success</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@error</p>
    }
    @if (Model.Unavailable)
    {
        <p class="flash flash-error" role="alert">The alerts can't be loaded right now. Please try again in a moment.</p>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="flash flash-error" role="alert">@Model.Error</p>
    }

    <div class="stat-grid cols-3">
        <article class="stat @(Model.OpenCount > 0 ? "is-strong" : "")">
            <p class="stat-label">Need a look</p>
            <p class="stat-value">@Model.OpenCount.ToString("N0", inv)</p>
            <p class="hint">Open alerts</p>
        </article>
        <article class="stat">
            <p class="stat-label">High priority</p>
            <p class="stat-value">@Model.OpenHighCount.ToString("N0", inv)</p>
            <p class="hint">Open alerts marked high</p>
        </article>
        <article class="stat">
            <p class="stat-label">Handled this week</p>
            <p class="stat-value">@Model.ResolvedThisWeek.ToString("N0", inv)</p>
            <p class="hint">Marked safe or frozen in the last 7 days</p>
        </article>
    </div>

    <section class="surface surface-tight">
        <form method="get" asp-area="Admin" asp-controller="Security" asp-action="Index" class="toolbar filters">
            <div class="field grow">
                <label for="search">Search</label>
                <input class="input" id="search" name="search" type="search" placeholder="Customer, email, code or detail" value="@Model.Search" autocomplete="off" />
            </div>
            <div class="field">
                <label for="status">Status</label>
                <select class="select" data-wheel id="status" name="status">
                    <option value="Open" selected="@(Model.Status == "Open")">Need a look</option>
                    <option value="Dismissed" selected="@(Model.Status == "Dismissed")">Marked safe</option>
                    <option value="Frozen" selected="@(Model.Status == "Frozen")">Account frozen</option>
                    <option value="All" selected="@(Model.Status == "All")">All</option>
                </select>
            </div>
            <div class="field">
                <label for="severity">Priority</label>
                <select class="select" data-wheel id="severity" name="severity">
                    <option value="" selected="@string.IsNullOrEmpty(Model.Severity)">Any</option>
                    <option value="High" selected="@(Model.Severity == "High")">High</option>
                    <option value="Medium" selected="@(Model.Severity == "Medium")">Medium</option>
                </select>
            </div>
            <div class="field">
                <label for="kind">Type</label>
                <select class="select" data-wheel id="kind" name="kind">
                    <option value="" selected="@string.IsNullOrEmpty(Model.Kind)">Any</option>
                    @foreach (var item in kinds)
                    {
                        <option value="@item.Code" selected="@(Model.Kind == item.Code)">@item.Label</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <button class="btn btn-primary" type="submit">Filter</button>
            </div>
        </form>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th>When</th><th>Customer</th><th>Alert</th><th>Status</th><th class="actions"></th></tr>
                </thead>
                <tbody>
                    @foreach (var alert in Model.Items)
                    {
                        <tr>
                            <td>@alert.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm", inv)</td>
                            <td>
                                <a asp-area="Admin" asp-controller="Users" asp-action="Detail" asp-route-id="@alert.CustomerId"><strong>@alert.CustomerName</strong></a>
                                <div class="hint">@alert.Email</div>
                                @if (alert.AccountRestricted)
                                {
                                    <span class="badge badge-danger">Account frozen</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(alert.Severity == "High" ? "badge-danger" : "badge-neutral")">@(alert.Severity == "High" ? "High" : "Medium")</span>
                                <strong>@KindLabel(alert.Kind)</strong>
                                <div>@alert.Description</div>
                                @if (alert.Amount.HasValue)
                                {
                                    <div class="hint num">@Money(alert.Amount.Value)</div>
                                }
                            </td>
                            <td>
                                <span class="badge @StatusBadge(alert.Status)">@StatusLabel(alert.Status)</span>
                                @if (alert.Status != "Open")
                                {
                                    <div class="hint">@alert.ResolvedByName · @alert.ResolvedAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm", inv)</div>
                                    @if (!string.IsNullOrEmpty(alert.ResolutionNote))
                                    {
                                        <div class="hint">“@alert.ResolutionNote”</div>
                                    }
                                }
                            </td>
                            <td class="actions">
                                @if (alert.Status == "Open")
                                {
                                    <span class="row-actions">
                                        <form method="post" asp-area="Admin" asp-controller="Security" asp-action="Resolve" class="inline-form">
                                            <input type="hidden" name="id" value="@alert.Id" />
                                            <input type="hidden" name="outcome" value="Dismiss" />
                                            <input type="hidden" name="returnStatus" value="@Model.Status" />
                                            <input class="input input-sm" name="note" maxlength="300" placeholder="Note (optional)" aria-label="Note for alert @alert.Id" />
                                            <button type="submit" class="btn btn-secondary btn-sm">Mark safe</button>
                                        </form>
                                        @if (!alert.AccountRestricted)
                                        {
                                            <form method="post" asp-area="Admin" asp-controller="Security" asp-action="Resolve" class="inline-form">
                                                <input type="hidden" name="id" value="@alert.Id" />
                                                <input type="hidden" name="outcome" value="Freeze" />
                                                <input type="hidden" name="returnStatus" value="@Model.Status" />
                                                <input class="input input-sm" name="note" maxlength="300" placeholder="Why freeze? (required)" aria-label="Reason to freeze for alert @alert.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm"
                                                        data-confirm-title="Freeze this account?"
                                                        data-confirm-text="@alert.CustomerName will not be able to sign in or move money until the account is restored."
                                                        data-confirm-yes="Freeze account"
                                                        data-confirm-no="Cancel">Freeze</button>
                                            </form>
                                        }
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="5">Nothing here. @(Model.Status == "Open" ? "No alert needs a look right now." : "No alerts found.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="surface form-card">
        <h2>What the system watches</h2>
        <ul class="dep-notes">
            <li><strong>Large transfer:</strong> one transfer of 3,000 AZN or more (8,000 AZN or more is high). Transfers between a customer's own cards are not counted.</li>
            <li><strong>Many transfers in a short time:</strong> 5 transfers to other people in 10 minutes.</li>
            <li><strong>High amount in one day:</strong> 15,000 AZN or more sent to other people in one day (high).</li>
            <li><strong>New account sending money:</strong> an account younger than 7 days sending 1,000 AZN or more.</li>
            <li><strong>Locked after wrong passwords:</strong> a customer account locked for a few minutes after repeated wrong passwords.</li>
        </ul>
    </section>

    <partial name="_Pager" model="new CaspianBank_MVC_FinalProject.ViewModels.Common.PagerVM { Page = Model.Page, PageSize = Model.PageSize, TotalCount = Model.Total, TotalPages = Model.TotalPages, Url = PageUrl }" />
</main>
