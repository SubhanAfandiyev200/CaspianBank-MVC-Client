@{
    ViewData["Title"] = "UI dashboard";
}
<main id="content" class="page">
    <header class="page-head">
        <p class="eyebrow">@T["UI"]</p>
        <h1>@T["The desk behind the glass."]</h1>
        <p class="lede">@T["This dashboard belongs to the interface. It is the home page a person sees from the street, and the cards they hold once they are inside. Pick a block on the left or below to change what people read and see."]</p>
    </header>

    @* Hər model üçün bir blok. Yeni model səhifəsi yazanda onu burada və yan menyuda (layout) göstər. *@
    <div class="ui-board">
        <article class="surface">
            <p class="eyebrow">@T["Home page"]</p>
            <h2>@T["Brands"]</h2>
            <p>@T["The partner logos in the moving strip under the headline."]</p>
            <a class="btn btn-secondary mt-4" asp-area="Admin" asp-controller="Brand" asp-action="Index">@T["Open Brands"]</a>
        </article>
        <article class="surface">
            <p class="eyebrow">@T["Cards"]</p>
            <h2>@T["Card designs"]</h2>
            <p>@T["The faces of the cards: the fan on Home and the cards customers hold."]</p>
            <a class="btn btn-secondary mt-4" asp-area="Admin" asp-controller="CardDesign" asp-action="Index">@T["Open card designs"]</a>
        </article>
        <article class="surface">
            <p class="eyebrow">@T["Cards"]</p>
            <h2>@T["Card types"]</h2>
            <p>@T["The fee, cashback, transfer limit, commission and design of each card type."]</p>
            <a class="btn btn-secondary mt-4" asp-area="Admin" asp-controller="CardTier" asp-action="Index">@T["Open card types"]</a>
        </article>
        <article class="surface">
            <p class="eyebrow">@T["Home page"]</p>
            <h2>@T["Ticker"]</h2>
            <p>@T["The short phrases that move across the line under the headline."]</p>
            <a class="btn btn-secondary mt-4" asp-area="Admin" asp-controller="Ticker" asp-action="Index">@T["Open Ticker"]</a>
        </article>
        <article class="surface">
            <p class="eyebrow">@T["Home page"]</p>
            <h2>@T["Hero text"]</h2>
            <p>@T["The label, headline and description on the left of the top block."]</p>
            <a class="btn btn-secondary mt-4" asp-area="Admin" asp-controller="CardHero" asp-action="Detail">@T["Open Hero text"]</a>
        </article>
        <article class="surface">
            <p class="eyebrow">@T["Home page"]</p>
            <h2>@T["Benefits"]</h2>
            <p>@T["The heading block and the draggable benefit cards."] </p>
            <span class="row-actions mt-4">
                <a class="btn btn-secondary" asp-area="Admin" asp-controller="BenefitSection" asp-action="Detail">@T["Open heading"]</a>
                <a class="btn btn-secondary" asp-area="Admin" asp-controller="BenefitItem" asp-action="Index">@T["Open cards"]</a>
            </span>
        </article>
        <article class="surface">
            <p class="eyebrow">@T["Home page"]</p>
            <h2>@T["Services"]</h2>
            <p>@T["The heading block and the six service cards."]</p>
            <span class="row-actions mt-4">
                <a class="btn btn-secondary" asp-area="Admin" asp-controller="ServiceSection" asp-action="Detail">@T["Open heading"]</a>
                <a class="btn btn-secondary" asp-area="Admin" asp-controller="ServiceItem" asp-action="Index">@T["Open cards"]</a>
            </span>
        </article>
        <article class="surface">
            <p class="eyebrow">@T["Home page"]</p>
            <h2>@T["About"]</h2>
            <p>@T["The About text with its video and the pillars under it."]</p>
            <span class="row-actions mt-4">
                <a class="btn btn-secondary" asp-area="Admin" asp-controller="About" asp-action="Detail">@T["Open text"]</a>
                <a class="btn btn-secondary" asp-area="Admin" asp-controller="AboutPillar" asp-action="Index">@T["Open pillars"]</a>
            </span>
        </article>
        <article class="surface">
            <p class="eyebrow">@T["Site"]</p>
            <h2>@T["Settings"]</h2>
            <p>@T["Logo, company name, address, email, phone and the footer text."]</p>
            <a class="btn btn-secondary mt-4" asp-area="Admin" asp-controller="Setting" asp-action="Index">@T["Open Settings"]</a>
        </article>
    </div>
</main>
