@model CaspianBank_MVC_FinalProject.ViewModels.Translations.TranslationsPageVM
@using System.Globalization
@{
    ViewData["Title"] = "Translations";
    var inv = CultureInfo.InvariantCulture;

    string PageUrl(int page)
    {
        return Url.Action("Index", "Translations", new { area = "Admin", search = Model.Search, onlyMissing = Model.OnlyMissing, kind = Model.Kind, page }) ?? "#";
    }
}
<main id="content" class="page">
    <header class="page-head">
        <p class="eyebrow">@T["Languages"]</p>
        <h1>@T["Translations"]</h1>
        <p class="lede">@T["Every text on the customer site is stored in English. Write the Azerbaijani and Russian version next to it; an empty field shows the English text. Parts in curly brackets are filled in by the page (amounts, dates, names) and must be kept as they are."]</p>
    </header>

    <section class="surface help-box">
        <h2>@T["How this page works"]</h2>
        <ul class="dep-notes">
            <li>@T["The left column is the English text. The code looks the text up by it, so it never changes here."]</li>
            <li>@T["Write what the customer should see in Azerbaijani and in Russian, then press Save on that row. An empty field shows the English text."]</li>
            <li>@T["Texts with {0} or {1} have a part the page fills in (an amount, a date, a name). Keep that part exactly as it is, you can move it inside the sentence."]</li>
            <li>@T["Show: page texts are the normal sentences and labels, texts with variables are sentences that contain {0}, browser texts are the ones used by JavaScript (they start with js:)."]</li>
            <li>@T["A change is visible to customers within a few seconds."]</li>
        </ul>
    </section>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@T[success]</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@T[error]</p>
    }
    @if (Model.Unavailable)
    {
        <p class="flash flash-error" role="alert">@T["The translations can't be loaded right now. Please try again in a moment."]</p>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="flash flash-error" role="alert">@T[Model.Error]</p>
    }

    <section class="surface surface-tight">
        <form method="get" asp-area="Admin" asp-controller="Translations" asp-action="Index" class="toolbar filters">
            <div class="field grow">
                <label for="search">@T["Search"]</label>
                <input class="input" id="search" name="search" type="search" placeholder="@T["English text or a translation"]" value="@Model.Search" autocomplete="off" />
            </div>
            <div class="field">
                <label for="kind">@T["Texts"]</label>
                <select class="select" data-wheel id="kind" name="kind">
                    <option value="page" selected="@(Model.Kind == "page" || string.IsNullOrEmpty(Model.Kind))">@T["Page texts"]</option>
                    <option value="template" selected="@(Model.Kind == "template")">@T["Texts with variables"]</option>
                    <option value="script" selected="@(Model.Kind == "script")">@T["Browser texts"]</option>
                    <option value="all" selected="@(Model.Kind == "all")">@T["All kinds"]</option>
                </select>
            </div>
            <div class="field">
                <label for="onlyMissing">@T["Show"]</label>
                <select class="select" data-wheel id="onlyMissing" name="onlyMissing">
                    <option value="false" selected="@(!Model.OnlyMissing)">@T["All texts"]</option>
                    <option value="true" selected="@Model.OnlyMissing">@T["Only missing a translation"]</option>
                </select>
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <button class="btn btn-primary" type="submit">@T["Filter"]</button>
            </div>
        </form>
        <p class="hint">@T["{0} texts in this list. JavaScript texts start with \"js:\".", Model.Total.ToString("N0", inv)]</p>
    </section>

    <details class="surface add-text">
        <summary><strong>@T["Add a text"]</strong></summary>
        <p class="hint">@T["Use this for a text that is not in the list yet. The English text must match the one in the page exactly."]</p>
        <form method="post" asp-area="Admin" asp-controller="Translations" asp-action="Save" class="form-grid">
            <div class="field">
                <label for="new-key">@T["English text"]</label>
                <input class="input" id="new-key" name="key" maxlength="400" required />
            </div>
            <div class="field">
                <label for="new-az">@T["Azərbaycanca"]</label>
                <input class="input" id="new-az" name="az" maxlength="2000" />
            </div>
            <div class="field">
                <label for="new-ru">Русский</label>
                <input class="input" id="new-ru" name="ru" maxlength="2000" />
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <button class="btn btn-primary" type="submit">@T["Add"]</button>
            </div>
        </form>
    </details>

    <section class="surface surface-tight">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@T["English"]</th>
                        <th>@T["Azərbaycanca"]</th>
                        <th>Русский</th>
                        <th class="actions"><span class="sr-only">@T["Save"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Items)
                    {
                        var id = "t" + Math.Abs(row.Key.GetHashCode()).ToString(inv);
                        <tr>
                            <td>
                                <span class="tr-key">@row.Key</span>
                                @if (row.Key.Contains("{"))
                                {
                                    <small class="hint">@T["has variables, keep {0}, {1}... as they are"]</small>
                                }
                                @if (string.IsNullOrWhiteSpace(row.Az) || string.IsNullOrWhiteSpace(row.Ru))
                                {
                                    <small class="badge badge-pending">@T["missing a translation"]</small>
                                }
                            </td>
                            <td>
                                <textarea class="input" form="f-@id" name="az" rows="2" maxlength="2000" aria-label="Azerbaijani for: @row.Key">@row.Az</textarea>
                            </td>
                            <td>
                                <textarea class="input" form="f-@id" name="ru" rows="2" maxlength="2000" aria-label="Russian for: @row.Key">@row.Ru</textarea>
                            </td>
                            <td class="actions">
                                <form id="f-@id" method="post" asp-area="Admin" asp-controller="Translations" asp-action="Save" class="inline-form">
                                    <input type="hidden" name="key" value="@row.Key" />
                                    <input type="hidden" name="search" value="@Model.Search" />
                                    <input type="hidden" name="onlyMissing" value="@(Model.OnlyMissing ? "true" : "false")" />
                                    <input type="hidden" name="kind" value="@Model.Kind" />
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <button type="submit" class="btn btn-secondary btn-sm">@T["Save"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="4">@T["Nothing here."] @T[Model.OnlyMissing ? "Every text has a translation." : "No texts found."]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <partial name="_Pager" model="new CaspianBank_MVC_FinalProject.ViewModels.Common.PagerVM { Page = Model.Page, PageSize = Model.PageSize, TotalCount = Model.Total, TotalPages = Model.TotalPages, Url = PageUrl }" />
</main>
