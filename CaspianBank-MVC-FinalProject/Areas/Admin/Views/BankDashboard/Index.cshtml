@model CaspianBank_MVC_FinalProject.ViewModels.Bank.BankDashboardVM
@using System.Globalization
@{
    ViewData["Title"] = "Bank dashboard";
    var inv = CultureInfo.InvariantCulture;

    string Money(decimal value) { return value.ToString("N2", inv) + " AZN"; }

    // Zolağın uzunluğu: hissənin cəmə nisbəti (cəm 0-dırsa boş)
    string Width(decimal part, decimal total)
    {
        if (total <= 0m || part <= 0m)
        {
            return "0";
        }
        return Math.Min(100m, Math.Round(part / total * 100m, 1)).ToString("0.#", inv);
    }

    string Change(decimal? value)
    {
        if (!value.HasValue)
        {
            return T["no data for last month"];
        }
        return T["{0}% vs last month", (value.Value >= 0 ? "+" : "") + value.Value.ToString("0.#", inv)];
    }
}
<main id="content" class="page">
    <header class="page-head">
        <p class="eyebrow">@T["Bank"]</p>
        <h1>@T["Bank dashboard"]</h1>
        <p class="lede">@T["Customers, income, expenses, taxes and the bank's own funds for {0}. Every number comes from real transactions in the database.", Model.PeriodLabel]</p>
    </header>

    @if (Model.Unavailable)
    {
        <p class="flash flash-error" role="alert">@T["The dashboard can't be loaded right now. Please try again in a moment."]</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <p class="flash flash-error" role="alert">@T[Model.Error]</p>
        }

        <form method="get" asp-area="Admin" asp-controller="BankDashboard" asp-action="Index" class="toolbar filters">
            <div class="field">
                <label for="month">@T["Month"]</label>
                <select class="select" data-wheel id="month" name="month">
                    @foreach (var item in Model.Months)
                    {
                        <option value="@item.Value" selected="@(item.Value == Model.Period)">@item.Label</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <button class="btn btn-primary" type="submit">@T["Show"]</button>
            </div>
        </form>

        @* ===== Müştərilər və pul ===== *@
        <div class="stat-grid cols-3">
            <article class="stat">
                <p class="stat-label">@T["Total users"]</p>
                <p class="stat-value">@Model.TotalUsers.ToString("N0", inv)</p>
                <p class="stat-delta">@T["+{0} joined in {1}", Model.NewUsers, T.Month(Model.PeriodLabel)]</p>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index">@T["View users"]</a>
            </article>
            <article class="stat">
                <p class="stat-label">@T["Term deposits"]</p>
                <p class="stat-value">@Money(Model.TermDeposits)</p>
                <p class="hint">@T["Locked until the term ends. Interest still to pay {0}. All customer money {1} (on cards {2})", Money(Model.TermDepositInterestOwed), Money(Model.CustomerDeposits + Model.TermDeposits), Money(Model.CustomerDeposits)]</p>
                <a asp-area="Admin" asp-controller="Deposits" asp-action="Index">@T["View deposits"]</a>
            </article>
            <article class="stat">
                <p class="stat-label">@T["Loans outstanding"]</p>
                <p class="stat-value">@Money(Model.LoansOutstanding)</p>
                <p class="hint">@T["Issued and not yet repaid"]</p>
                <a asp-area="Admin" asp-controller="Loans" asp-action="Index">@T["View loans"]</a>
            </article>
        </div>

        @* ===== Aylıq nəticə: gəlir, xərc, mənfəət ===== *@
        <div class="stat-grid cols-3">
            <article class="stat">
                <p class="stat-label">@T["Total income"]</p>
                <p class="stat-value">@Money(Model.TotalIncome)</p>
                <p class="stat-delta @(Model.IncomeChangePercent is < 0 ? "is-down" : "")">@Change(Model.IncomeChangePercent)</p>
            </article>
            <article class="stat">
                <p class="stat-label">@T["Total expenses"]</p>
                <p class="stat-value">@Money(Model.TotalExpenses)</p>
                <p class="stat-delta @(Model.ExpenseChangePercent is > 0 ? "is-down" : "")">@Change(Model.ExpenseChangePercent)</p>
                <p class="hint">@T["Operations, cashback, deposit interest and tax"]</p>
            </article>
            <article class="stat is-strong">
                <p class="stat-label">@T["Net profit"]</p>
                <p class="stat-value">@Money(Model.NetProfit)</p>
                <p class="hint">@T["After tax"]</p>
            </article>
        </div>

        <div class="fin-grid">
            @* ===== Bankın gəlirləri ===== *@
            <section class="fin-card">
                <h2>@T["Bank income"]</h2>
                <p class="hint">@T["Where the money comes from"]</p>

                <div class="fin-row">
                    <div class="fin-row-top"><span>@T["Transfer commissions"]</span><span>@Money(Model.TransferCommissions)</span></div>
                    <div class="fin-bar"><span style="width:@(Width(Model.TransferCommissions, Model.TotalIncome))%"></span></div>
                </div>
                <div class="fin-row">
                    <div class="fin-row-top"><span>@T["Card opening fees"]</span><span>@Money(Model.CardOpeningFees)</span></div>
                    <div class="fin-bar"><span style="width:@(Width(Model.CardOpeningFees, Model.TotalIncome))%"></span></div>
                </div>
                <div class="fin-row">
                    <div class="fin-row-top"><span>@T["Loan interest"]</span><span>@Money(Model.LoanInterest)</span></div>
                    <div class="fin-bar"><span style="width:@(Width(Model.LoanInterest, Model.TotalIncome))%"></span></div>
                </div>
                <div class="fin-row">
                    <div class="fin-row-top"><span>@T["Late payment penalties"]</span><span>@Money(Model.LatePenalties)</span></div>
                    <div class="fin-bar"><span style="width:@(Width(Model.LatePenalties, Model.TotalIncome))%"></span></div>
                </div>
                <div class="fin-total"><span>@T["Total income"]</span><span>@Money(Model.TotalIncome)</span></div>
                <p class="sample-note">@T["Commissions come from transfers above each card's free limit; opening fees from Silver, Gold and extra cards; interest and penalties from loan payments made in the month."]</p>
            </section>

            @* ===== Xərclər ===== *@
            <section class="fin-card">
                <h2>@T["Expenses"]</h2>
                <p class="hint">@T["Where the money goes"]</p>

                <div class="fin-row">
                    <div class="fin-row-top"><span>@T["Cashback paid to customers"]</span><span>@Money(Model.CashbackPaid)</span></div>
                    <div class="fin-bar is-out"><span style="width:@(Width(Model.CashbackPaid, Model.TotalExpenses))%"></span></div>
                </div>
                <div class="fin-row">
                    <div class="fin-row-top"><span>@T["Interest paid on deposits"]</span><span>@Money(Model.DepositInterestPaid)</span></div>
                    <div class="fin-bar is-out"><span style="width:@(Width(Model.DepositInterestPaid, Model.TotalExpenses))%"></span></div>
                </div>
                <div class="fin-row">
                    <div class="fin-row-top"><span>@T["Salaries and operations"]</span><span>@Money(Model.OperatingCosts)</span></div>
                    <div class="fin-bar is-out"><span style="width:@(Width(Model.OperatingCosts, Model.TotalExpenses))%"></span></div>
                </div>
                <div class="fin-row">
                    <div class="fin-row-top"><span>@T["Profit tax ({0}%)", Model.ProfitTaxPercent.ToString("0.##", inv)]</span><span>@Money(Model.ProfitTax)</span></div>
                    <div class="fin-bar is-out"><span style="width:@(Width(Model.ProfitTax, Model.TotalExpenses))%"></span></div>
                </div>
                <div class="fin-total"><span>@T["Total expenses"]</span><span>@Money(Model.TotalExpenses)</span></div>
                <p class="sample-note">@T["Income {0} − cashback {1} − deposit interest {2} − operating costs {3} = profit before tax {4}", Money(Model.TotalIncome), Money(Model.CashbackPaid), Money(Model.DepositInterestPaid), Money(Model.OperatingCosts), Money(Model.ProfitBeforeTax)]@(Model.ProfitBeforeTax > 0 ? "; " + T["tax {0}% = {1}", Model.ProfitTaxPercent.ToString("0.##", inv), Money(Model.ProfitTax)] : "; " + T["no tax on a loss"]).</p>
            </section>

            @* ===== Vergi və ehtiyat ===== *@
            <section class="fin-card">
                <h2>@T["Taxes and reserve"]</h2>
                <p class="hint">@T["Can the bank pay what it owes?"]</p>

                <dl class="reserve-list">
                    <div><dt>@T["Tax accrued this month"]</dt><dd>@Money(Model.ProfitTax)</dd></div>
                    <div><dt>@T["Tax accrued this quarter so far"]</dt><dd>@Money(Model.QuarterTaxAccrued)</dd></div>
                    <div><dt>@T["Required reserve ({0}% of deposits)", Model.ReservePercent.ToString("0.##", inv)]</dt><dd>@Money(Model.RequiredReserve)</dd></div>
                    <div><dt>@T["Treasury (own funds)"]</dt><dd>@Money(Model.OwnFunds) <a asp-area="Admin" asp-controller="Treasury" asp-action="Index">@T["history"]</a></dd></div>
                    <div><dt>@T["Reserve after paying the quarter's tax"]</dt><dd>@Money(Model.ReserveAfterTax)</dd></div>
                </dl>

                <div class="reserve-meter">
                    <div class="fin-bar @(Model.ReserveHealthy ? "" : "is-out")"><span style="width:@(Model.ReserveHealthy ? "100" : "40")%"></span></div>
                    <p>
                        @if (Model.CoverageRatio.HasValue)
                        {
                            <text>@T["Own funds cover the required reserve plus this quarter's tax"] <strong>@Model.CoverageRatio.Value.ToString("N1", inv)×</strong></text>
                        }
                        else
                        {
                            <text>@T["Nothing is required yet."]</text>
                        }
                        @if (Model.ReserveHealthy)
                        {
                            <span class="badge badge-success">@T["Healthy"]</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">@T["Reserve too low"]</span>
                        }
                    </p>
                </div>
                <p class="sample-note">@T["If own funds fell below the required reserve plus the tax due, this card would turn red and warn the finance team. Own funds are the treasury balance (every movement is in the Treasury history). Operating costs, the tax rate and the reserve rate are the bank's rules stored in the database."]</p>
            </section>

            @* ===== Gözləyən işlər ===== *@
            <section class="fin-card">
                <h2>@T["Needs attention"]</h2>
                <p class="hint">@T["Queues waiting on the bank"]</p>

                <div class="fin-row">
                    <div class="fin-row-top"><span><a asp-area="Admin" asp-controller="Loans" asp-action="Index" asp-route-status="Pending">@T["Loans waiting for a decision"]</a></span><span>@Model.PendingLoans</span></div>
                </div>
                <div class="fin-row">
                    <div class="fin-row-top"><span><a asp-area="Admin" asp-controller="Tickets" asp-action="Index" asp-route-status="Pending">@T["Contact tickets waiting for an answer"]</a></span><span>@Model.PendingTickets</span></div>
                </div>
                <div class="fin-row">
                    <div class="fin-row-top"><span><a asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-status="Restricted">@T["Restricted accounts"]</a></span><span>@Model.RestrictedAccounts</span></div>
                </div>
            </section>
        </div>
    }
</main>
