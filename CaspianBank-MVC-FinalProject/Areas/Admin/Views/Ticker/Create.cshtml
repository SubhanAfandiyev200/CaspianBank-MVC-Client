@model HomeTickerCreateVM
@{
    ViewData["Title"] = "Ticker · Create";
}
<main id="content" class="page">
    <a class="back" asp-area="Admin" asp-controller="Ticker" asp-action="Index">All ticker texts</a>

    <header class="page-head">
        <p class="eyebrow">UI · Home page</p>
        <h1>Create ticker text</h1>
        <p class="lede">A short phrase for the moving line under the Home headline.</p>
    </header>

    <form method="post" asp-area="Admin" asp-controller="Ticker" asp-action="Create" class="narrow stack-lg" novalidate>
        <section class="surface form-stack">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div class="field">
                <label asp-for="Text">Text</label>
                <input class="input" asp-for="Text" maxlength="100" placeholder="Ticker text" autocomplete="off" />
                <span asp-validation-for="Text" class="field-error"></span>
            </div>
        </section>

        <div class="rv-actions">
            <a class="btn btn-secondary btn-cancel" asp-area="Admin" asp-controller="Ticker" asp-action="Index">Cancel</a>
            <button class="btn btn-primary" type="submit">Create</button>
        </div>
    </form>
</main>
