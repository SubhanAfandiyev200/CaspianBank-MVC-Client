@model HomeTickerDetailVM
@{
    ViewData["Title"] = "Ticker · Detail";
}
<main id="content" class="page">
    <a class="back" asp-area="Admin" asp-controller="Ticker" asp-action="Index">@T["All ticker texts"]</a>

    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">@T["UI · Home page"]</p>
            <h1>@T["Ticker text"]</h1>
            <p class="lede">@T["One phrase from the moving line on the Home page."]</p>
        </div>
        <span class="row-actions">
            <a class="btn btn-secondary" asp-area="Admin" asp-controller="Ticker" asp-action="Edit" asp-route-id="@Model.Id">@T["Edit"]</a>
            <a class="btn btn-back" asp-area="Admin" asp-controller="Ticker" asp-action="Index">@T["Go Back"]</a>
            <form method="post" asp-area="Admin" asp-controller="Ticker" asp-action="Delete" asp-route-id="@Model.Id">
                <button type="submit" class="btn btn-danger"
                        data-confirm-title="@T["Delete this text?"]"
                        data-confirm-text="@T["It will disappear from the moving line on the Home page."]"
                        data-confirm-yes="@T["Delete"]" data-confirm-danger="true">@T["Delete"]</button>
            </form>
        </span>
    </header>

    <div class="narrow stack-lg">
        <section class="surface">
            <dl class="detail-list">
                <div><dt>@T["Id"]</dt><dd>@Model.Id</dd></div>
                <div><dt>@T["Text"]</dt><dd>@Model.Text.Trim()</dd></div>
            </dl>
        </section>
    </div>
</main>
