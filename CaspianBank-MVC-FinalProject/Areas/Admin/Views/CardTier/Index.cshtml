@model IEnumerable<CardTierVM>
@{
    ViewData["Title"] = "Card types";
}
<main id="content" class="page">
    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">@T["UI · Cards"]</p>
            <h1>@T["Card types"]</h1>
            <p class="lede">@T["The rules of the four card types: the fee to open a card, cashback, the free transfer limit, the commission above it and the design. The types themselves are fixed, only their values change."]</p>
        </div>
    </header>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@T[success]</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@T[error]</p>
    }

    <section class="surface surface-tight">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@T["Card"]</th>
                        <th>@T["Type"]</th>
                        <th class="num">@T["Issue fee"]</th>
                        <th class="num">@T["Cashback"]</th>
                        <th class="num">@T["Free limit"]</th>
                        <th class="num">@T["Commission"]</th>
                        <th class="actions">@T["Operations"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><div style="width:96px;height:60px;overflow:hidden;border-radius:6px"><div style="width:280px;height:176px;transform:scale(0.343);transform-origin:0 0;pointer-events:none"><partial name="_CardPreview" model="new CardDesignPreviewVM { Title = item.Tier, Image = item.DesignImage }" /></div></div></td>
                            <td>@T[item.Tier]</td>
                            <td class="num">@T["{0} AZN", item.IssueFee.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)]</td>
                            <td class="num">@item.CashbackPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%</td>
                            <td class="num">@T["{0} AZN", item.TransferLimit.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)]</td>
                            <td class="num">@item.CommissionPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%</td>
                            <td class="actions">
                                <span class="row-actions">
                                    <a class="btn btn-detail btn-sm" asp-area="Admin" asp-controller="CardTier" asp-action="Detail" asp-route-id="@item.Id">@T["Detail"]</a>
                                    <a class="btn btn-secondary btn-sm" asp-area="Admin" asp-controller="CardTier" asp-action="Edit" asp-route-id="@item.Id">@T["Edit"]</a>
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7">@T["No card types found."]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>
