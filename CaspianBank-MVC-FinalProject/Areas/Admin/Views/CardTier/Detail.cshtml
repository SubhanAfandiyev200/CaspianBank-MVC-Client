@model CardTierDetailVM
@{
    ViewData["Title"] = "Card type · Detail";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<main id="content" class="page">
    <a class="back" asp-area="Admin" asp-controller="CardTier" asp-action="Index">@T["All card types"]</a>

    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">@T["UI · Cards"]</p>
            <h1>@T[Model.Tier]</h1>
            <p class="lede">@T["The rules and the design of this card type."]</p>
        </div>
        <span class="row-actions">
            <a class="btn btn-secondary" asp-area="Admin" asp-controller="CardTier" asp-action="Edit" asp-route-id="@Model.Id">@T["Edit"]</a>
            <a class="btn btn-back" asp-area="Admin" asp-controller="CardTier" asp-action="Index">@T["Go Back"]</a>
        </span>
    </header>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@T[success]</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@T[error]</p>
    }

    <div class="narrow stack-lg">
        <section class="surface">
            <p class="hint">@T["How the card looks (sample data)"]</p>
            <partial name="_CardPreview" model="new CardDesignPreviewVM { Title = Model.Tier, Image = Model.DesignImage, Large = true }" />
        </section>

        <section class="surface">
            <dl class="detail-list">
                <div><dt>@T["Type"]</dt><dd>@Model.Tier</dd></div>
                <div><dt>@T["Issue fee"]</dt><dd>@T["{0} AZN, charged once when the card is added", Model.IssueFee.ToString("N2", inv)]</dd></div>
                <div><dt>@T["Cashback"]</dt><dd>@T["{0}% of payments", Model.CashbackPercent.ToString("0.##", inv)]</dd></div>
                <div><dt>@T["Free transfer limit"]</dt><dd>@T["{0} AZN", Model.TransferLimit.ToString("N2", inv)]</dd></div>
                <div><dt>@T["Commission"]</dt><dd>@T["{0}% on the part above the limit", Model.CommissionPercent.ToString("0.##", inv)]</dd></div>
                <div><dt>@T["Design"]</dt><dd>@Model.DesignTitle (<a asp-area="Admin" asp-controller="CardDesign" asp-action="Detail" asp-route-id="@Model.CardDesignId">@T["open"]</a>)</dd></div>
            </dl>
        </section>
    </div>
</main>
