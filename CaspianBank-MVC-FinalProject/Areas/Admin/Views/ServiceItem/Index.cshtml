@model IEnumerable<ServiceItemVM>
@{
    ViewData["Title"] = "Service cards";
}
<main id="content" class="page">
    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">@T["UI · Home page"]</p>
            <h1>@T["Service cards"]</h1>
            <p class="lede">@T["The six cards of the Services block. Each card opens a part of the app, so only its text and icon can be changed. The heading is in"] <a asp-area="Admin" asp-controller="ServiceSection" asp-action="Detail">@T["Services heading"]</a>.</p>
        </div>
    </header>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@T[success]</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@T[error]</p>
    }

    <section class="surface surface-tight">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="num">@T["No"]</th>
                        <th>@T["Icon"]</th>
                        <th>@T["Title"]</th>
                        <th>@T["Description"]</th>
                        <th class="actions">@T["Operations"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="num">@item.Number</td>
                            <td><img src="@ApiUrl.ToAbsolute(Configuration["ApiSettings:BaseUrl"], item.Icon)" alt="" style="display:block;width:28px;height:28px;object-fit:contain" /></td>
                            <td>@item.Title</td>
                            <td>@item.Description</td>
                            <td class="actions">
                                <span class="row-actions">
                                    <a class="btn btn-detail btn-sm" asp-area="Admin" asp-controller="ServiceItem" asp-action="Detail" asp-route-id="@item.Id">@T["Detail"]</a>
                                    <a class="btn btn-secondary btn-sm" asp-area="Admin" asp-controller="ServiceItem" asp-action="Edit" asp-route-id="@item.Id">@T["Edit"]</a>
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5">@T["No cards yet."]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>
