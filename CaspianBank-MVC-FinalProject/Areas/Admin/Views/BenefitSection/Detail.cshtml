@model BenefitSectionVM
@{
    ViewData["Title"] = "Benefit section · Detail";
    var cards = (List<BenefitItemVM>)ViewBag.Items;
}
<main id="content" class="page">
    <a class="back" asp-area="Admin" asp-controller="BenefitSection" asp-action="Index">All sections</a>

    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">UI · Home page</p>
            <h1>@Model.Title</h1>
            <p class="lede">One benefit section and the cards that belong to it.</p>
        </div>
        <span class="row-actions">
            <a class="btn btn-secondary" asp-area="Admin" asp-controller="BenefitSection" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-back" asp-area="Admin" asp-controller="BenefitSection" asp-action="Index">Go Back</a>
            <form method="post" asp-area="Admin" asp-controller="BenefitSection" asp-action="Delete" asp-route-id="@Model.Id">
                <button type="submit" class="btn btn-danger"
                        data-confirm-title="Delete this section?"
                        data-confirm-text="All @cards.Count card(s) of this section will be deleted too."
                        data-confirm-yes="Delete" data-confirm-danger="true">Delete</button>
            </form>
        </span>
    </header>

    <div class="narrow stack-lg">
        <section class="surface">
            <dl class="detail-list">
                <div><dt>Id</dt><dd>@Model.Id</dd></div>
                <div><dt>Label</dt><dd>@Model.Label</dd></div>
                <div><dt>Title</dt><dd>@Model.Title</dd></div>
                <div><dt>Description</dt><dd>@Model.Description</dd></div>
            </dl>
        </section>

        <section class="surface surface-tight">
            <div class="toolbar"><h2>Cards in this section (@cards.Count)</h2></div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th class="num">Id</th><th>Label</th><th>Title</th><th class="actions">Operations</th></tr></thead>
                    <tbody>
                        @foreach (var card in cards)
                        {
                            <tr>
                                <td class="num">@card.Id</td>
                                <td>@card.Label</td>
                                <td>@card.Title</td>
                                <td class="actions"><a class="btn btn-detail btn-sm" asp-area="Admin" asp-controller="BenefitItem" asp-action="Detail" asp-route-id="@card.Id">Detail</a></td>
                            </tr>
                        }
                        @if (cards.Count == 0)
                        {
                            <tr><td colspan="4">This section has no cards yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
