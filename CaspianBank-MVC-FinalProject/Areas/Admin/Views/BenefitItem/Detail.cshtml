@model BenefitItemDetailVM
@{
    ViewData["Title"] = "Benefit item · Detail";
}
<main id="content" class="page">
    <a class="back" asp-area="Admin" asp-controller="BenefitItem" asp-action="Index">@T["All cards"]</a>

    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">@T["UI · Home page"]</p>
            <h1>@Model.Title</h1>
            <p class="lede">@T["One sliding card of the Benefits block."]</p>
        </div>
        <span class="row-actions">
            <a class="btn btn-secondary" asp-area="Admin" asp-controller="BenefitItem" asp-action="Edit" asp-route-id="@Model.Id">@T["Edit"]</a>
            <a class="btn btn-back" asp-area="Admin" asp-controller="BenefitItem" asp-action="Index">@T["Go Back"]</a>
            <form method="post" asp-area="Admin" asp-controller="BenefitItem" asp-action="Delete" asp-route-id="@Model.Id">
                <button type="submit" class="btn btn-danger"
                        data-confirm-title="@T["Delete this card?"]"
                        data-confirm-text="@T["It will disappear from the Benefits block on the Home page."]"
                        data-confirm-yes="@T["Delete"]" data-confirm-danger="true">@T["Delete"]</button>
            </form>
        </span>
    </header>

    <div class="narrow stack-lg">
        <section class="surface">
            <dl class="detail-list">
                <div><dt>@T["Id"]</dt><dd>@Model.Id</dd></div>
                <div><dt>@T["Label"]</dt><dd>@Model.Label</dd></div>
                <div><dt>@T["Title"]</dt><dd>@Model.Title</dd></div>
                <div><dt>@T["Description"]</dt><dd>@Model.Description</dd></div>
                <div><dt>@T["Button"]</dt><dd>@Model.ButtonText</dd></div>
                <div><dt>@T["Button link"]</dt><dd>@Model.ButtonUrl</dd></div>
                <div><dt>@T["First line"]</dt><dd>@Model.Text1</dd></div>
                <div><dt>@T["Second line"]</dt><dd>@Model.Text2</dd></div>
                <div><dt>@T["Third line"]</dt><dd>@Model.Text3</dd></div>
            </dl>
        </section>
    </div>
</main>
