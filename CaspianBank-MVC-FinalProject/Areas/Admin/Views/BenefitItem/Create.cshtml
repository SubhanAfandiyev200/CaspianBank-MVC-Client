@model BenefitItemCreateVM
@{
    ViewData["Title"] = "Benefit item · Create";
}
<main id="content" class="page">
    <a class="back" asp-area="Admin" asp-controller="BenefitItem" asp-action="Index">@T["All cards"]</a>

    <header class="page-head">
        <p class="eyebrow">@T["UI · Home page"]</p>
        <h1>@T["Create card"]</h1>
        <p class="lede">@T["A sliding card for the Benefits block."]</p>
    </header>


    <form method="post" asp-area="Admin" asp-controller="BenefitItem" asp-action="Create" class="narrow stack-lg" novalidate>
        <section class="surface form-stack">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div class="field">
                <label asp-for="Label">@T["Label"]</label>
                <input class="input" asp-for="Label" maxlength="100" placeholder="@T["Small text above the title"]" autocomplete="off" />
                <span asp-validation-for="Label" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Title">@T["Title"]</label>
                <input class="input" asp-for="Title" maxlength="200" placeholder="@T["Card title"]" autocomplete="off" />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Description">@T["Description"]</label>
                <textarea class="textarea" asp-for="Description" maxlength="300" rows="3" placeholder="@T["One or two sentences."]"></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Text1">@T["First line"]</label>
                <input class="input" asp-for="Text1" maxlength="200" autocomplete="off" />
                <span asp-validation-for="Text1" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Text2">@T["Second line"]</label>
                <input class="input" asp-for="Text2" maxlength="200" autocomplete="off" />
                <span asp-validation-for="Text2" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Text3">@T["Third line"]</label>
                <input class="input" asp-for="Text3" maxlength="200" autocomplete="off" />
                <span asp-validation-for="Text3" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="ButtonText">@T["Button text"]</label>
                <input class="input" asp-for="ButtonText" maxlength="100" placeholder="@T["Open an account"]" autocomplete="off" />
                <span asp-validation-for="ButtonText" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="ButtonUrl">@T["Where the button goes"]</label>
                <select class="select" asp-for="ButtonUrl">
                    @foreach (var destination in Model.Destinations)
                    {
                        <option value="@destination.Path" selected="@(destination.Path == Model.ButtonUrl)">@destination.Label</option>
                    }
                    @if (Model.Destinations.All(d => d.Path != Model.ButtonUrl) && !string.IsNullOrEmpty(Model.ButtonUrl))
                    {
                        @* Köhnə dəyər siyahıda yoxdursa səssizcə dəyişməsin: ayrıca göstərilir *@
                        <option value="@Model.ButtonUrl" selected>@T["{0} (current, not in the list)", Model.ButtonUrl]</option>
                    }
                </select>
                <p class="hint">@T["Only pages of this site. A visitor who is logged in is taken to the matching page of the app."]</p>
                <span asp-validation-for="ButtonUrl" class="field-error"></span>
            </div>
        </section>

        <div class="rv-actions">
            <a class="btn btn-secondary btn-cancel" asp-area="Admin" asp-controller="BenefitItem" asp-action="Index">@T["Cancel"]</a>
            <button class="btn btn-primary" type="submit">@T["Create"]</button>
        </div>
    </form>
</main>
