@model CardHeroDetailVM
@{
    ViewData["Title"] = "Hero";
}
<main id="content" class="page">
    <header class="page-head crud-head">
        <div>
            <p class="eyebrow">@T["UI · Home page"]</p>
            <h1>@T["Hero text"]</h1>
            <p class="lede">@T["The text on the left of the top block of the Home page. The cards on the right are managed in"] <a asp-area="Admin" asp-controller="CardDesign" asp-action="Index">@T["Card designs"]</a>.</p>
        </div>
        <a class="btn btn-secondary" asp-area="Admin" asp-controller="CardHero" asp-action="Edit">@T["Edit"]</a>
    </header>

    @if (TempData["Success"] is string success)
    {
        <p class="flash flash-ok" role="status">@T[success]</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="flash flash-error" role="alert">@T[error]</p>
    }

    <div class="narrow stack-lg">
        <section class="surface">
            <dl class="detail-list">
                <div><dt>@T["Label"]</dt><dd>@Model.Label</dd></div>
                <div><dt>@T["Title"]</dt><dd>@Model.Title</dd></div>
                <div><dt>@T["Description"]</dt><dd>@Model.Description</dd></div>
            </dl>
        </section>
    </div>
</main>
