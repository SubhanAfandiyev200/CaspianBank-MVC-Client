@model CardHeroEditVM
@{
    ViewData["Title"] = "Hero · Edit";
}
<main id="content" class="page">
    <a class="back" asp-area="Admin" asp-controller="CardHero" asp-action="Detail">@T["Hero text"]</a>

    <header class="page-head">
        <p class="eyebrow">@T["UI · Home page"]</p>
        <h1>@T["Edit hero text"]</h1>
        <p class="lede">@T["Change the text on the left of the top block of the Home page."]</p>
    </header>

    <partial name="_LangTabs" />

    <form method="post" asp-area="Admin" asp-controller="CardHero" asp-action="Edit" asp-route-id="@Model.Id" class="narrow stack-lg" novalidate>
        <section class="surface form-stack">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div class="field">
                <label asp-for="Label">@T["Label"]</label>
                <input data-translatable class="input" asp-for="Label" maxlength="100" placeholder="@T["Small text above the title"]" autocomplete="off" />
                <span asp-validation-for="Label" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Title">@T["Title"]</label>
                <input data-translatable class="input" asp-for="Title" maxlength="200" placeholder="@T["Big headline"]" autocomplete="off" />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Description">@T["Description"]</label>
                <textarea data-translatable class="textarea" asp-for="Description" maxlength="500" rows="3" placeholder="@T["One or two sentences."]"></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>
        </section>

        <div class="rv-actions">
            <a class="btn btn-secondary btn-cancel" asp-area="Admin" asp-controller="CardHero" asp-action="Detail">@T["Cancel"]</a>
            <button class="btn btn-primary" type="submit">@T["Save changes"]</button>
        </div>
    </form>
</main>
