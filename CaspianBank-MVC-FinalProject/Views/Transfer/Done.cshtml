@model TransferReceiptUIVM
@using System.Globalization
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Transfer complete";
    var inv = CultureInfo.InvariantCulture;
    var local = Model.CreatedAt.ToLocalTime();
    var isOwn = Model.ToHolder is null;
    string Money(decimal value) { return value.ToString("N2", inv) + " AZN"; }

    // "Share" / "Copy" üçün qısa mətn
    var shareText = "Caspian Bank transfer " + Model.Reference + ": " + Money(Model.Amount) + " to "
        + (Model.ToHolder ?? Model.ToLabel) + " on " + local.ToString("dd MMM yyyy, HH:mm", inv);
}
<main id="content" class="page pay-page">
    <div class="no-print">
        <partial name="_TransferSteps" model="3" />
    </div>

    <section class="rc" aria-labelledby="rc-title">
        <div class="rc-top">
            <span class="rc-check" aria-hidden="true">
                <svg viewBox="0 0 52 52" width="56" height="56" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><circle class="rc-ring" cx="26" cy="26" r="22" /><path class="rc-tick" d="m16 27 7 7 14-16" /></svg>
            </span>
            <h1 id="rc-title">@T["Transfer successful"]</h1>
            <strong class="rc-amount num">@Model.Amount.ToString("N2", inv)<small>@T["AZN"]</small></strong>
            <span class="rc-date">@local.ToString("dd MMM yyyy, HH:mm", inv)</span>
        </div>

        <div class="rc-tear" aria-hidden="true"></div>

        <dl class="rc-list">
            <div><dt>@T["Status"]</dt><dd><span class="badge-pill is-ok">@T["Completed"]</span></dd></div>
            <div><dt>@T["Type"]</dt><dd>@(isOwn ? T["Between your cards"] : Model.IsExternal ? T["To another bank"] : T["To another customer"])</dd></div>
            @if (Model.IsExternal && !string.IsNullOrEmpty(Model.ToBankName))
            {
                <div><dt>@T["Bank"]</dt><dd>@Model.ToBankName</dd></div>
            }
            <div><dt>@T["From"]</dt><dd>@Model.FromLabel</dd></div>
            <div><dt>@T["To"]</dt><dd>@Model.ToLabel@(isOwn ? "" : " · " + Model.ToHolder)</dd></div>
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <div><dt>@T["Note"]</dt><dd>@Model.Note</dd></div>
            }
            <div><dt>@T["Amount"]</dt><dd class="num">@Money(Model.Amount)</dd></div>
            <div><dt>@T["Commission"]</dt><dd class="num">@(Model.Commission > 0 ? Money(Model.Commission) : "Free")</dd></div>
            <div class="rc-total"><dt>@T["Total debit"]</dt><dd class="num">@Money(Model.Total)</dd></div>
            <div><dt>@T["Balance after"]</dt><dd class="num">@Money(Model.FromBalanceAfter)</dd></div>
            <div>
                <dt>@T["Reference"]</dt>
                <dd class="num">@Model.Reference <button type="button" class="btn-copy no-print" data-copy="@Model.Reference" data-copy-label="@T["Reference"]">@T["Copy"]</button></dd>
            </div>
        </dl>

        <div class="rc-zigzag" aria-hidden="true"></div>

        <p class="rc-foot">@T["Caspian Bank · 28 Nizami Street, Baku"]<br />@T["Keep this receipt for your records."]</p>
    </section>

    <div class="rc-actions no-print">
        <button type="button" class="btn btn-secondary" id="rc-print">@T["Save as PDF"]</button>
        <button type="button" class="btn btn-secondary" id="rc-share" data-share="@shareText">@T["Share"]</button>
        <a class="btn btn-secondary" asp-controller="App" asp-action="Index">@T["Back to cards"]</a>
        <a class="btn btn-primary" asp-controller="Transfer" asp-action="Index">@T["New transfer"]</a>
    </div>
</main>
