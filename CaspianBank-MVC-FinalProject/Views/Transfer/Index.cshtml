@model TransferFormVM
@using System.Globalization
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Transfer";
    var inv = CultureInfo.InvariantCulture;
    var active = Model.Cards.Where(c => !c.IsBlocked).ToList();
    var mode = Model.Mode == "other" ? "other" : "own";

    // Cashback kartına köçürmə olmur: öz kartlarım siyahısında göstərilmir
    var ownTargets = active.Where(c => !c.Tier.Equals("Cashback", StringComparison.OrdinalIgnoreCase)).ToList();

    string Money(decimal value) { return value.ToString("N2", inv) + " AZN"; }

    // Hər kartın növünün qaydaları (komissiyasız limit və faiz) canlı hesab üçün seçimlərə yazılır
    (decimal Limit, decimal Percent) Rule(string tier)
    {
        var rule = Model.Tiers.FirstOrDefault(t => t.Tier.Equals(tier, StringComparison.OrdinalIgnoreCase));
        return rule is null ? (0m, 0m) : (rule.TransferLimit, rule.CommissionPercent);
    }

    // Bu ay kartdan artıq göndərilən məbləğ (aylıq komissiyasız limitdən çıxılır)
    decimal UsedThisMonth(int cardId)
    {
        var row = Model.Limits.FirstOrDefault(l => l.CardId == cardId);
        return row is null ? 0m : row.UsedThisMonth;
    }

    var firstTier =active.FirstOrDefault(c => c.Id == Model.FromCardId) ?? active.FirstOrDefault();
}
<main id="content" class="page pay-page">
    <a class="back" asp-controller="App" asp-action="Index">@T["Back to cards"]</a>

    <header class="pay-top">
        <div>
            <p class="eyebrow">@T["Payments"]</p>
            <h1>@T["Transfer money"]</h1>
            <p class="lede">@T["Send money between your cards, to another Caspian customer or to a card of another bank."] <a asp-controller="Recurring" asp-action="Index">@T["Set up a monthly transfer"]</a></p>
        </div>
        <span class="secure-pill">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
            @T["Secure transfer"]
        </span>
    </header>

    <partial name="_TransferSteps" model="1" />

    @if (Model.ApiUnavailable)
    {
        <div class="empty">
            <h3>@T["We can't load your cards"]</h3>
            <p>@T["The service is unavailable right now. Please try again in a moment."]</p>
            <a class="btn btn-secondary" asp-action="Index">@T["Try again"]</a>
        </div>
    }
    else if (active.Count == 0)
    {
        <div class="empty">
            <h3>@T["No card available"]</h3>
            <p>@T["Add an active card before sending money."]</p>
            <a class="btn btn-primary" href="@NavLinks.AddCard">@T["Add a card"]</a>
        </div>
    }
    else
    {
        <div class="pay-stage">
            <aside class="pay-preview" aria-hidden="true">
                <p class="pay-kicker"><span class="pay-mark"></span> @T["Live preview"]</p>
                <div class="pay-scene">
                    <div class="plastic plastic-@(firstTier?.Tier.ToLowerInvariant())" id="pay-card">
                        <span class="plastic-art" aria-hidden="true"></span>
                        <span class="plastic-shine" aria-hidden="true"></span>
                        <div class="plastic-top">
                            <span class="plastic-brand"><span class="plastic-mark" aria-hidden="true"></span><span class="plastic-bank">@T["Caspian"]</span></span>
                            <span class="plastic-tier" id="live-tier">@firstTier?.Tier</span>
                        </div>
                        <div class="plastic-mid"><span class="plastic-chip" aria-hidden="true"></span></div>
                        <p class="plastic-number" id="live-number"></p>
                        <div class="plastic-bottom">
                            <div>
                                <span class="plastic-k">@T["To"]</span>
                                <span class="plastic-v" id="live-holder">@T["Recipient"]</span>
                            </div>
                            <div>
                                <span class="plastic-k">@T["Amount"]</span>
                                <span class="plastic-v num" id="live-amount">@T["0.00 AZN"]</span>
                            </div>
                        </div>
                    </div>
                </div>

                <dl class="pay-order">
                    <div><dt>@T["From"]</dt><dd id="live-from">—</dd></div>
                    <div><dt>@T["Amount"]</dt><dd id="live-order-amount">@T["0.00 AZN"]</dd></div>
                    <div><dt>@T["Commission"]</dt><dd id="live-fee">@T["0.00 AZN"]</dd></div>
                    <div class="pay-total"><dt>@T["Total debit"]</dt><dd id="live-total">@T["0.00 AZN"]</dd></div>
                </dl>

                <div class="limit-meter" aria-hidden="true">
                    <div class="limit-meter-bar"><span id="meter-fill"></span></div>
                    <p id="meter-text">@T["Commission-free up to 0.00 AZN"]</p>
                </div>
            </aside>

            <div class="pay-details">
                <form asp-controller="Transfer" asp-action="Review" method="post" id="transfer-form" class="pay-form" novalidate data-mode="@mode" data-bank-url="@Url.Action("Bank", "Transfer")">
                    <div class="pay-form-head">
                        <h2>@T["Transfer details"]</h2>
                        <p class="lede">@T["Fill in the details. You will review everything before the money moves."]</p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Error))
                    {
                        <p class="flash flash-error" role="alert">@T[Model.Error]</p>
                    }

                    <input type="hidden" name="RequestId" value="@Model.RequestId" />
                    <input type="hidden" name="Mode" id="mode-input" value="@mode" />

                    <div class="field">
                        <label for="from-card">@T["From"]</label>
                        <select class="select" id="from-card" name="FromCardId" data-card-pick>
                            @foreach (var card in active)
                            {
                                var rule = Rule(card.Tier);
                                <option value="@card.Id" selected="@(card.Id == Model.FromCardId)"
                                        data-tier="@card.Tier" data-last4="@card.Last4" data-money="@Money(card.Balance)"
                                        data-balance="@card.Balance.ToString(inv)" data-design="@card.DesignImage"
                                        data-limit="@rule.Limit.ToString(inv)" data-pct="@rule.Percent.ToString(inv)"
                                        data-used="@UsedThisMonth(card.Id).ToString(inv)">@card.Tier · •••• @card.Last4 · @Money(card.Balance)</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <span class="field-label" id="to-label">@T["To"]</span>
                        <div class="segment segment-full" role="group" aria-labelledby="to-label">
                            <button type="button" id="to-own" class="@(mode == "own" ? "is-active" : "")">@T["My own card"]</button>
                            <button type="button" id="to-other" class="@(mode == "other" ? "is-active" : "")">@T["Another customer"]</button>
                        </div>
                        <p class="hint" id="cashback-hint" hidden>@T["Sending from the Cashback card has no commission."]</p>
                    </div>

                    <div class="field" id="own-field" @(mode == "other" ? "hidden" : null)>
                        <div class="field" id="own-pick">
                            <label for="to-card">@T["Destination card"]</label>
                            <select class="select" id="to-card" name="ToCardId" data-card-pick data-selected="@Model.ToCardId">
                                @foreach (var card in ownTargets)
                                {
                                    <option value="@card.Id"
                                            data-tier="@card.Tier" data-last4="@card.Last4" data-money="@Money(card.Balance)"
                                            data-design="@card.DesignImage">@card.Tier · •••• @card.Last4 · @Money(card.Balance)</option>
                                }
                            </select>
                        </div>

                        @* Başqa kart yoxdursa boş açılan siyahı əvəzinə izah və iki yol göstərilir (JS göndərən karta görə açır) *@
                        <div class="empty-inline" id="own-empty" hidden>
                            <span class="empty-inline-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2.5" /><path d="M3 10.5h18M7 15h3" /></svg>
                            </span>
                            <div class="empty-inline-copy">
                                <strong>@T["You have no other card to send to"]</strong>
                                <p>@T["Money moves between two different cards of yours. Add another card, or send to another customer."]</p>
                                <div class="empty-inline-actions">
                                    <a class="btn btn-secondary btn-sm" href="@NavLinks.AddCard">@T["Add a card"]</a>
                                    <button type="button" class="link-btn" id="own-empty-other">@T["Send to another customer"]</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="field" id="other-field" @(mode == "own" ? "hidden" : null)>
                        <label for="to-number">@T["Recipient card number"]</label>
                        @* Nömrənin ilk 6 rəqəmi (BIN) yazılanda bankın adı və loqosu burada çıxır *@
                        <div class="bank-chip" id="bank-chip" hidden aria-live="polite">
                            <span class="bank-chip-logo" id="bank-chip-logo" aria-hidden="true"></span>
                            <span class="bank-chip-name" id="bank-chip-name"></span>
                        </div>
                        <div class="input-group has-prefix has-status" id="number-group">
                            <span class="input-prefix" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2.5" /><path d="M3 10.5h18M7 15h3" /></svg>
                            </span>
                            <input class="input input-number" id="to-number" name="ToCardNumber" inputmode="numeric" placeholder="0000 0000 0000 0000"
                                   maxlength="19" autocomplete="off" value="@Model.ToCardNumber" />
                            <span class="input-status" id="number-status" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10" /></svg>
                            </span>
                        </div>
                        <p class="hint">@T["The 16-digit number of a Caspian card or a card from another bank. You will see the recipient's name before you confirm."]</p>
                    </div>

                    <div class="field">
                        <label for="amount">@T["Amount"]</label>
                        <div class="amount-box" id="amount-box">
                            <input class="amount-input" id="amount" name="Amount" inputmode="decimal" placeholder="0.00" maxlength="12" autocomplete="off" aria-describedby="limit-hint amount-error" value="@Model.Amount" />
                            <span class="amount-cur">@T["AZN"]</span>
                        </div>
                        <p class="field-error" id="amount-error" role="alert" hidden></p>
                        <div class="chips chips-tight" role="group" aria-label="@T["Quick amounts"]">
                            <button type="button" class="chip" data-quick="50">50</button>
                            <button type="button" class="chip" data-quick="100">100</button>
                            <button type="button" class="chip" data-quick="250">250</button>
                            <button type="button" class="chip" data-quick="500">500</button>
                            <button type="button" class="chip chip-max" id="amount-max">@T["Max"]</button>
                        </div>
                        <p class="hint" id="limit-hint"></p>
                    </div>

                    <div class="field">
                        <label for="note">@T["Note"] <span class="optional">@T["(optional)"]</span></label>
                        <input class="input" id="note" name="Note" maxlength="140" placeholder="@T["What's this for?"]" autocomplete="off" value="@Model.Note" />
                        <span class="field-counter" id="note-count" aria-hidden="true">0 / 140</span>
                    </div>

                    <div class="review-action">
                        <button class="btn btn-primary btn-block btn-lg" type="submit" id="review-btn">@T["Review transfer"]</button>
                        <p class="review-hint" id="review-hint" role="status"></p>
                    </div>

                    <ul class="pay-trust">
                        <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>@T["Nothing is sent until you confirm"]</li>
                        <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>@T["Commission is shown before you pay"]</li>
                        <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>@T["You get a receipt and it is kept in your card activity"]</li>
                    </ul>
                </form>
            </div>
        </div>
    }
</main>
