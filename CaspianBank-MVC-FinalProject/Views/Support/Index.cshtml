@model SupportPageVM
@*
    Contact us: söhbət pəncərəsi (AI tipli köməkçi) Contact formasının əvəzidir. Dizayn əsası: CaspianBank-Frontend/contact-us.html (başlıq və Head office hissəsi).
    Söhbət paneli hələ önizləmədir (cavab verən yoxdur, AI qoşulanda işləyəcək). Altdakı "Write to us" və "Your messages" real işləyir: mesaj dəstəyə gedir (admin Tickets).
    Köməkçi bank və bu sayt haqqında suallara cavab verəcək. Ad, ünvan və telefon footer ilə eyni yerdən (Settings) gəlir.
*@
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Contact us";
    var firstName = (User.Identity?.Name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "there";
}
<main id="content" class="page">
    <header class="page-head">
        <p class="eyebrow">@T["Support"]</p>
        <h1>@T["Contact us"]</h1>
        <p class="lede">@T["Ask the Caspian assistant about the bank and this app, or visit the head office in Baku."]</p>
    </header>

    <p class="demo-note"><span>@T["Preview: the assistant opens soon. The conversation below is a sample."]</span></p>

    <div class="layout-2">
        <section class="surface chat" aria-label="@T["Chat with the Caspian assistant"]">
            <header class="chat-head">
                <span class="chat-avatar" aria-hidden="true">C</span>
                <div>
                    <strong>@T["Caspian assistant"]</strong>
                    <small>@T["Ask about cards, transfers, loans and how this app works"]</small>
                </div>
            </header>
            <div class="chat-log" role="log" aria-live="polite">
                <div class="chat-msg">
                    <div class="chat-bubble">@T["Hi {0}! I can answer questions about Caspian Bank and this app: cards, transfers, fees, loans. What would you like to know?", firstName]</div>
                </div>
                <div class="chat-msg is-user">
                    <div class="chat-bubble">@T["How do I block a card?"]</div>
                </div>
                <div class="chat-msg">
                    <div class="chat-bubble">@T["Open the card on the Cards page and press Block card. We email a 6-digit code to your account address, and the card is blocked once you enter it. You can unblock it the same way."]</div>
                </div>
            </div>
            <div class="chips chat-suggest" aria-label="@T["Suggested questions"]">
                <button type="button" class="chip" disabled>@T["What are the transfer fees?"]</button>
                <button type="button" class="chip" disabled>@T["How does a loan work?"]</button>
                <button type="button" class="chip" disabled>@T["How do I top up my card?"]</button>
            </div>
            <form class="chat-composer" novalidate>
                <input class="input" placeholder="@T["Ask a question…"]" aria-label="@T["Your question"]" maxlength="500" disabled />
                <button class="btn btn-primary" type="button" disabled>@T["Send"]</button>
            </form>
        </section>

        <section class="surface stack">
            <h2>@T["Head office"]</h2>
            <div class="address-list">
                <strong>@Model.Settings.CompanyName</strong>
                <span>@Model.Settings.Address</span>
                <span>@T["Tel {0}", Model.Settings.PhoneNumber]</span>
                <span>@T["Mon–Fri, 09:00–18:00"]</span>
            </div>
            <div class="map-wrap">
                <iframe title="@T["Map showing Caspian Bank head office on Nizami Street, Baku"]" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://maps.google.com/maps?q=40.3730,49.8370&amp;z=16&amp;output=embed"></iframe>
            </div>
        </section>
    </div>
    <div class="layout-2 mt-5">
        <section class="surface">
            <h2>@T["Write to us"]</h2>
            <p class="hint">@T["Send a message to our desk. We answer here and you get a notification."]</p>
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <p class="flash flash-error" role="alert">@T[Model.Error]</p>
            }
            <form method="post" asp-action="Create" class="form-stack" novalidate>
                <div class="field">
                    <label for="ticket-subject">@T["Subject"]</label>
                    <input class="input" id="ticket-subject" name="Subject" maxlength="120" autocomplete="off" placeholder="@T["For example: SWIFT transfer timing"]" value="@Model.Form.Subject" />
                </div>
                <div class="field">
                    <label for="ticket-message">@T["Message"]</label>
                    <textarea class="input" id="ticket-message" name="Message" rows="5" maxlength="2000" placeholder="@T["Tell us what you need"]">@Model.Form.Message</textarea>
                </div>
                <button class="btn btn-primary" type="submit" data-once>@T["Send message"]</button>
            </form>
        </section>

        <section class="surface surface-tight">
            <div class="toolbar"><h2>@T["Your messages"]</h2></div>
            @if (TempData["Error"] is string supportError)
            {
                <p class="flash flash-error" role="alert">@T[supportError]</p>
            }
            @if (Model.Tickets.Count == 0)
            {
                <div class="empty">
                    <h3>@T["No messages yet"]</h3>
                    <p>@T["Messages you send to the desk will show up here with our answers."]</p>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead><tr><th>@T["Subject"]</th><th>@T["Status"]</th><th>@T["Last activity"]</th></tr></thead>
                        <tbody>
                            @foreach (var ticket in Model.Tickets)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Ticket" asp-route-id="@ticket.Id"><strong>@ticket.Subject</strong></a>
                                        <div class="hint">@ticket.LastMessagePreview</div>
                                    </td>
                                    <td>
                                        @if (ticket.Status == "Answered")
                                        {
                                            <span class="badge badge-success">@T["Answered"]</span>
                                        }
                                        else if (ticket.Status == "Closed")
                                        {
                                            <span class="badge badge-neutral">@T["Closed"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-pending">@T["Waiting for us"]</span>
                                        }
                                    </td>
                                    <td>@ticket.LastActivityAt.ToLocalTime().ToString("dd MMM, HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</main>