@model ForgotPasswordVM
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}
<main class="auth-shell">
    <section class="auth-card">
        @await Component.InvokeAsync("SiteLogo")
        @if (Model.Sent)
        {
            <div id="forgot-sent">
                <h1>@T["Check your email"]</h1>
                <p class="lede">@T["If an account exists for {0}, a reset link is on its way. It expires in 30 minutes.", Model.MaskedEmail]</p>
                @if (!string.IsNullOrEmpty(Model.DevLink))
                {
                    <p class="field-hint"><strong>@T["Demo mode (email is not configured):"]</strong> <a href="@Model.DevLink">@T["open the reset link"]</a></p>
                }
                <div class="form-stack mt-5">
                    <a class="btn btn-primary btn-block" asp-controller="Account" asp-action="Login">@T["Back to log in"]</a>
                </div>
            </div>
        }
        else
        {
            <div id="forgot-step">
                <h1>@T["Reset your password"]</h1>
                <p class="lede">@T["We will email you a link to choose a new password."]</p>
                @if (TempData["Info"] is string info)
                {
                    <p class="field-hint">@info</p>
                }
                <form id="forgot-form" class="form-stack mt-5" asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="field-error"></div>
                    <div class="field">
                        <label for="email">@T["Email"]</label>
                        <input class="input" id="email" asp-for="Email" type="email" autocomplete="username" placeholder="name@email.com" />
                    </div>
                    <button class="btn btn-primary btn-block" type="submit">@T["Send reset link"]</button>
                    <div class="auth-links auth-links-center">
                        <a asp-controller="Account" asp-action="Login" data-carry-email>@T["Back to log in"]</a>
                    </div>
                </form>
            </div>
        }
        <p class="auth-foot">
            <a asp-controller="Home" asp-action="Index" asp-fragment="contact">@T["Contact us"]</a>
            <span>@T["Caspian Bank · Baku"]</span>
        </p>
    </section>
</main>
@section Scripts {
    <script src="~/js/auth-fields.js"></script>
}
