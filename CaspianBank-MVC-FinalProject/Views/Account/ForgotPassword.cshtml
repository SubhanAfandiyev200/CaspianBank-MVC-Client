@model ForgotPasswordVM
@{
    Layout = "_AuthLayout";
}
<main class="auth-shell">
    <section class="auth-card">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <svg class="brand-mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
                <rect width="32" height="32" rx="8" fill="#1F8A4C" />
                <path d="M22 11.2a7.2 7.2 0 1 0 0 9.6" fill="none" stroke="#E4D2A8" stroke-width="2.4" stroke-linecap="round" />
            </svg>
            <span>Caspian Bank</span>
        </a>
        @if (Model.Sent)
        {
            <div id="forgot-sent">
                <h1>Check your email</h1>
                <p class="lede">If an account exists for @Model.MaskedEmail, a reset link is on its way. It expires in 30 minutes.</p>
                @if (!string.IsNullOrEmpty(Model.DevLink))
                {
                    <p class="field-hint"><strong>Demo mode (email is not configured):</strong> <a href="@Model.DevLink">open the reset link</a></p>
                }
                <div class="form-stack mt-5">
                    <a class="btn btn-primary btn-block" asp-controller="Account" asp-action="Login">Back to log in</a>
                </div>
            </div>
        }
        else
        {
            <div id="forgot-step">
                <h1>Reset your password</h1>
                <p class="lede">We will email you a link to choose a new password.</p>
                @if (TempData["Info"] is string info)
                {
                    <p class="field-hint">@info</p>
                }
                <form id="forgot-form" class="form-stack mt-5" asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="field-error"></div>
                    <div class="field">
                        <label for="email">Email</label>
                        <input class="input" id="email" asp-for="Email" type="email" autocomplete="username" placeholder="name@email.com" />
                    </div>
                    <button class="btn btn-primary btn-block" type="submit">Send reset link</button>
                    <div class="auth-links auth-links-center">
                        <a asp-controller="Account" asp-action="Login" data-carry-email>Back to log in</a>
                    </div>
                </form>
            </div>
        }
        <p class="auth-foot">
            <a asp-controller="Home" asp-action="Index" asp-fragment="contact">Contact us</a>
            <span>Caspian Bank · Baku</span>
        </p>
    </section>
</main>
@section Scripts {
    <script src="~/js/auth-fields.js"></script>
}
