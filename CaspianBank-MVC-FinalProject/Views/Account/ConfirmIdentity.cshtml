@model ConfirmIdentityVM
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Is this you?";
}
@* Qeydiyyat, 2-ci addım: "Bu sizsiniz?". Reyestrdən yalnız şəkil, ad, soyadın baş hərfi və doğum ili göstərilir. Şəkil CSS ilə ağ-qara olur. *@
<main class="auth-shell">
    <section class="auth-card auth-wide">
        @await Component.InvokeAsync("SiteLogo")
        <a class="back" asp-controller="Account" asp-action="Register">← Enter the details again</a>
        <h1>Is this you?</h1>
        <p class="lede">We found this person in the registry. Confirm to continue.</p>
        <div class="citizen-card">
            <div class="citizen-photo">
                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <img src="@Model.PhotoUrl" alt="" onerror="this.remove()" />
                }
            </div>
            <div class="citizen-info">
                <strong>@Model.Name @Model.MaskedSurname</strong>
                <span>Born in @Model.BirthYear</span>
                <span>FIN @Model.Fin</span>
            </div>
        </div>
        <form class="form-stack mt-5" asp-controller="Account" asp-action="ConfirmIdentityYes" method="post">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <button class="btn btn-primary btn-block" type="submit">Yes, this is me</button>
            <div class="auth-links auth-links-center">
                <a asp-controller="Account" asp-action="Register">No, this is not me</a>
            </div>
        </form>
        <p class="auth-foot">
            <a asp-controller="Home" asp-action="Index" asp-fragment="contact">Contact us</a>
            <span>Caspian Bank · Baku</span>
        </p>
    </section>
</main>
