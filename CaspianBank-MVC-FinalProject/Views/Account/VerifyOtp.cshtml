@model VerifyOtpVM
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Verify your email";
}
<main class="auth-shell">
    <section class="auth-card">
        @await Component.InvokeAsync("SiteLogo")
        <a class="back" asp-controller="Account" asp-action="RegisterEmail">@T["← Use a different email"]</a>
        <h1>@T["Verify your email"]</h1>
        <p class="lede">@T["We sent a code to {0}.", Model.MaskedEmail]</p>
        @if (!string.IsNullOrEmpty(Model.DevCode))
        {
            <p class="field-hint"><strong>@T["Demo mode (email is not configured):"]</strong> @T["your code is"] <strong>@Model.DevCode</strong></p>
        }
        @if (TempData["Info"] is string info)
        {
            <p class="field-hint">@info</p>
        }
        <form id="otp-form" class="form-stack mt-5" asp-controller="Account" asp-action="VerifyOtp" method="post" novalidate>
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Code" id="otp-code" />
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div class="field">
                <label for="otp-1">@T["6-digit code"]</label>
                <div class="otp@(ViewData.ModelState.ErrorCount > 0 ? " is-invalid" : "")" data-otp>
                    <input class="otp-input" id="otp-1" inputmode="numeric" autocomplete="one-time-code" maxlength="1" aria-label="@T["Digit 1"]" />
                    <input class="otp-input" inputmode="numeric" maxlength="1" aria-label="@T["Digit 2"]" />
                    <input class="otp-input" inputmode="numeric" maxlength="1" aria-label="@T["Digit 3"]" />
                    <input class="otp-input" inputmode="numeric" maxlength="1" aria-label="@T["Digit 4"]" />
                    <input class="otp-input" inputmode="numeric" maxlength="1" aria-label="@T["Digit 5"]" />
                    <input class="otp-input" inputmode="numeric" maxlength="1" aria-label="@T["Digit 6"]" />
                </div>
            </div>
            <button class="btn btn-primary btn-block" id="otp-submit" type="submit">@T["Verify"]</button>
        </form>
        <form class="hint mt-5" asp-controller="Account" asp-action="ResendOtp" method="post">
            <input type="hidden" name="email" value="@Model.Email" />
            <button class="btn-link" type="submit" id="resend" data-wait="@Model.ResendWaitSeconds" disabled>@T["Resend code"]</button>
        </form>
        <p class="auth-foot">
            <a asp-controller="Home" asp-action="Index" asp-fragment="contact">@T["Contact us"]</a>
            <span>@T["Caspian Bank · Baku"]</span>
        </p>
    </section>
</main>
@section Scripts {
    <script src="~/js/otp-input.js" asp-append-version="true"></script>
}
