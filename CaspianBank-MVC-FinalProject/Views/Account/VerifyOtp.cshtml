@model CaspianBank_MVC_FinalProject.ViewModels.Account.VerifyOtpVM
@{
    Layout = "_AuthLayout";
    var otpError = !ViewData.ModelState.IsValid;
    var digits = (Model.Code ?? string.Empty).PadRight(6).ToCharArray();
}
<main class="auth-shell">
    <section class="auth-card">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <svg class="brand-mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
                <rect width="32" height="32" rx="8" fill="#1F8A4C" />
                <path d="M22 11.2a7.2 7.2 0 1 0 0 9.6" fill="none" stroke="#E4D2A8" stroke-width="2.4" stroke-linecap="round" />
            </svg>
            <span>Caspian Bank</span>
        </a>
        <h1>Verify your email</h1>
        <p class="lede" id="otp-lead">We sent a code to @Model.MaskedEmail.</p>
        <form id="otp-form" class="form-stack mt-5" asp-controller="Account" asp-action="VerifyOtp" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Code" id="otp-code" />
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div class="field">
                <label for="otp-1">6-digit code</label>
                <div class="otp@(otpError ? " is-error" : "")" data-otp>
                    <input class="otp-input" id="otp-1" inputmode="numeric" autocomplete="one-time-code" maxlength="1" aria-label="Digit 1" aria-invalid="@(otpError ? "true" : "false")" value="@(char.IsDigit(digits[0]) ? digits[0].ToString() : "")" />
                    <input class="otp-input" inputmode="numeric" maxlength="1" aria-label="Digit 2" aria-invalid="@(otpError ? "true" : "false")" value="@(char.IsDigit(digits[1]) ? digits[1].ToString() : "")" />
                    <input class="otp-input" inputmode="numeric" maxlength="1" aria-label="Digit 3" aria-invalid="@(otpError ? "true" : "false")" value="@(char.IsDigit(digits[2]) ? digits[2].ToString() : "")" />
                    <input class="otp-input" inputmode="numeric" maxlength="1" aria-label="Digit 4" aria-invalid="@(otpError ? "true" : "false")" value="@(char.IsDigit(digits[3]) ? digits[3].ToString() : "")" />
                    <input class="otp-input" inputmode="numeric" maxlength="1" aria-label="Digit 5" aria-invalid="@(otpError ? "true" : "false")" value="@(char.IsDigit(digits[4]) ? digits[4].ToString() : "")" />
                    <input class="otp-input" inputmode="numeric" maxlength="1" aria-label="Digit 6" aria-invalid="@(otpError ? "true" : "false")" value="@(char.IsDigit(digits[5]) ? digits[5].ToString() : "")" />
                </div>
            </div>
            <button class="btn btn-primary btn-block" id="otp-submit" type="submit">Verify</button>
        </form>
        <p class="hint mt-5">
            <button class="btn-link" type="button" id="resend" disabled>Resend code</button>
        </p>
        <p class="auth-foot">
            <a asp-controller="Home" asp-action="Index" asp-fragment="contact">Contact us</a>
            <span>Caspian Bank · Baku</span>
        </p>
    </section>
</main>
@section Scripts {
    <script src="~/js/verify-otp.js"></script>
}
