@model ResetPasswordVM
@{
    Layout = "_AuthLayout";
}
<main class="auth-shell">
    <section class="auth-card">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <svg class="brand-mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
                <rect width="32" height="32" rx="8" fill="#1F8A4C" />
                <path d="M22 11.2a7.2 7.2 0 1 0 0 9.6" fill="none" stroke="#E4D2A8" stroke-width="2.4" stroke-linecap="round" />
            </svg>
            <span>Caspian Bank</span>
        </a>
        <div id="reset-step">
            <h1>Choose a new password</h1>
            <p class="lede">Set a password for your Caspian account.</p>
            <form id="reset-form" class="form-stack mt-5" asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div asp-validation-summary="ModelOnly" class="field-error"></div>
                <div class="field">
                    <label for="password">New password</label>
                    <input class="input" id="password" asp-for="Password" type="password" data-password autocomplete="new-password" />
                    <p class="field-hint">At least 6 characters, with upper and lower case letters, a number and a symbol.</p>
                </div>
                <div class="field">
                    <label for="confirm">Confirm password</label>
                    <input class="input" id="confirm" asp-for="ConfirmPassword" type="password" data-password autocomplete="new-password" />
                </div>
                <button class="btn btn-primary btn-block" type="submit">Update password</button>
                <div class="auth-links">
                    <a asp-controller="Account" asp-action="ForgotPassword">Request a new link</a>
                    <a asp-controller="Account" asp-action="Login">Back to log in</a>
                </div>
            </form>
        </div>
        <p class="auth-foot">
            <a asp-controller="Home" asp-action="Index" asp-fragment="contact">Contact us</a>
            <span>Caspian Bank · Baku</span>
        </p>
    </section>
</main>
@section Scripts {
    <script src="~/js/auth-fields.js"></script>
}
