@model ResetPasswordVM
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
}
<main class="auth-shell">
    <section class="auth-card">
        @await Component.InvokeAsync("SiteLogo")
        <div id="reset-step">
            <h1>@T["Choose a new password"]</h1>
            <p class="lede">@T["Set a password for your Caspian account."]</p>
            <form id="reset-form" class="form-stack mt-5" asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div asp-validation-summary="ModelOnly" class="field-error"></div>
                <div class="field">
                    <label for="password">@T["New password"]</label>
                    <input class="input" id="password" asp-for="Password" type="password" data-password autocomplete="new-password" />
                    <p class="field-hint">@T["At least 6 characters, with upper and lower case letters, a number and a symbol."]</p>
                </div>
                <div class="field">
                    <label for="confirm">@T["Confirm password"]</label>
                    <input class="input" id="confirm" asp-for="ConfirmPassword" type="password" data-password autocomplete="new-password" />
                </div>
                <button class="btn btn-primary btn-block" type="submit">@T["Update password"]</button>
                <div class="auth-links">
                    <a asp-controller="Account" asp-action="ForgotPassword">@T["Request a new link"]</a>
                    <a asp-controller="Account" asp-action="Login">@T["Back to log in"]</a>
                </div>
            </form>
        </div>
        <p class="auth-foot">
            <a asp-controller="Home" asp-action="Index" asp-fragment="contact">@T["Contact us"]</a>
            <span>@T["Caspian Bank · Baku"]</span>
        </p>
    </section>
</main>
@section Scripts {
    <script src="~/js/auth-fields.js"></script>
}
