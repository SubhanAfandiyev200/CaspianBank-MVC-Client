@model LoanReceiptUIVM
@using System.Globalization
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Loan payment";
    var inv = CultureInfo.InvariantCulture;
    var local = Model.PaidAt.ToLocalTime();
    var shareText = "Caspian Bank loan payment " + Model.Reference + ": " + LoanUi.Money(Model.Amount) + " for " + Model.ContractNumber
        + " on " + local.ToString("dd MMM yyyy, HH:mm", inv);
}
<main id="content" class="page pay-page">
    <section class="rc" aria-labelledby="rc-title">
        <div class="rc-top">
            <span class="rc-check" aria-hidden="true">
                <svg viewBox="0 0 52 52" width="56" height="56" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><circle class="rc-ring" cx="26" cy="26" r="22" /><path class="rc-tick" d="m16 27 7 7 14-16" /></svg>
            </span>
            <h1 id="rc-title">@(Model.LoanClosed ? T["Loan paid off"] : T["Payment received"])</h1>
            <strong class="rc-amount num">@Model.Amount.ToString("N2", inv)<small>@T["AZN"]</small></strong>
            <span class="rc-date">@local.ToString("dd MMM yyyy, HH:mm", inv)</span>
        </div>

        <div class="rc-tear" aria-hidden="true"></div>

        <dl class="rc-list">
            <div><dt>@T["Status"]</dt><dd><span class="badge-pill is-ok">@T["Completed"]</span></dd></div>
            <div><dt>@T["Loan"]</dt><dd>@Model.ContractNumber</dd></div>
            <div><dt>@T["Type"]</dt><dd>@LoanUi.PaymentTypeText(Model.Type)</dd></div>
            <div><dt>@T["Paid from"]</dt><dd>@Model.CardLabel</dd></div>
            <div><dt>@T["Principal"]</dt><dd class="num">@LoanUi.Money(Model.Principal)</dd></div>
            <div><dt>@T["Interest"]</dt><dd class="num">@LoanUi.Money(Model.Interest)</dd></div>
            @if (Model.Penalty > 0)
            {
                <div><dt>@T["Penalty"]</dt><dd class="num">@LoanUi.Money(Model.Penalty)</dd></div>
            }
            @if (Model.NewInterestRate.HasValue)
            {
                <div><dt>@T["New interest rate"]</dt><dd>@LoanUi.Percent(Model.NewInterestRate.Value) a year</dd></div>
            }
            <div class="rc-total"><dt>@T["Total paid"]</dt><dd class="num">@LoanUi.Money(Model.Amount)</dd></div>
            <div><dt>@T["Card balance after"]</dt><dd class="num">@LoanUi.Money(Model.CardBalanceAfter)</dd></div>
            <div>
                <dt>@T["Reference"]</dt>
                <dd class="num">@Model.Reference <button type="button" class="btn-copy no-print" data-copy="@Model.Reference" data-copy-label="@T["Reference"]">@T["Copy"]</button></dd>
            </div>
        </dl>

        <div class="rc-zigzag" aria-hidden="true"></div>

        <p class="rc-foot">@T["Caspian Bank · 28 Nizami Street, Baku"]<br />@T["Keep this receipt for your records."]</p>
    </section>

    <div class="rc-actions no-print">
        <button type="button" class="btn btn-secondary" id="rc-print">@T["Save as PDF"]</button>
        <button type="button" class="btn btn-secondary" id="rc-share" data-share="@shareText">@T["Share"]</button>
        <a class="btn btn-primary" asp-controller="Loans" asp-action="Detail" asp-route-id="@Model.LoanId">@T["Back to the loan"]</a>
    </div>
</main>
