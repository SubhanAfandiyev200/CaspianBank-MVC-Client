@model CaspianBank_MVC_FinalProject.ViewModels.Transfers.RecurringPageVM
@using System.Globalization
@*
    Aylıq köçürmələr: hər ayın seçilmiş günü kartdan eyni məbləğ köçürülür. Qaydaları (alıcı, limit, komissiya, balans) API yoxlayır;
    pul çatmasa həmin gün köçürmə olmur, müştəriyə bildiriş gedir və ertəsi gün yenidən cəhd olunur.
*@
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Monthly transfers";
    var inv = CultureInfo.InvariantCulture;
    var form = Model.Form;
    var senders = Model.Cards.Where(c => !c.IsBlocked).ToList();
    // Öz kartına köçürmədə Cashback kartı alıcı ola bilməz
    var ownTargets = senders.Where(c => !c.Tier.Equals("Cashback", StringComparison.OrdinalIgnoreCase)).ToList();
    var mode = form.Mode == "own" && ownTargets.Count > 1 ? "own" : "other";
    var firstSender = senders.FirstOrDefault(c => c.Id == form.FromCardId) ?? senders.OrderByDescending(c => c.Balance).FirstOrDefault();

    string Money(decimal value) { return value.ToString("N2", inv) + " AZN"; }
}
<main id="content" class="page page-activity">
    <a class="back" asp-controller="Transfer" asp-action="Index">@T["Back to transfers"]</a>

    <header class="page-head">
        <p class="eyebrow">@T["Payments"]</p>
        <h1>@T["Monthly transfers"]</h1>
        <p class="lede">@T["Send the same amount on the same day every month, for example rent or help for family. You can pause or delete a transfer at any time."]</p>
    </header>

    <partial name="_Flash" />

    @if (Model.ApiUnavailable)
    {
        <div class="empty">
            <h3>@T["We can't load your monthly transfers"]</h3>
            <p>@T["The service is unavailable right now. Please try again in a moment."]</p>
            <a class="btn btn-secondary" asp-action="Index">@T["Try again"]</a>
        </div>
    }
    else
    {
        <div class="layout-2">
            <form class="surface form-stack form-card" method="post" asp-controller="Recurring" asp-action="Create" id="recurring-form" novalidate data-mode="@mode">
                <h2>@T["New monthly transfer"]</h2>

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <p class="flash flash-error" role="alert">@T[Model.Error]</p>
                }

                @if (senders.Count == 0)
                {
                    <p class="hint">@T["You need an active card to set up a monthly transfer."]</p>
                }
                else
                {
                    <input type="hidden" name="Mode" id="rec-mode" value="@mode" />

                    <div class="field">
                        <label for="rec-from">@T["From"]</label>
                        <select class="select" id="rec-from" name="FromCardId" data-card-pick>
                            @foreach (var card in senders)
                            {
                                <option value="@card.Id" selected="@(firstSender is not null && card.Id == firstSender.Id)"
                                        data-tier="@card.Tier" data-last4="@card.Last4" data-money="@Money(card.Balance)"
                                        data-design="@card.DesignImage">@card.Tier · •••• @card.Last4 · @Money(card.Balance)</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <span class="field-label" id="rec-to-label">@T["To"]</span>
                        <div class="segment segment-full" role="group" aria-labelledby="rec-to-label">
                            <button type="button" id="rec-own-btn" class="@(mode == "own" ? "is-active" : "")" disabled="@(ownTargets.Count < 2)">@T["My own card"]</button>
                            <button type="button" id="rec-other-btn" class="@(mode == "other" ? "is-active" : "")">@T["Another card"]</button>
                        </div>
                    </div>

                    <div class="field" id="rec-own-field" @(mode == "other" ? "hidden" : null)>
                        <label for="rec-own">@T["Destination card"]</label>
                        <select class="select" id="rec-own" name="ToCardId" data-card-pick>
                            @foreach (var card in ownTargets)
                            {
                                <option value="@card.Id" selected="@(form.ToCardId == card.Id)"
                                        data-tier="@card.Tier" data-last4="@card.Last4" data-money="@Money(card.Balance)"
                                        data-design="@card.DesignImage">@card.Tier · •••• @card.Last4 · @Money(card.Balance)</option>
                            }
                        </select>
                    </div>

                    <div class="field" id="rec-other-field" @(mode == "own" ? "hidden" : null)>
                        <label for="rec-number">@T["Recipient card number"]</label>
                        <input class="input input-number" id="rec-number" name="ToCardNumber" inputmode="numeric" placeholder="0000 0000 0000 0000" maxlength="19" autocomplete="off" value="@form.ToCardNumber" />
                        <p class="hint">@T["A Caspian card or a card from another bank. We check it when you save."]</p>
                    </div>

                    <div class="field">
                        <label for="rec-amount">@T["Amount"]</label>
                        <div class="amount-box">
                            <input class="amount-input" id="rec-amount" name="Amount" inputmode="decimal" placeholder="0.00" maxlength="12" autocomplete="off" value="@form.Amount" />
                            <span class="amount-cur">@T["AZN"]</span>
                        </div>
                        <p class="hint">@T["The usual commission rules apply each month."]</p>
                    </div>

                    <div class="field">
                        <label for="rec-day">@T["Day of the month"]</label>
                        <select class="select" data-wheel id="rec-day" name="DayOfMonth">
                            @for (var day = 1; day <= 28; day++)
                            {
                                <option value="@day" selected="@(form.DayOfMonth == day)">@day</option>
                            }
                        </select>
                        <p class="hint">@T["Days up to 28, so it exists in every month. The first transfer is on the next such day."]</p>
                    </div>

                    <div class="field">
                        <label for="rec-note">@T["Note"] <span class="optional">@T["(optional)"]</span></label>
                        <input class="input" id="rec-note" name="Note" maxlength="140" placeholder="@T["What's this for?"]" autocomplete="off" value="@form.Note" />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg" data-once>@T["Save monthly transfer"]</button>
                }
            </form>

            <section class="surface form-card">
                <h2>@T["Your monthly transfers"]</h2>
                @if (Model.Items.Count == 0)
                {
                    <p class="hint">@T["You have no monthly transfers yet."]</p>
                }
                else
                {
                    <div class="dep-list">
                        @foreach (var item in Model.Items)
                        {
                            <article class="dep-card @(item.IsActive ? "" : "is-done")">
                                <div class="dep-top">
                                    <div>
                                        <strong class="num">@Money(item.Amount)</strong>
                                        <span class="hint">@T["to {0}", item.ToLabel]</span>
                                    </div>
                                    <span class="badge-pill @(item.IsActive ? "is-ok" : "")">@(item.IsActive ? T["Active"] : T["Paused"])</span>
                                </div>
                                <dl class="dep-meta">
                                    <div><dt>@T["From"]</dt><dd>@item.FromLabel</dd></div>
                                    <div><dt>@T["Every month on"]</dt><dd>@T["day {0}", item.DayOfMonth]</dd></div>
                                    @if (item.IsActive)
                                    {
                                        <div><dt>@T["Next transfer"]</dt><dd>@item.NextRunDate.ToString("dd MMM yyyy", inv)</dd></div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Note))
                                    {
                                        <div><dt>@T["Note"]</dt><dd>@item.Note</dd></div>
                                    }
                                </dl>
                                @if (!string.IsNullOrEmpty(item.LastError) && item.IsActive)
                                {
                                    <p class="flash flash-error" role="alert">@T["The last try failed: {0} We will try again tomorrow.", item.LastError]</p>
                                }
                                <div class="row-actions">
                                    @if (item.IsActive)
                                    {
                                        <form method="post" asp-controller="Recurring" asp-action="Pause" asp-route-id="@item.Id" class="inline-form">
                                            <button type="submit" class="btn btn-secondary btn-sm">@T["Pause"]</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-controller="Recurring" asp-action="Resume" asp-route-id="@item.Id" class="inline-form">
                                            <button type="submit" class="btn btn-secondary btn-sm">@T["Resume"]</button>
                                        </form>
                                    }
                                    <form method="post" asp-controller="Recurring" asp-action="Delete" asp-route-id="@item.Id" class="inline-form">
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                data-confirm-title="Delete this monthly transfer?"
                                                data-confirm-text="Nothing more will be sent. Transfers already made stay in your history."
                                                data-confirm-yes="Delete"
                                                data-confirm-no="Cancel">Delete</button>
                                    </form>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    }
</main>

@section Scripts {
    <script src="~/js/recurring.js" asp-append-version="true"></script>
}
