@model CaspianBank_MVC_FinalProject.ViewModels.Analytics.SpendingPageVM
@using System.Globalization
@*
    Xərc analitikası: son aylarda kartlardan çıxan pul. Rəqəmləri API hesablayır (öz kartları arasında köçürmə sayılmır),
    qrafik yalnız HTML və CSS-dir (sütunun hündürlüyü ən böyük ayın cəminə nisbətdədir).
*@
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Spending insights";
    var inv = CultureInfo.InvariantCulture;
    var data = Model.Data;
    var current = data.Months.LastOrDefault();
    var maxTotal = data.Months.Count == 0 ? 0m : data.Months.Max(m => m.Total);
    var codes = data.Months.FirstOrDefault()?.Categories.Select(c => c.Code).ToList() ?? new List<string>();

    string Money(decimal value) { return value.ToString("N2", inv) + " AZN"; }

    // Kateqoriyanın CSS rəng sinfi (rənglər temaya uyğun CSS dəyişənlərindədir)
    string Tone(string code)
    {
        var index = codes.IndexOf(code);
        return "cat-" + (index < 0 ? 0 : index + 1);
    }

    string Height(decimal part, decimal whole)
    {
        if (whole <= 0m) return "0";
        return Math.Max(part / whole * 100m, part > 0m ? 2m : 0m).ToString("0.##", inv);
    }
}
<main id="content" class="page page-activity">
    <a class="back" asp-controller="History" asp-action="Index">@T["Back to history"]</a>

    <header class="page-head spread">
        <div>
            <p class="eyebrow">@T["Activity"]</p>
            <h1>@T["Spending insights"]</h1>
            <p class="lede">@T["Where your money went. Moves between your own cards are not counted."]</p>
        </div>
        <div class="segment" role="group" aria-label="@T["Period"]">
            <a class="@(Model.Months == 3 ? "is-active" : "")" asp-action="Index" asp-route-months="3">@T["3 months"]</a>
            <a class="@(Model.Months == 6 ? "is-active" : "")" asp-action="Index" asp-route-months="6">@T["6 months"]</a>
            <a class="@(Model.Months == 12 ? "is-active" : "")" asp-action="Index" asp-route-months="12">@T["12 months"]</a>
        </div>
    </header>

    @if (Model.Unavailable || current is null)
    {
        <div class="empty">
            <h3>@T["We can't load your spending"]</h3>
            <p>@T["The service is unavailable right now. Please try again in a moment."]</p>
            <a class="btn btn-secondary" asp-action="Index">@T["Try again"]</a>
        </div>
    }
    else
    {
        <div class="pulse-row">
            <article class="pulse">
                <span>@T["This month"]</span>
                <strong class="num">@Money(data.CurrentTotal)</strong>
                @if (data.ChangePercent.HasValue)
                {
                    <small class="hint @(data.ChangePercent.Value > 0 ? "amount-out" : "amount-in")">@(data.ChangePercent.Value > 0 ? "+" : "")@data.ChangePercent.Value.ToString("0.#", inv)% @T["compared with last month"]</small>
                }
                else
                {
                    <small class="hint">@T["Last month: {0}", Money(data.PreviousTotal)]</small>
                }
            </article>
            <article class="pulse"><span>@T["Average per month"]</span><strong class="num">@Money(data.AverageMonthly)</strong></article>
            <article class="pulse"><span>@T["Biggest this month"]</span><strong>@(data.TopCategory ?? "—")</strong></article>
        </div>

        <section class="surface form-card">
            <h2>@T["Month by month"]</h2>
            @if (maxTotal <= 0m)
            {
                <p class="hint">@T["No money left your cards in this period yet."]</p>
            }
            else
            {
                <div class="spend-chart" role="img" aria-label="@T["Spending per month, split by category"]">
                    @foreach (var month in data.Months)
                    {
                        <div class="spend-col">
                            <span class="spend-total num">@(month.Total > 0m ? month.Total.ToString("N0", inv) : "")</span>
                            <div class="spend-bar" style="height:@(Height(month.Total, maxTotal))%" title="@T.Month(month.Label): @Money(month.Total)">
                                @foreach (var category in month.Categories.Where(c => c.Amount > 0m))
                                {
                                    <span class="spend-seg @Tone(category.Code)" style="height:@(Height(category.Amount, month.Total))%" title="@T[category.Name]: @Money(category.Amount)"></span>
                                }
                            </div>
                            <span class="spend-label">@T.Month(month.Label)</span>
                        </div>
                    }
                </div>
                <ul class="spend-legend">
                    @foreach (var category in current.Categories)
                    {
                        <li><span class="spend-dot @Tone(category.Code)" aria-hidden="true"></span>@T[category.Name]</li>
                    }
                </ul>
            }
        </section>

        <section class="surface form-card">
            <h2>@T["This month by category"]</h2>
            @if (current.Total <= 0m)
            {
                <p class="hint">@T["No spending this month yet."]</p>
            }
            else
            {
                <div class="spend-rows">
                    @foreach (var category in current.Categories.OrderByDescending(c => c.Amount))
                    {
                        <div class="spend-row">
                            <div class="spend-row-top">
                                <span><span class="spend-dot @Tone(category.Code)" aria-hidden="true"></span>@T[category.Name]</span>
                                <span class="num">@Money(category.Amount) <small class="hint">@((category.Amount / current.Total * 100m).ToString("0", inv))%</small></span>
                            </div>
                            <div class="limit-meter-bar" aria-hidden="true"><span class="@Tone(category.Code)" style="width:@(Height(category.Amount, current.Total))%"></span></div>
                        </div>
                    }
                </div>
                <p class="hint">@T["Fees and commissions include transfer commissions and card opening fees. \"Put into deposits\" is savings, not spending, but it also leaves your card."]</p>
            }
        </section>
    }
</main>
