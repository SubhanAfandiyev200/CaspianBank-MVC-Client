@model PagerVM
@*
    Nömrəli səhifələmə: "Showing 21-40 of 57", ‹ Previous, 1 … 4 5 6 … 9, Next ›.
    Cari səhifənin ətrafında 2 səhifə görünür, qalanı "…" ilə qısaldılır. API-də səhifələmə page və pageSize ilə işləyir.
*@
@{
    var first = Math.Max(1, Model.Page - 2);
    var last = Math.Min(Model.TotalPages, Model.Page + 2);
    var from = Model.TotalCount == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var to = Math.Min(Model.TotalCount, Model.Page * Model.PageSize);
}
@if (Model.TotalCount > 0)
{
    <div class="pager-wrap">
        <p class="pager-summary">Showing <strong>@from–@to</strong> of <strong>@Model.TotalCount</strong></p>
        @if (Model.TotalPages > 1)
        {
            <nav class="pager" aria-label="Pages">
                @if (Model.Page > 1)
                {
                    <a class="pager-link" href="@Model.Url(Model.Page - 1)">‹ Previous</a>
                }
                @if (first > 1)
                {
                    <a class="pager-link" href="@Model.Url(1)">1</a>
                    @if (first > 2)
                    {
                        <span class="pager-gap">…</span>
                    }
                }
                @for (var p = first; p <= last; p++)
                {
                    <a class="pager-link @(p == Model.Page ? "is-current" : "")" href="@Model.Url(p)" aria-current="@(p == Model.Page ? "page" : null)">@p</a>
                }
                @if (last < Model.TotalPages)
                {
                    @if (last < Model.TotalPages - 1)
                    {
                        <span class="pager-gap">…</span>
                    }
                    <a class="pager-link" href="@Model.Url(Model.TotalPages)">@Model.TotalPages</a>
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <a class="pager-link" href="@Model.Url(Model.Page + 1)">Next ›</a>
                }
            </nav>
        }
    </div>
}
