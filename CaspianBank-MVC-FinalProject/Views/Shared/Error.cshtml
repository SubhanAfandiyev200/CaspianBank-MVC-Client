@model ErrorVM
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Model.Title;
}
<main class="auth-shell">
    <section class="auth-card error-card">
        @await Component.InvokeAsync("SiteLogo")
        <p class="error-code">@Model.Status</p>
        <h1>@Model.Title</h1>
        <p class="lede">@Model.Message</p>
        <div class="form-stack mt-5">
            <a class="btn btn-primary btn-block" asp-area="" asp-controller="Home" asp-action="Index">@T["Go to home"]</a>
            <a class="btn btn-secondary btn-block" href="#" onclick="history.back(); return false;">@T["Go back"]</a>
        </div>
        <p class="auth-foot">
            <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="contact">@T["Contact us"]</a>
            <span>@T["Caspian Bank · Baku"]</span>
        </p>
    </section>
</main>
