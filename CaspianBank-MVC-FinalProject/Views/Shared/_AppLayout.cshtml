<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0F5C3F" />
    <title>Cards · Caspian Bank</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body class="body-app">
    <a class="skip" href="#content">Skip to content</a>
    <header class="topnav">
        <div class="topnav-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <svg class="brand-mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
                    <rect width="32" height="32" rx="8" fill="#1F8A4C" />
                    <path d="M22 11.2a7.2 7.2 0 1 0 0 9.6" fill="none" stroke="#E4D2A8" stroke-width="2.4" stroke-linecap="round" />
                </svg>
                <span>Caspian Bank</span>
            </a>
            <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-label="Open menu"><span></span><span></span><span></span></button>
            <div class="topnav-panel">
                <nav class="main-nav" aria-label="Primary">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "App" ? "is-active" : "")" asp-controller="App" asp-action="Index">Cards</a>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transfer" ? "is-active" : "")" asp-controller="Transfer" asp-action="Index">Transfers</a>
                    <a class="nav-link" href="transaction-history.html">History</a>
                    <a class="nav-link" href="loan-application.html">Loans</a>
                    <a class="nav-link" href="bill-payment.html">Bill Payments</a>
                    <a class="nav-link" href="contact-us.html">Contact</a>
                </nav>
                <div class="nav-tools">
                    <form class="header-auth" asp-controller="Account" asp-action="Logout" method="post">
                        <span class="header-user">
                            <span class="header-user-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18">
                                    <circle cx="12" cy="8.2" r="3.4" fill="none" stroke="currentColor" stroke-width="1.7" />
                                    <path d="M5.4 19.2c.9-3.5 3.4-5.2 6.6-5.2s5.7 1.7 6.6 5.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                </svg>
                            </span>
                            <span class="header-user-name">@User.Identity?.Name</span>
                        </span>
                        <button class="btn-logout" type="submit">
                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                                <path d="M10 7V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                <path d="M4 12h11M12 8.5 15.5 12 12 15.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <span class="btn-logout-label">Log out</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </header>
        @RenderBody()
    <footer class="site-footer">
        <div class="site-footer-inner">
            <span>Caspian Bank · 28 Nizami Street, Baku</span>
            <span>Personal banking</span>
        </div>
    </footer>
    <script src="~/js/confirm-dialog.js" asp-append-version="true"></script>
    <script src="~/js/app-cards.js" asp-append-version="true"></script>
</body>
</html>
