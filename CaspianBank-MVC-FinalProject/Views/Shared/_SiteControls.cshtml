@* Dil seçimi (Az/Ru/En) və ağ/qara tema düyməsi: bütün səhifələrin başlığında eyni yerdə *@
@{
    var current = T.Lang;
    var back = Context.Request.Path + Context.Request.QueryString;
    var languages = new[] { ("en", "English"), ("az", "Azərbaycanca"), ("ru", "Русский") };
    // Admin paneli yalnız ingilis dilindədir, orada dil seçimi mənasızdır (tema düyməsi qalır)
    var inAdmin = string.Equals(Context.Request.RouteValues["area"] as string, "Admin", StringComparison.OrdinalIgnoreCase);
}
<div class="site-controls @(ViewData["Floating"] is true ? "site-controls-floating" : "")">
    @if (!inAdmin)
    {
    <details class="lang-switch">
        <summary aria-label="@T["Language"]" title="@T["Language"]">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.6 2.7 3.9 5.7 3.9 9s-1.3 6.3-3.9 9c-2.6-2.7-3.9-5.7-3.9-9S9.4 5.7 12 3z" /></svg>
            @current.ToUpperInvariant()
        </summary>
        <ul class="lang-menu">
            @foreach (var (code, name) in languages)
            {
                <li><a class="@(code == current ? "is-active" : "")" href="@Url.Action("Set", "Language", new { area = "", lang = code, returnUrl = back })" hreflang="@code">@name <span>@code.ToUpperInvariant()</span></a></li>
            }
        </ul>
    </details>
    }
    <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" data-label-dark="@T["Dark theme"]" data-label-light="@T["Light theme"]" title="@T["Dark theme"]">
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
        <span class="sr-only">@T["Switch theme"]</span>
    </button>
</div>
