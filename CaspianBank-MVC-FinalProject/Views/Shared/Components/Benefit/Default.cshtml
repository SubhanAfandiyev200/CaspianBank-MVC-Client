@model BenefitVM

<section class="benefits" aria-labelledby="benefits-title">
    <div class="section-intro split benefits-head">
        <div>
            <p class="eyebrow"><span aria-hidden="true">✱ </span><span>@Model.BenefitSection.Label</span></p>
            <h2 id="benefits-title">@Model.BenefitSection.Title</h2>
        </div>
        <p class="lede">@Model.BenefitSection.Description</p>
        <div class="benefit-arrows">
            <button type="button" id="benefit-prev" aria-label="Previous">←</button>
            <button type="button" id="benefit-next" aria-label="Next">→</button>
        </div>
    </div>
    <div class="benefit-viewport" id="benefit-viewport">
        <div class="benefit-track" id="benefit-track">
            @foreach (var item in Model.BenefitItems)
            {
                <article class="benefit-card">
                    <p class="eyebrow">@item.Label</p>
                    <h3>@item.Title</h3>
                    <p>@item.Description</p>
                    <ul>
                        <li>@item.Text1</li>
                        <li>@item.Text2</li>
                        <li>@item.Text3</li>
                    </ul>
                    <a class="btn btn-lime btn-go" href="@NavLinks.FromDb(item.ButtonUrl, User.Identity?.IsAuthenticated == true)"><span class="btn-go-label">@item.ButtonText</span></a>
                </article>
            }
        </div>
    </div>
    <div class="drag-hint" id="drag-hint" aria-hidden="true">Drag</div>
</section>
