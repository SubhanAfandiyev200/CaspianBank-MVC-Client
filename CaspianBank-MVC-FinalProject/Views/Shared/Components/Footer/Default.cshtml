@model SiteSettingsVM
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isStaff = signedIn && AppRoles.IsStaff(User);
}
    <footer class="site-footer" id="contact">
        <div class="footer-hero">
            <div>
                <h2>@Model.FooterTitle</h2>
                <p>@Model.FooterDescription</p>
            </div>
            <div class="cta-actions">
                <a class="btn btn-lime btn-go" href="@NavLinks.OpenAccount(signedIn)">
                    <span class="btn-go-label">Get started</span><span class="btn-go-arrow" aria-hidden="true">→</span>
                </a>
                <a class="btn btn-ghost btn-go" href="@NavLinks.SupportLink(signedIn)">
                    <span class="btn-go-label">Contact the desk</span><span class="btn-go-arrow" aria-hidden="true">→</span>
                </a>
            </div>
        </div>
        <div class="footer-grid">
            <div class="footer-brand">
                <a class="logo" asp-controller="Home" asp-action="Index">
                    @if (!string.IsNullOrEmpty(Model.Logo))
                    {
                        <img src="@Model.Logo" width="42" height="42" alt="" />
                    }
                    else
                    {
                        <svg viewBox="0 0 32 32" width="42" height="42" aria-hidden="true">
                            <rect width="32" height="32" rx="8" fill="#C5D86D" />
                            <path d="M22 11.2a7.2 7.2 0 1 0 0 9.6" fill="none" stroke="#0F5C3F" stroke-width="2.4"
                                  stroke-linecap="round" />
                        </svg>
                    }
                    <span>@Model.CompanyName</span>
                </a>
                <p>Personal and business banking from one desk at @Model.Address.</p>
                @if (!signedIn)
                {
                    @* Email yazıb davam et: email sistemdə varsa Login, yenidirsə qeydiyyat (Account/Start) *@
                    <form class="footer-form" asp-controller="Account" asp-action="Start" method="post">
                        <label class="sr-only" for="footer-email">Your email</label>
                        <input id="footer-email" name="Email" type="email" autocomplete="email" placeholder="Enter your email to get started" required />
                        <button class="foot-go" type="submit" aria-label="Continue">
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8"
                                      stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </button>
                    </form>
                }
            </div>
            <div class="footer-links">
                <div class="footer-col">
                    <p class="footer-label">Main</p>
                    <a href="#top">Home</a>
                    <a href="#about">About Us</a>
                    <a href="#services">Services</a>
                    <a href="@NavLinks.SupportLink(signedIn)">Contact</a>
                    <a href="@(signedIn ? NavLinks.Support : NavLinks.Register)">@(signedIn ? "Support" : "Get Started")</a>
                </div>
                <div class="footer-col">
                    <p class="footer-label">Account</p>
                    <a href="@NavLinks.Page(signedIn, NavLinks.AppHome(isStaff))">@(signedIn ? (isStaff ? "Admin panel" : "My cards") : "Log in")</a>
                    <a href="@NavLinks.OpenAccount(signedIn)">@(signedIn ? "Add a card" : "Open an account")</a>
                    <a href="@NavLinks.Page(signedIn, NavLinks.Transfer)">Transfers</a>
                    <a href="@NavLinks.Page(signedIn, NavLinks.Loan)">Loans</a>
                </div>
                <div class="footer-col">
                    <p class="footer-label">Contact</p>
                    <a href="@NavLinks.SupportLink(signedIn)">
                        <svg class="foot-ico" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" fill="none" stroke="currentColor"
                                  stroke-width="1.6" />
                            <circle cx="12" cy="10" r="2.2" fill="none" stroke="currentColor" stroke-width="1.6" />
                        </svg>@Model.Address
                    </a>
                    <a href="mailto:@Model.Email">
                        <svg class="foot-ico" viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
                            <path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.6" />
                        </svg>@Model.Email
                    </a>
                    <a href="tel:@Model.PhoneHref">
                        <svg class="foot-ico" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M8 4h3l1.5 4-2 1.2a12 12 0 0 0 5.3 5.3L17 12.5 21 14v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4 6.2 2 2 0 0 1 6 4h2z"
                                  fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                        </svg>@Model.PhoneNumber
                    </a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© @DateTime.Now.Year @Model.CompanyName.</p>
            <div class="footer-social" aria-label="Social media">
                @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                {
                    <a href="@Model.InstagramUrl" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" /></svg>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                {
                    <a href="@Model.FacebookUrl" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8.5h2.5V5H14a3.5 3.5 0 0 0-3.5 3.5V11H8v3.5h2.5V21H14v-6.5h2.4l.6-3.5H14V8.8c0-.2.1-.3.3-.3z" /></svg>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.TwitterUrl))
                {
                    <a href="@Model.TwitterUrl" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l16 16M20 4 4 20" /></svg>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                {
                    <a href="@Model.LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="3" /><path d="M8 10.5V16M8 7.8v.1M11.5 16v-3a2 2 0 0 1 4 0v3M11.5 10.5V16" /></svg>
                    </a>
                }
            </div>
        </div>
    </footer>
