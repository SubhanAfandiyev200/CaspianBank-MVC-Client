@model ServiceVM

<section class="services" id="services">
    <div class="section-intro split">
        <div>
            <p class="eyebrow"><span aria-hidden="true">✱ </span><span>@Model.ServiceSection.Label</span></p>
            <h2>@Model.ServiceSection.Title</h2>
        </div>
        <p class="lede">@Model.ServiceSection.Description</p>
    </div>
    <div class="service-grid">
        @foreach (var item in Model.ServiceItems)
        {
            <a class="service-card" href="@NavLinks.ForService(item.Number, User.Identity?.IsAuthenticated == true)">
                <span class="service-no" aria-hidden="true">@item.Number.ToString("00")</span>
                <span class="service-icon" aria-hidden="true">
                    @if (!string.IsNullOrEmpty(item.IconSvg))
                    {
                        @* Başlanğıc .svg ikonlar: rəngi mətnin rəngindən alsın deyə səhifəyə yerləşdirilir *@
                        @Html.Raw(item.IconSvg)
                    }
                    else if (!string.IsNullOrEmpty(item.Icon))
                    {
                        @* Adminin yüklədiyi şəkil ikon (PNG, JPEG, WebP) *@
                        <img src="@item.Icon" alt="" />
                    }
                </span>
                <h3>@item.Title</h3>
                <p>@item.Description</p>
            </a>
        }
    </div>
</section>
