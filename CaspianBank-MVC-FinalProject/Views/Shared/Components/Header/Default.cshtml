@model SiteSettingsVM
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isStaff = signedIn && AppRoles.IsStaff(User);
}
    <header class="site-header" id="top">
        <div class="header-bar">
            <a class="logo" asp-controller="Home" asp-action="Index">
                @if (!string.IsNullOrEmpty(Model.Logo))
                {
                    <img src="@Model.Logo" width="32" height="32" alt="" />
                }
                else
                {
                    @* Settings-də Logo yoxdursa köhnə SVG loqo *@
                    <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
                        <rect width="32" height="32" rx="8" fill="#C5D86D" />
                        <path d="M22 11.2a7.2 7.2 0 1 0 0 9.6" fill="none" stroke="#0F5C3F" stroke-width="2.4"
                              stroke-linecap="round" />
                    </svg>
                }
                <span>@Model.CompanyName</span>
            </a>
            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">@T["Menu"]</button>
            <nav class="site-nav" id="site-nav" aria-label="@T["Primary"]">
                <div class="nav-home">
                    <a href="#top" aria-haspopup="true">@T["Home"] <span aria-hidden="true">▾</span></a>
                </div>
                <a href="#about">@T["About Us"]</a>
                <a href="#services">@T["Services"]</a>
                <a href="@NavLinks.SupportLink(signedIn)">@T["Contact Us"]</a>
            </nav>
            <div class="header-right">
            <partial name="_SiteControls" />
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form class="header-auth" asp-controller="Account" asp-action="Logout" method="post">
                    @* Şəkil və ad: müştəriyə profil səhifəsini, işçiyə admin panelini açır *@
                    <a class="header-user" href="@NavLinks.UserLink(isStaff)" title="@(isStaff ? "Admin panel" : "My profile")">
                        <span class="header-user-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18">
                                <circle cx="12" cy="8.2" r="3.4" fill="none" stroke="currentColor" stroke-width="1.7" />
                                <path d="M5.4 19.2c.9-3.5 3.4-5.2 6.6-5.2s5.7 1.7 6.6 5.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                            </svg>
                            @if (!isStaff)
                            {
                                <img class="header-user-photo" src="@Url.Action("Avatar", "Profile")" alt="" onerror="this.remove()" />
                            }
                        </span>
                        <span class="header-user-name">@T.Person(User.Identity.Name)</span>
                    </a>
                    <button class="btn-logout" type="submit" data-confirm-title="@T["Log out?"]" data-confirm-text="@T["You will need to log in again to open your account."]" data-confirm-yes="@T["Log out"]">
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                            <path d="M10 7V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                            <path d="M4 12h11M12 8.5 15.5 12 12 15.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span class="btn-logout-label">@T["Log out"]</span>
                    </button>
                </form>
            }
            else
            {
                <a class="btn btn-lime btn-go" href="@NavLinks.OpenAccount(signedIn)"><span class="btn-go-label">@T["Open account"]</span></a>
            }
            </div>
        </div>
        <div class="mega" id="mega">
            <div class="mega-inner">
                @if (signedIn)
                {
                    <a class="mega-card" href="@NavLinks.AppHome(isStaff)">
                        <span class="mega-swatch mega-swatch-a" aria-hidden="true"><partial name="_MegaArt" model='"account"' /></span>
                        <strong>@(isStaff ? T["Go to admin panel"] : T["Go to my app"])</strong>
                        <span>@(isStaff ? T["Manage the bank from the admin panel."] : T["Your cards, transfers and history in one place."])</span>
                    </a>
                }
                else
                {
                    <a class="mega-card" href="@NavLinks.Register">
                        <span class="mega-swatch mega-swatch-a" aria-hidden="true"><partial name="_MegaArt" model='"account"' /></span>
                        <strong>@T["Open an account"]</strong>
                        <span>@T["Current accounts for personal and salary clients."]</span>
                    </a>
                }
                <a class="mega-card" href="@NavLinks.Page(signedIn, NavLinks.App)">
                    <span class="mega-swatch mega-swatch-b" aria-hidden="true"><partial name="_MegaArt" model='"cards"' /></span>
                    <strong>@T["Cards"]</strong>
                    <span>@T["Debit and cashback cards, issued in AZN."]</span>
                </a>
                <a class="mega-card" href="@NavLinks.Page(signedIn, NavLinks.Transfer)">
                    <span class="mega-swatch mega-swatch-c" aria-hidden="true"><partial name="_MegaArt" model='"payments"' /></span>
                    <strong>@T["Payments"]</strong>
                    <span>@T["Transfers between cards and utility bills."]</span>
                </a>
                <a class="mega-card" href="@NavLinks.Page(signedIn, NavLinks.Loan)">
                    <span class="mega-swatch mega-swatch-d" aria-hidden="true"><partial name="_MegaArt" model='"credit"' /></span>
                    <strong>@T["Credit"]</strong>
                    <span>@T["Personal loans, reviewed by the bank."]</span>
                </a>
            </div>
        </div>
    </header>
