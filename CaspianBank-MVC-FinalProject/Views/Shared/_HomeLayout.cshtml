<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0F5C3F" />
    <title>Caspian Bank</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" />
</head>

<body>
    @{
        var headerUser = ViewBag.UserDisplayName as string;
        if (string.IsNullOrWhiteSpace(headerUser))
            headerUser = Context.Request.Query["session"].ToString();
        if (string.IsNullOrWhiteSpace(headerUser))
            Context.Request.Cookies.TryGetValue("caspian.displayName", out headerUser);
        var signedIn = !string.IsNullOrWhiteSpace(headerUser);
    }
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header" id="top">
        <div class="header-bar">
            <a class="logo" href="home.html">
                <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
                    <rect width="32" height="32" rx="8" fill="#C5D86D" />
                    <path d="M22 11.2a7.2 7.2 0 1 0 0 9.6" fill="none" stroke="#0F5C3F" stroke-width="2.4"
                          stroke-linecap="round" />
                </svg>
                <span>Caspian Bank</span>
            </a>
            <nav class="site-nav" id="site-nav" aria-label="Primary">
                <div class="nav-home">
                    <a href="#top" aria-haspopup="true">Home <span aria-hidden="true">▾</span></a>
                </div>
                <a href="#about">About Us</a>
                <a href="#services">Services</a>
                <a href="#contact">Contact Us</a>
                @if (signedIn)
                {
                    <span class="header-user">
                        <span class="header-user-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="3.2" />
                                <path d="M5.5 19c1.4-3.2 3.6-4.6 6.5-4.6S16.6 15.8 18 19" />
                            </svg>
                        </span>
                        <span class="header-user-name">@headerUser</span>
                    </span>
                }
            </nav>
            <div class="header-actions">
                @if (signedIn)
                {
                    <form class="header-logout-form" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button class="header-logout" type="submit">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M9 6H6.8A1.8 1.8 0 0 0 5 7.8v8.4A1.8 1.8 0 0 0 6.8 18H9" />
                                <path d="M10 12h9" />
                                <path d="M16 8.5 19.5 12 16 15.5" />
                            </svg>
                            <span>Log out</span>
                        </button>
                    </form>
                }
                else
                {
                    <a class="btn btn-lime btn-go" href="app.html"><span class="btn-go-label">Open account</span></a>
                }
                <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
            </div>
        </div>
        <div class="mega" id="mega">
            <div class="mega-inner">
                <a class="mega-card" href="app.html">
                    <span class="mega-swatch mega-swatch-a" aria-hidden="true"></span>
                    <strong>Open an account</strong>
                    <span>Current accounts for personal and salary clients.</span>
                </a>
                <a class="mega-card" href="#services">
                    <span class="mega-swatch mega-swatch-b" aria-hidden="true"></span>
                    <strong>Cards</strong>
                    <span>Debit and cashback cards, issued in AZN.</span>
                </a>
                <a class="mega-card" href="#services">
                    <span class="mega-swatch mega-swatch-c" aria-hidden="true"></span>
                    <strong>Payments</strong>
                    <span>Transfers between cards and utility bills.</span>
                </a>
                <a class="mega-card" href="#services">
                    <span class="mega-swatch mega-swatch-d" aria-hidden="true"></span>
                    <strong>Credit</strong>
                    <span>Personal loans, reviewed by the bank.</span>
                </a>
            </div>
        </div>
    </header>
        @RenderBody()
    <footer class="site-footer" id="contact">
        <div class="footer-hero">
            <div>
                <h2 data-ui="footerTitle">Ready to open your Caspian account?</h2>
                <p data-ui="footerLede">
                    Cards, transfers, and a loan request from the same login. The desk in Baku stays on the
                    account from the first day.
                </p>
            </div>
            <div class="cta-actions">
                <a class="btn btn-lime btn-go" href="app.html">
                    <span class="btn-go-label">Get started</span><span class="btn-go-arrow" aria-hidden="true">→</span>
                </a>
                <a class="btn btn-ghost btn-go" href="contact-us.html">
                    <span class="btn-go-label">Contact the desk</span><span class="btn-go-arrow" aria-hidden="true">→</span>
                </a>
            </div>
        </div>
        <div class="footer-grid">
            <div class="footer-brand">
                <a class="logo" href="home.html">
                    <svg viewBox="0 0 32 32" width="42" height="42" aria-hidden="true">
                        <rect width="32" height="32" rx="8" fill="#C5D86D" />
                        <path d="M22 11.2a7.2 7.2 0 1 0 0 9.6" fill="none" stroke="#0F5C3F" stroke-width="2.4"
                              stroke-linecap="round" />
                    </svg>
                    <span>Caspian Bank</span>
                </a>
                <p>Personal and business banking from one desk at 28 Nizami Street, Baku.</p>
                <form class="footer-form" id="footer-form">
                    <label class="sr-only" for="footer-email">Email for product notes</label>
                    <!-- TODO: POST this address to the mailing list API -->
                    <input id="footer-email" type="email" autocomplete="email" placeholder="Enter your email" required />
                    <button class="foot-go" type="submit" aria-label="Subscribe">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8"
                                  stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                </form>
            </div>
            <div class="footer-links">
                <div class="footer-col">
                    <p class="footer-label">Main</p>
                    <a href="#top">Home</a>
                    <a href="#about">About Us</a>
                    <a href="#services">Services</a>
                    <a href="#contact">Contact</a>
                    <a href="app.html">Get Started</a>
                </div>
                <div class="footer-col">
                    <p class="footer-label">Links</p>
                    <a href="app.html">Log in</a>
                    <a href="app.html">Open an account</a>
                    <a href="contact-us.html">Existing clients</a>
                    <a href="#services">Cards and loans</a>
                </div>
                <div class="footer-col">
                    <p class="footer-label">Contact</p>
                    <a href="contact-us.html">
                        <svg class="foot-ico" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" fill="none" stroke="currentColor"
                                  stroke-width="1.6" />
                            <circle cx="12" cy="10" r="2.2" fill="none" stroke="currentColor" stroke-width="1.6" />
                        </svg>28 Nizami Street, Baku
                    </a>
                    <a href="mailto:support@caspianbank.az">
                        <svg class="foot-ico" viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
                            <path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.6" />
                        </svg>support@caspianbank.az
                    </a>
                    <a href="tel:+994123100000">
                        <svg class="foot-ico" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M8 4h3l1.5 4-2 1.2a12 12 0 0 0 5.3 5.3L17 12.5 21 14v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4 6.2 2 2 0 0 1 6 4h2z"
                                  fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                        </svg>+994 12 310 00 00
                    </a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 Caspian Bank.</p>
            <div class="footer-social">
                <a href="contact-us.html" aria-label="Pinterest">p</a>
                <a href="contact-us.html" aria-label="Vimeo">v</a>
                <a href="contact-us.html" aria-label="X">x</a>
                <a href="contact-us.html" aria-label="Facebook">f</a>
            </div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/Draggable.min.js"></script>
    <script src="~/js/home.js"></script>
</body>
