@model BillReceiptUIVM
@using System.Globalization
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Payment received";
    var inv = CultureInfo.InvariantCulture;
    var local = Model.PaidAt.ToLocalTime();
    var mobile = Model.Category == "Mobile";
    var loan = Model.Category == "Loan";

    string Money(decimal value) { return value.ToString("N2", inv) + " AZN"; }

    var identifierLabel = mobile ? "Phone number" : (loan ? "Loan code" : "Subscriber code");
    var shareText = "Caspian Bank payment " + Model.Reference + ": " + Money(Model.Amount) + " to " + Model.ProviderName
        + " (" + Model.Identifier + ") on " + local.ToString("dd MMM yyyy, HH:mm", inv);
}
<main id="content" class="page pay-page">
    <section class="rc" aria-labelledby="rc-title">
        <div class="rc-top">
            <span class="rc-check" aria-hidden="true">
                <svg viewBox="0 0 52 52" width="56" height="56" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><circle class="rc-ring" cx="26" cy="26" r="22" /><path class="rc-tick" d="m16 27 7 7 14-16" /></svg>
            </span>
            <h1 id="rc-title">Payment received</h1>
            <strong class="rc-amount num">@Model.Amount.ToString("N2", inv)<small>AZN</small></strong>
            <span class="rc-date">@local.ToString("dd MMM yyyy, HH:mm", inv)</span>
        </div>

        <div class="rc-tear" aria-hidden="true"></div>

        <dl class="rc-list">
            <div><dt>Status</dt><dd><span class="badge-pill is-ok">Completed</span></dd></div>
            <div>
                <dt>Provider</dt>
                <dd>
                    <span class="bill-provider-cell is-end">
                        @if (!string.IsNullOrEmpty(Model.LogoUrl))
                        {
                            <img class="provider-logo is-small" src="@Model.LogoUrl" alt="" width="24" height="24" />
                        }
                        @Model.ProviderName
                    </span>
                </dd>
            </div>
            <div><dt>@identifierLabel</dt><dd class="num">@Model.Identifier</dd></div>
            @if (!string.IsNullOrEmpty(Model.SubscriberName))
            {
                <div><dt>@(loan ? "Loan owner" : (mobile ? "Number owner" : "Subscriber"))</dt><dd>@Model.SubscriberName</dd></div>
            }
            <div><dt>Paid from</dt><dd>@Model.CardLabel</dd></div>
            @if (loan)
            {
                <div><dt>Principal</dt><dd class="num">@Money(Model.Principal ?? 0m)</dd></div>
                <div><dt>Interest</dt><dd class="num">@Money(Model.Interest ?? 0m)</dd></div>
                @if ((Model.Penalty ?? 0m) > 0)
                {
                    <div><dt>Penalty</dt><dd class="num">@Money(Model.Penalty ?? 0m)</dd></div>
                }
            }
            else
            {
                @if (Model.DebtCleared > 0)
                {
                    <div><dt>Debt paid</dt><dd class="num">@Money(Model.DebtCleared)</dd></div>
                }
                @if (Model.CreditAdded > 0)
                {
                    <div><dt>@(mobile ? "Added to the number" : "Added to the balance")</dt><dd class="num">@Money(Model.CreditAdded)</dd></div>
                }
                @if (Model.RemainingDebt > 0)
                {
                    <div><dt>Debt left</dt><dd class="num">@Money(Model.RemainingDebt)</dd></div>
                }
                else if (Model.BalanceAfter > 0)
                {
                    <div><dt>@(mobile ? "Number balance now" : "Balance now")</dt><dd class="num">@Money(Model.BalanceAfter)</dd></div>
                }
            }
            @if (Model.CashbackEarned > 0)
            {
                <div><dt>Cashback earned</dt><dd class="num">+@Money(Model.CashbackEarned)</dd></div>
            }
            <div class="rc-total"><dt>Total paid</dt><dd class="num">@Money(Model.Amount)</dd></div>
            <div><dt>Card balance after</dt><dd class="num">@Money(Model.CardBalanceAfter)</dd></div>
            <div>
                <dt>Reference</dt>
                <dd class="num">@Model.Reference <button type="button" class="btn-copy no-print" data-copy="@Model.Reference" data-copy-label="Reference">Copy</button></dd>
            </div>
        </dl>

        @if (!string.IsNullOrEmpty(Model.RecurringNote))
        {
            <p class="@(Model.RecurringFailed ? "flash flash-error" : "flash flash-ok") no-print" role="status">@Model.RecurringNote</p>
        }

        <div class="rc-zigzag" aria-hidden="true"></div>

        <p class="rc-foot">Caspian Bank · 28 Nizami Street, Baku<br />Keep this receipt for your records.</p>
    </section>

    <div class="rc-actions no-print">
        <button type="button" class="btn btn-secondary" id="rc-print">Save as PDF</button>
        <button type="button" class="btn btn-secondary" id="rc-share" data-share="@shareText">Share</button>
        <a class="btn btn-primary" asp-controller="Bills" asp-action="Index">Back to payments</a>
    </div>
</main>
