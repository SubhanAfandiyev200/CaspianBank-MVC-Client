@*
    Ödənişlər: dizayn CaspianBank-Frontend/bill-payment.html-dir.
    Axtarış və qutuların açılıb-bağlanması wwwroot/js/bills.js-dədir (nəticə JSON ilə gəlir), həqiqi yoxlama və ödəniş qaydaları API-dədir.
    Təkrarlanan aylıq ödənişlər (ayın 1-i) API-nin arxa plan işi ilə edilir; burada yalnız yaradılır, dayandırılır və silinir.
*@
@model BillsPageVM
@using System.Globalization
@using System.Text.Json
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Bill payments";
    var inv = CultureInfo.InvariantCulture;
    var form = Model.Form;
    var cards = Model.Cards.Where(c => !c.IsBlocked).ToList();
    var overview = Model.Overview;

    // Aktiv aylıq ödənişlər: sayı və hər ay çıxacaq məbləğ (kredit ödənişi hər ay özü hesablanır, cəmə düşmür)
    var activeRecurring = Model.Recurring.Where(r => r.IsActive).ToList();
    var recurringTotal = activeRecurring.Sum(r => r.Amount);

    string Money(decimal value) { return value.ToString("N2", inv) + " AZN"; }

    // Seçilmiş təchizatçı: xətadan sonra əvvəlki, ilk açılışda siyahının ilki
    var selected = Model.Providers.FirstOrDefault(p => p.Id == form.ProviderId) ?? Model.Providers.FirstOrDefault();

    var groups = new List<(string Title, string[] Categories)>
    {
        ("Mobile", new[] { "Mobile" }),
        ("Utilities", new[] { "Electricity", "Gas", "Water" }),
        ("Internet", new[] { "Internet" }),
        ("Loan", new[] { "Loan" })
    };

    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var initial = Model.Lookup is null ? string.Empty : JsonSerializer.Serialize(Model.Lookup, jsonOptions);
}
<main id="content" class="page page-activity">
    <header class="page-head">
        <p class="eyebrow">@T["Payments"]</p>
        <h1>@T["Bill payments"]</h1>
        <p class="lede">@T["Top up a phone, pay for electricity, gas, water or internet, or pay a Caspian loan with its code."]</p>
    </header>

    <partial name="_Flash" />
    @if (TempData["BillError"] is string billError)
    {
        <p class="flash flash-error" role="alert">@T[billError]</p>
    }

    @if (Model.ApiUnavailable)
    {
        <div class="empty">
            <h3>@T["We can't load the payments"]</h3>
            <p>@T["The service is unavailable right now. Please try again in a moment."]</p>
            <a class="btn btn-secondary" asp-action="Index">@T["Try again"]</a>
        </div>
    }
    else
    {
        <div class="pulse-row">
            <article class="pulse"><span>@T["Paid this month"]</span><strong>@Money(overview.PaidThisMonth)</strong></article>
            <article class="pulse"><span>@T["Cashback this month"]</span><strong>@Money(overview.CashbackThisMonth)</strong></article>
            <article class="pulse">
                <span>@T["Every month"]</span>
                <strong>@Money(recurringTotal)</strong>
                <small class="hint">@(activeRecurring.Count == 1 ? T["1 monthly payment"] : T["{0} monthly payments", activeRecurring.Count])</small>
            </article>
        </div>

        <div class="layout-2">
            <form asp-action="Pay" method="post" id="bill-form" class="surface form-stack form-card" novalidate
                  data-lookup-url="@Url.Action("Lookup")" data-initial="@initial">
                <h2>@T["Pay a bill"]</h2>

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <p class="flash flash-error" role="alert">@T[Model.Error]</p>
                }

                <input type="hidden" name="ProviderId" id="bill-provider" value="@(selected?.Id ?? 0)" />
                <input type="hidden" name="RequestId" value="@form.RequestId" />

                <div class="field">
                    <label id="provider-label">@T["Provider"]</label>
                    <div role="group" aria-labelledby="provider-label">
                        @foreach (var group in groups)
                        {
                            var inGroup = Model.Providers.Where(p => group.Categories.Contains(p.Category)).ToList();
                            if (inGroup.Count == 0)
                            {
                                continue;
                            }
                            <div class="bill-group">
                                <p class="bill-group-title">@T[group.Title]</p>
                                <div class="provider-grid bill-grid">
                                    @foreach (var p in inGroup)
                                    {
                                        <button type="button" class="@(selected is not null && p.Id == selected.Id ? "is-active" : "")"
                                                data-provider="@p.Id" data-category="@p.Category" data-name="@T[p.Name]"
                                                data-label="@T[p.IdentifierLabel]" data-hint="@p.IdentifierHint" data-prefixes="@p.PrefixesText"
                                                data-min="@p.MinPayment.ToString(inv)" data-max="@p.MaxPayment.ToString(inv)"
                                                aria-pressed="@(selected is not null && p.Id == selected.Id ? "true" : "false")">
                                            @if (!string.IsNullOrEmpty(p.LogoUrl))
                                            {
                                                <img class="provider-logo" src="@p.LogoUrl" alt="" width="32" height="32" loading="lazy" />
                                            }
                                            else
                                            {
                                                <span class="provider-mark">@T["KR"]</span>
                                            }
                                            <span>@T[p.Name]</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="field">
                    <label for="bill-identifier" id="bill-identifier-label">@(selected?.IdentifierLabel ?? T["Number"])</label>
                    <div class="bill-lookup-row">
                        <input class="input" id="bill-identifier" name="Identifier" maxlength="24" autocomplete="off"
                               value="@form.Identifier" placeholder="@selected?.IdentifierHint" />
                        <button type="button" class="btn btn-secondary" id="bill-check">@T["Check"]</button>
                    </div>
                    <p class="hint" id="bill-identifier-hint"></p>
                    <p class="field-error" id="bill-lookup-error" role="alert" hidden></p>
                </div>

                <div id="bill-found" class="bill-found" hidden aria-live="polite"></div>

                <div id="bill-pay-step" class="form-stack" hidden>
                    <div class="field" id="bill-amount-field">
                        <label for="bill-amount">@T["Amount"]</label>
                        <div class="amount-box">
                            <input class="amount-input" id="bill-amount" name="Amount" inputmode="decimal" placeholder="0.00" maxlength="9" autocomplete="off" value="@form.Amount" />
                            <span class="amount-cur">@T["AZN"]</span>
                        </div>
                        <div class="chips chips-tight" id="bill-chips"></div>
                        <p class="hint" id="bill-amount-hint"></p>
                    </div>

                    <div class="field">
                        <label for="bill-card">@T["Pay from"]</label>
                        @if (cards.Count == 0)
                        {
                            <p class="hint">@T["You have no active card. Add a card before paying a bill."]</p>
                        }
                        else
                        {
                            <select class="select" id="bill-card" name="CardId" data-card-pick>
                                @foreach (var card in cards)
                                {
                                    <option value="@card.Id" selected="@(card.Id == form.CardId)"
                                            data-tier="@card.Tier" data-last4="@card.Last4" data-money="@Money(card.Balance)"
                                            data-design="@card.DesignImage">@card.Tier · •••• @card.Last4 · @Money(card.Balance)</option>
                                }
                            </select>
                            <p class="hint" id="bill-cashback-note" hidden>@T["Paying with the Cashback card earns no cashback."]</p>
                        }
                    </div>

                    <label class="check">
                        <input type="checkbox" name="Recurring" id="bill-recurring" value="true" checked="@form.Recurring" />
                        <span id="bill-recurring-text">@T["Make this a monthly payment. It runs on the 1st, from the card you selected."]</span>
                    </label>

                    <button type="submit" class="btn btn-primary btn-lg" id="bill-submit" data-once
                            data-confirm-title="@T["Confirm payment"]" data-confirm-text="" data-confirm-yes="@T["Pay"]"
                            disabled="@(cards.Count == 0)">@T["Pay"]</button>
                </div>
            </form>

            <div class="stack-lg">
            <section class="surface surface-tight form-card">
                <div class="toolbar"><h2>@T["Monthly payments"]</h2></div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@T["Provider"]</th>
                                <th class="num">@T["Amount"]</th>
                                <th>@T["Status"]</th>
                                <th class="actions"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Recurring.Count == 0)
                            {
                                <tr class="empty-row">
                                    <td colspan="4">
                                        <div class="empty">
                                            <h3>@T["No monthly payments"]</h3>
                                            <p>@T["Tick the box when you pay a bill, a phone or a loan to repeat it every month."]</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @foreach (var item in Model.Recurring)
                            {
                                var isLoanRow = item.Category == "Loan";
                                <tr>
                                    <td>
                                        <span class="bill-provider-cell">
                                            @if (!string.IsNullOrEmpty(item.LogoUrl))
                                            {
                                                <img class="provider-logo is-small" src="@item.LogoUrl" alt="" width="24" height="24" loading="lazy" />
                                            }
                                            else
                                            {
                                                <span class="provider-mark is-small">@T["KR"]</span>
                                            }
                                            <span>@item.ProviderName<small class="hint num">@item.Identifier</small></span>
                                        </span>
                                    </td>
                                    <td class="num">
                                        @(isLoanRow ? T["Monthly payment"] : Money(item.Amount))
                                        <small class="hint">@T["from {0}", item.CardLabel]</small>
                                    </td>
                                    <td>
                                        @if (item.Status == "Paused")
                                        {
                                            <span class="badge badge-neutral">@T["Paused"]</span>
                                        }
                                        else if (item.Status == "Failed")
                                        {
                                            <span class="badge badge-danger">@T["Failed"]</span>
                                            <small class="hint">@T[item.LastError] @T["We will try again tomorrow."]</small>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">@T["Active"]</span>
                                            <small class="hint">@T["Next: {0}", item.NextRunDate.ToString("d MMM", inv)]</small>
                                        }
                                    </td>
                                    <td class="actions">
                                        <span class="row-actions">
                                            @if (item.IsActive)
                                            {
                                                <form method="post" asp-action="PauseRecurring" asp-route-id="@item.Id">
                                                    <button type="submit" class="btn btn-secondary btn-sm">@T["Pause"]</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post" asp-action="ResumeRecurring" asp-route-id="@item.Id">
                                                    <button type="submit" class="btn btn-secondary btn-sm">@T["Resume"]</button>
                                                </form>
                                            }
                                            <form method="post" asp-action="DeleteRecurring" asp-route-id="@item.Id">
                                                <button type="submit" class="btn btn-danger btn-sm"
                                                        data-confirm-title="@T["Remove this monthly payment?"]"
                                                        data-confirm-text="@T["It will not be taken from your card again. Payments already made stay in your history."]"
                                                        data-confirm-yes="@T["Remove"]" data-confirm-danger="true">@T["Remove"]</button>
                                            </form>
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="surface surface-tight form-card">
                <div class="toolbar"><h2>@T["Recent payments"]</h2></div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@T["Provider"]</th>
                                <th>@T["Number"]</th>
                                <th class="num">@T["Amount"]</th>
                                <th>@T["When"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (overview.RecentPayments.Count == 0)
                            {
                                <tr class="empty-row">
                                    <td colspan="4">
                                        <div class="empty">
                                            <h3>@T["No payments yet"]</h3>
                                            <p>@T["Your latest bill payments will show up here."]</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @foreach (var payment in overview.RecentPayments)
                            {
                                <tr>
                                    <td>
                                        <span class="bill-provider-cell">
                                            @if (!string.IsNullOrEmpty(payment.LogoUrl))
                                            {
                                                <img class="provider-logo is-small" src="@payment.LogoUrl" alt="" width="24" height="24" loading="lazy" />
                                            }
                                            @payment.ProviderName
                                        </span>
                                    </td>
                                    <td class="num">@payment.Identifier</td>
                                    <td class="num">
                                        @Money(payment.Amount)
                                        @if (payment.CashbackEarned > 0)
                                        {
                                            <small class="hint">+@Money(payment.CashbackEarned) @T["cashback"]</small>
                                        }
                                    </td>
                                    <td>@payment.PaidAt.ToLocalTime().ToString("dd MMM, HH:mm", inv)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            </div>
        </div>
    }
</main>

@section Scripts {
    <script src="~/js/bills.js" asp-append-version="true"></script>
}
