@model AddCardPageVM
@using System.Globalization
@{
    Layout = "_AppLayout";
    var inv = CultureInfo.InvariantCulture;

    string Money(decimal value) => value.ToString("N2", inv) + " AZN";
    string Percent(decimal value) => value.ToString("0.##", inv) + "%";

    // Kiçik kart nümunəsi (növ seçimi və ilk kartlar üçün)
    void Preview(string tier, string label, string design)
    {
        var style = string.IsNullOrEmpty(design)
            ? string.Empty
            : $"background-image:url('{design}');background-size:cover;background-position:center;";
        <div class="plastic plastic-mini plastic-@tier.ToLowerInvariant()" style="@style" aria-hidden="true">
            <span class="plastic-art" aria-hidden="true"></span>
            <span class="plastic-shine" aria-hidden="true"></span>
            <div class="plastic-top">
                <span class="plastic-brand"><span class="plastic-mark" aria-hidden="true"></span><span class="plastic-bank">Caspian</span></span>
                <span class="plastic-tier">@label</span>
                <svg class="plastic-wave" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M8 8.2c1.6 1.5 1.6 6.1 0 7.6" /><path d="M11.2 5.6c2.6 2.4 2.6 10.4 0 12.8" /><path d="M14.4 3.2c3.6 3.4 3.6 14.2 0 17.6" /></svg>
            </div>
            <div class="plastic-mid"><span class="plastic-chip" aria-hidden="true"></span></div>
            <p class="plastic-number">•••• ••••</p>
            <div class="plastic-bottom"><span class="plastic-issuer">Caspian Bank</span></div>
        </div>
    }
}
<main id="content" class="page">
    <a class="back" asp-action="Index">Back to cards</a>
    <header class="page-head">
        <p class="eyebrow">Cards</p>
        <h1>@(Model.FirstTime ? "Your first cards" : "Choose a tier")</h1>
        @if (Model.FirstTime)
        {
            <p class="lede">We'll open a Standard card for everyday spending and a Cashback card that returns a portion of eligible purchases. Both are free. Confirm your identity to continue.</p>
        }
        else if (!Model.ApiUnavailable)
        {
            <p class="lede">The opening fee is charged to a card you already hold.</p>
        }
    </header>

    <partial name="_Flash" />

    @if (Model.ApiUnavailable)
    {
        <div class="empty">
            <h3>We can't load this page</h3>
            <p>The service is unavailable right now. Please try again in a moment.</p>
            <a class="btn btn-secondary" asp-action="AddCard">Try again</a>
        </div>
    }
    else if (Model.FirstTime)
    {
        <div class="starter-pair">
            @{ Preview("Standard", "Standard", Model.StandardDesign); }
            @{ Preview("Cashback", "Cashback", Model.CashbackDesign); }
        </div>
        <form asp-action="CreateFirstCards" method="post" class="surface form-stack narrow" novalidate>
            <div class="field">
                <label for="holder">Cardholder</label>
                <input class="input" id="holder" value="@Model.HolderName" readonly />
            </div>
            <div class="field">
                <label for="fin">FIN / ID code</label>
                <input class="input" id="fin" name="fin" maxlength="7" autocapitalize="characters" spellcheck="false"
                       autocomplete="off" placeholder="7 characters" required />
            </div>
            <button class="btn btn-primary" type="submit">Create my cards</button>
        </form>
    }
    else
    {
        <div class="tier-grid" id="tiers">
            @foreach (var tier in Model.Tiers)
            {
                <button type="button" class="tier" data-tier="@tier.Tier.ToLowerInvariant()" data-name="@tier.Tier" data-fee="@tier.IssueFee.ToString(inv)">
                    @{ Preview(tier.Tier, tier.Tier, tier.DesignImage); }
                    <h3>@tier.Tier</h3>
                    <p class="tier-fee">@Money(tier.IssueFee)<span>Opening fee</span></p>
                    <ul>
                        <li>Cashback @Percent(tier.CashbackPercent)</li>
                        <li>Transfer limit @Money(tier.TransferLimit) before commission</li>
                        <li>@Percent(tier.CommissionPercent) commission beyond that limit</li>
                    </ul>
                </button>
            }
        </div>

        <form asp-action="AddTierCard" method="post" id="tier-form" class="surface form-stack narrow mt-5" hidden novalidate>
            <input type="hidden" name="tier" id="tier-input" />
            <h2 id="tier-heading">Confirm</h2>
            <p class="lede" id="tier-copy"></p>
            <div class="field">
                <label for="fee-card">Pay from</label>
                @* data-card-pick: app-cards.js bunu kart şəkilli xüsusi seçimə çevirir (şəkil və mətn bazadan gəlir) *@
                <select class="select" id="fee-card" name="fundingCardId" data-card-pick>
                    @foreach (var card in Model.Cards.Where(c => !c.IsBlocked))
                    {
                        <option value="@card.Id"
                                data-balance="@card.Balance.ToString(inv)"
                                data-tier="@card.Tier"
                                data-last4="@card.Last4"
                                data-money="@Money(card.Balance)"
                                data-design="@card.DesignImage">@card.Tier · •••• @card.Last4 · @Money(card.Balance)</option>
                    }
                </select>
                <p class="field-error" id="fee-error" hidden>That card doesn't have enough balance for the opening fee.</p>
            </div>
            <button class="btn btn-primary" type="submit" id="tier-submit">Confirm and add card</button>
        </form>
    }
</main>

