@model CardPageVM
@using System.Globalization
@{
    Layout = "_AppLayout";
    var inv = CultureInfo.InvariantCulture;
    var card = Model.Card;
    var blockError = TempData["BlockError"] as string;
    var topUpError = TempData["TopUpError"] as string;
    var isCashback = card is not null && card.Tier.Equals("Cashback", StringComparison.OrdinalIgnoreCase);
    var canTopUp = card is not null && !card.IsBlocked && !isCashback;

    string Money(decimal value) { return value.ToString("N2", inv) + " AZN"; }
    string Percent(decimal value) { return value.ToString("0.##", inv) + "%"; }

}
<main id="content" class="page cd-page">
    <a class="back" asp-action="Index">All cards</a>

    @if (card is null)
    {
        <header class="page-head">
            <p class="eyebrow">Card detail</p>
            <h1>@(Model.Unavailable ? "We can't load this card" : "Card not found")</h1>
        </header>
        <div class="empty">
            <h3>@(Model.Unavailable ? "Service unavailable" : "Card not found")</h3>
            <p>@(Model.Unavailable ? "Please try again in a moment." : "This card isn't on your account.")</p>
            <a class="btn btn-secondary" asp-action="Index">Back to cards</a>
        </div>
    }
    else
    {
        <header class="page-head">
            <p class="eyebrow">Card detail</p>
            <h1>@card.Tier card <span class="cd-last4">•••• @card.Last4</span></h1>
        </header>

        <partial name="_Flash" />

        <div class="cd-grid">
            <section class="cd-visual" aria-label="Card">
                <partial name="_Plastic" model="card" view-data='new ViewDataDictionary(ViewData) { { "Large", true }, { "Link", false } }' />

                <div class="cd-actions">
                    @if (canTopUp)
                    {
                        <button class="btn btn-primary" type="button" data-open-modal="topup-modal">Top up</button>
                    }
                    @if (!card.IsBlocked)
                    {
                        <a class="btn btn-secondary" asp-controller="Transfer" asp-action="Index" asp-route-from="@card.Id">Transfer</a>
                        <button class="btn btn-danger" type="button" data-open-modal="block-modal">Block card</button>
                    }
                    else
                    {
                        <button class="btn btn-danger" type="button" disabled>Card is blocked</button>
                    }
                </div>
            </section>

            <section class="cd-side">
                <div class="cd-balance">
                    <span class="cd-label">Available balance</span>
                    <strong class="cd-amount num">@card.Balance.ToString("N2", inv)<small>AZN</small></strong>
                    <div class="cd-badges">
                        <span class="badge-pill @(card.IsBlocked ? "is-bad" : "is-ok")">@(card.IsBlocked ? "Blocked" : "Active")</span>
                        <span class="badge-pill">@card.Tier</span>
                    </div>
                </div>

                <div class="cd-panel">
                    <h3>Card details</h3>
                    <dl class="cd-list">
                        <div><dt>Cardholder</dt><dd>@card.HolderName</dd></div>
                        <div>
                            <dt>Card number</dt>
                            <dd class="num">
                                @string.Join(" ", Enumerable.Range(0, card.CardNumber.Length / 4).Select(i => card.CardNumber.Substring(i * 4, 4)))
                                <button type="button" class="btn-copy" data-copy="@card.CardNumber" data-copy-label="Card number">Copy</button>
                            </dd>
                        </div>
                        <div><dt>Expires</dt><dd>@card.Expiry</dd></div>
                    </dl>
                </div>

                <div class="cd-panel">
                    <h3>Limits and fees</h3>
                    @if (isCashback)
                    {
                        <p class="cd-note">This card only collects cashback. You can send its balance to your other Caspian cards, but money can't be transferred into it.</p>
                    }
                    else
                    {
                        <dl class="cd-list">
                            <div><dt>Cashback</dt><dd>@Percent(card.CashbackPercent)</dd></div>
                            <div><dt>Commission-free up to</dt><dd>@Money(card.TransferLimit)</dd></div>
                            <div><dt>Commission above limit</dt><dd>@Percent(card.CommissionPercent)</dd></div>
                            <div><dt>Opening fee</dt><dd>@Money(card.IssueFee)</dd></div>
                        </dl>
                    }
                </div>
            </section>
        </div>

        <section class="surface cd-activity" aria-labelledby="activity-title">
            <div class="spread">
                <h2 id="activity-title">Recent activity</h2>
                <a class="link-btn" asp-controller="History" asp-action="Index" asp-route-cardId="@card.Id">View all</a>
            </div>

            @if (Model.Transactions.Count == 0)
            {
                <div class="empty">
                    <h3>No activity yet</h3>
                    <p>Top ups, transfers and fees on this card will appear here.</p>
                </div>
            }
            else
            {
                <div>
                    @foreach (var t in Model.Transactions)
                    {
                        <partial name="_ActivityRow" model="t" />
                    }
                </div>
            }
        </section>

        @if (canTopUp)
        {
            <div class="modal" id="topup-modal" hidden data-open-on-load="@(topUpError is null ? "false" : "true")">
                <div class="modal-backdrop" data-close-modal></div>
                <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="topup-title">
                    <h2 id="topup-title">Top up</h2>
                    <p class="lede">Add money to <strong>@card.Tier · •••• @card.Last4</strong> from a Visa or Mastercard issued by another bank. To move money between your own Caspian cards, use Transfers.</p>
                    <p class="demo-note">
                        <span>Demo payment: no real money moves, and the card details are never stored.</span>
                        <button type="button" class="link-btn" data-demo-card>Use a demo card</button>
                    </p>
                    <form asp-action="TopUp" asp-route-id="@card.Id" method="post" class="form-stack" autocomplete="off" novalidate data-topup-form>
                        @if (topUpError is not null)
                        {
                            <p class="flash flash-error" role="alert">@topUpError</p>
                        }
                        <div class="field">
                            <label for="topup-amount">Amount (AZN)</label>
                            <div class="chips" role="group" aria-label="Quick amounts">
                                @foreach (var preset in new[] { 20, 50, 100, 200, 500 })
                                {
                                    <button type="button" class="chip" data-amount="@preset">@preset</button>
                                }
                            </div>
                            <input class="input" id="topup-amount" name="amount" inputmode="decimal" placeholder="1 - 5,000" autocomplete="off" />
                        </div>
                        <div class="field">
                            <label for="topup-number">Card number <span class="brand-tag" data-brand></span></label>
                            <input class="input" id="topup-number" name="sourceCardNumber" inputmode="numeric" maxlength="23" placeholder="1234 5678 9012 3456" autocomplete="off" data-card-number />
                        </div>
                        <div class="form-row">
                            <div class="field">
                                <label for="topup-expiry">Expiry</label>
                                <input class="input" id="topup-expiry" name="expiry" inputmode="numeric" maxlength="5" placeholder="MM/YY" autocomplete="off" data-expiry />
                            </div>
                            <div class="field">
                                <label for="topup-cvv">CVV</label>
                                <input class="input" id="topup-cvv" name="cvv" type="password" inputmode="numeric" maxlength="4" placeholder="•••" autocomplete="off" data-cvv />
                            </div>
                        </div>
                        <div class="modal-actions">
                            <button class="btn btn-secondary" type="button" data-close-modal>Cancel</button>
                            <button class="btn btn-primary" type="submit">Add money</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (!card.IsBlocked)
        {
            <div class="modal" id="block-modal" hidden data-open-on-load="@(blockError is null ? "false" : "true")">
                <div class="modal-backdrop" data-close-modal></div>
                <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="block-title">
                    <h2 id="block-title">Block this card?</h2>
                    <p class="lede">New purchases and transfers stop immediately. Confirm with the email and password on this account.</p>
                    <form asp-action="BlockCard" asp-route-id="@card.Id" method="post" class="form-stack" novalidate>
                        @if (blockError is not null)
                        {
                            <p class="flash flash-error" role="alert">@blockError</p>
                        }
                        <div class="field">
                            <label for="block-email">Email</label>
                            <input class="input" id="block-email" name="email" type="email" autocomplete="username" />
                        </div>
                        <div class="field">
                            <label for="block-password">Password</label>
                            <input class="input" id="block-password" name="password" type="password" autocomplete="current-password" />
                        </div>
                        <div class="modal-actions">
                            <button class="btn btn-secondary" type="button" data-close-modal>Cancel</button>
                            <button class="btn btn-danger" type="submit">Block card</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
</main>
