@model CardPageVM
@using System.Globalization
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Card details";
    var inv = CultureInfo.InvariantCulture;
    var card = Model.Card;
    var blockError = TempData["BlockError"] as string;
    var blockSentTo = TempData["BlockSentTo"] as string;
    var blockDevCode = TempData.Peek("BlockDevCode") as string;   // Peek: səhv kod yazılıb səhifə yenilənəndə demo kod itməsin
    var unblockError = TempData["UnblockError"] as string;
    var unblockSentTo = TempData["UnblockSentTo"] as string;
    var unblockDevCode = TempData.Peek("UnblockDevCode") as string;
    var topUpError = TempData["TopUpError"] as string;
    var isCashback = card is not null && card.Tier.Equals("Cashback", StringComparison.OrdinalIgnoreCase);
    var canTopUp = card is not null && !card.IsBlocked && !isCashback;

    string Money(decimal value) { return value.ToString("N2", inv) + " AZN"; }
    string Percent(decimal value) { return value.ToString("0.##", inv) + "%"; }

}
<main id="content" class="page cd-page">
    <a class="back" asp-action="Index">@T["All cards"]</a>

    @if (card is null)
    {
        <header class="page-head">
            <p class="eyebrow">@T["Card detail"]</p>
            <h1>@(Model.Unavailable ? T["We can't load this card"] : T["Card not found"])</h1>
        </header>
        <div class="empty">
            <h3>@(Model.Unavailable ? T["Service unavailable"] : T["Card not found"])</h3>
            <p>@(Model.Unavailable ? T["Please try again in a moment."] : T["This card isn't on your account."])</p>
            <a class="btn btn-secondary" asp-action="Index">@T["Back to cards"]</a>
        </div>
    }
    else
    {
        <header class="page-head">
            <p class="eyebrow">@T["Card detail"]</p>
            <h1>@T["{0} card", T[card.Tier]] <span class="cd-last4">•••• @card.Last4</span></h1>
        </header>

        <partial name="_Flash" />

        <div class="cd-grid">
            <section class="cd-visual" aria-label="@T["Card"]">
                <partial name="_Plastic" model="card" view-data='new ViewDataDictionary(ViewData) { { "Large", true }, { "Link", false } }' />

                <div class="cd-actions">
                    @if (canTopUp)
                    {
                        <button class="btn btn-primary" type="button" data-open-modal="topup-modal">@T["Top up"]</button>
                    }
                    @if (!card.IsBlocked)
                    {
                        <a class="btn btn-secondary" asp-controller="Transfer" asp-action="Index" asp-route-from="@card.Id">@T["Transfer"]</a>
                        @if (!isCashback)
                        {
                            <button class="btn btn-danger" type="button" data-open-modal="block-modal">@T["Block card"]</button>
                        }
                    }
                    else
                    {
                        <button class="btn btn-primary" type="button" data-open-modal="unblock-modal">@T["Unblock card"]</button>
                    }
                </div>
            </section>

            <section class="cd-side">
                <div class="cd-balance">
                    <span class="cd-label">@T["Available balance"]</span>
                    <strong class="cd-amount num">@card.Balance.ToString("N2", inv)<small>@T["AZN"]</small></strong>
                    <div class="cd-badges">
                        <span class="badge-pill @(card.IsBlocked ? "is-bad" : "is-ok")">@(card.IsBlocked ? T["Blocked"] : T["Active"])</span>
                        <span class="badge-pill">@card.Tier</span>
                    </div>
                </div>

                <div class="cd-panel">
                    <h3>@T["Card details"]</h3>
                    <dl class="cd-list">
                        <div><dt>@T["Cardholder"]</dt><dd>@card.HolderName</dd></div>
                        <div>
                            <dt>@T["Card number"]</dt>
                            <dd class="num">
                                @string.Join(" ", Enumerable.Range(0, card.CardNumber.Length / 4).Select(i => card.CardNumber.Substring(i * 4, 4)))
                                <button type="button" class="btn-copy" data-copy="@card.CardNumber" data-copy-label="@T["Card number"]">@T["Copy"]</button>
                            </dd>
                        </div>
                        <div><dt>@T["Expires"]</dt><dd>@card.Expiry</dd></div>
                    </dl>
                </div>

                <div class="cd-panel">
                    <h3>@T["Limits and fees"]</h3>
                    @if (isCashback)
                    {
                        <p class="cd-note">@T["This card only collects cashback. You can send its balance to your other Caspian cards, but money can't be transferred into it."]</p>
                    }
                    else
                    {
                        <dl class="cd-list">
                            <div><dt>@T["Cashback"]</dt><dd>@Percent(card.CashbackPercent)</dd></div>
                            <div><dt>@T["Commission-free up to"]</dt><dd>@Money(card.TransferLimit)</dd></div>
                            <div><dt>@T["Commission above limit"]</dt><dd>@Percent(card.CommissionPercent)</dd></div>
                            <div><dt>@T["Opening fee"]</dt><dd>@Money(card.IssueFee)</dd></div>
                        </dl>
                    }
                </div>
            </section>
        </div>

        <section class="surface cd-activity" aria-labelledby="activity-title">
            <div class="spread">
                <h2 id="activity-title">@T["Recent activity"]</h2>
                <a class="link-btn" asp-controller="History" asp-action="Index" asp-route-cardId="@card.Id">@T["View all"]</a>
            </div>

            @if (Model.Transactions.Count == 0)
            {
                <div class="empty">
                    <h3>@T["No activity yet"]</h3>
                    <p>@T["Top ups, transfers and fees on this card will appear here."]</p>
                </div>
            }
            else
            {
                <div>
                    @foreach (var t in Model.Transactions)
                    {
                        <partial name="_ActivityRow" model="t" />
                    }
                </div>
            }
        </section>

        @if (canTopUp)
        {
            <div class="modal" id="topup-modal" hidden data-open-on-load="@(topUpError is null ? "false" : "true")">
                <div class="modal-backdrop" data-close-modal></div>
                <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="topup-title">
                    <h2 id="topup-title">@T["Top up"]</h2>
                    <p class="lede">@T["Add money to"] <strong>@card.Tier · •••• @card.Last4</strong> @T["from a card of another bank or from another Caspian card. A Caspian card is charged for real."]</p>
                    <p class="demo-note">
                        <span>@T["A card of another bank is a demo: no real money moves, and the card details are never stored."]</span>
                        <button type="button" class="link-btn" data-demo-card>@T["Use a demo card"]</button>
                    </p>
                    <form asp-action="TopUp" asp-route-id="@card.Id" method="post" class="form-stack" autocomplete="off" novalidate data-topup-form>
                        @if (topUpError is not null)
                        {
                            <p class="flash flash-error" role="alert">@T[topUpError]</p>
                        }
                        <div class="field">
                            <label for="topup-amount">@T["Amount (AZN)"]</label>
                            <div class="chips" role="group" aria-label="@T["Quick amounts"]">
                                @foreach (var preset in new[] { 20, 50, 100, 200, 500 })
                                {
                                    <button type="button" class="chip" data-amount="@preset">@preset</button>
                                }
                            </div>
                            <input class="input" id="topup-amount" name="amount" inputmode="decimal" placeholder="1 - 5,000" autocomplete="off" />
                        </div>
                        <div class="field">
                            <label for="topup-number">@T["Card number"] <span class="brand-tag" data-brand></span></label>
                            <input class="input" id="topup-number" name="sourceCardNumber" inputmode="numeric" maxlength="23" placeholder="1234 5678 9012 3456" autocomplete="off" data-card-number />
                        </div>
                        <div class="form-row">
                            <div class="field">
                                <label for="topup-expiry">@T["Expiry"]</label>
                                <input class="input" id="topup-expiry" name="expiry" inputmode="numeric" maxlength="5" placeholder="@T["MM/YY"]" autocomplete="off" data-expiry />
                            </div>
                            <div class="field">
                                <label for="topup-cvv">@T["CVV"]</label>
                                <input class="input" id="topup-cvv" name="cvv" type="password" inputmode="numeric" maxlength="4" placeholder="•••" autocomplete="off" data-cvv />
                            </div>
                        </div>
                        <div class="modal-actions">
                            <button class="btn btn-secondary" type="button" data-close-modal>@T["Cancel"]</button>
                            <button class="btn btn-primary" type="submit">@T["Add money"]</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @* Bloklamaq / blokdan çıxarmaq emailə gələn 6 rəqəmli kodla təsdiqlənir (iki addımlı pəncərə) *@
        @if (!card.IsBlocked)
        {
            <partial name="_CardCodeModal" model='new CardCodeModalVM
            {
                Id = "block-modal",
                CardId = card.Id,
                Title = "Block this card?",
                Lede = "New purchases and transfers stop immediately. We email a 6-digit code to confirm it is you.",
                SendAction = "SendBlockCode",
                ConfirmAction = "BlockCard",
                ConfirmLabel = "Block card",
                ConfirmClass = "btn-danger",
                SentTo = blockSentTo,
                DevCode = blockDevCode,
                Error = blockError
            }' />
        }
        else
        {
            <partial name="_CardCodeModal" model='new CardCodeModalVM
            {
                Id = "unblock-modal",
                CardId = card.Id,
                Title = "Unblock this card?",
                Lede = "The card works again for top-ups and transfers. We email a 6-digit code to confirm it is you.",
                SendAction = "SendUnblockCode",
                ConfirmAction = "UnblockCard",
                ConfirmLabel = "Unblock card",
                ConfirmClass = "btn-primary",
                SentTo = unblockSentTo,
                DevCode = unblockDevCode,
                Error = unblockError
            }' />
        }
    }
</main>
