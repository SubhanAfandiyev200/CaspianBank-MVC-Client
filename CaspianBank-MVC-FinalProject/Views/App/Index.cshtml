@model AppIndexVM
@{
    Layout = "_AppLayout";

    // Ad claim-də tam adla saxlanılır (Name Surname): salamlama üçün ilk söz
    var fullName = User.Identity?.Name ?? string.Empty;
    var firstName = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "there";
    var hour = DateTime.Now.Hour;
    var hello = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
}
<main id="content" class="page">
    <header class="page-head">
        <p class="eyebrow">Cards</p>
        <h1 id="dash-title">@hello, @firstName</h1>
    </header>

    <partial name="_Flash" />

    @if (Model.ApiUnavailable)
    {
        <div class="empty">
            <h3>We can't load your cards</h3>
            <p>The service is unavailable right now. Please try again in a moment.</p>
            <a class="btn btn-secondary" asp-action="Index">Try again</a>
        </div>
    }
    else if (Model.Cards.Count == 0)
    {
        <div id="dash">
            <div class="empty">
                <h3>Add your first cards</h3>
                <p>Your account includes a Standard card and a Cashback card. Both are free.</p>
                <a class="btn btn-primary" href="@NavLinks.AddCard">Create my cards</a>
            </div>
        </div>
    }
    else
    {
        <div class="dash-top">
            <div class="deck">
                <div class="deck-stage" data-deck tabindex="0" aria-label="Your cards">
                    @foreach (var card in Model.Cards)
                    {
                        <partial name="_Plastic" model="card" />
                    }
                </div>
                <div class="deck-bar">
                    <button type="button" class="deck-arrow" data-deck-prev aria-label="Previous card">‹</button>
                    <div class="deck-dots" data-deck-dots></div>
                    <button type="button" class="deck-arrow" data-deck-next aria-label="Next card">›</button>
                </div>
                <a class="deck-add" href="@NavLinks.AddCard">Add a card</a>
            </div>
        </div>

        <section class="surface mt-5">
            <div class="spread">
                <h2>Recent activity</h2>
                <a class="link-btn" asp-controller="History" asp-action="Index">View all</a>
            </div>
            @if (Model.Activity.Count == 0)
            {
                <div class="empty"><h3>No activity yet</h3><p>Transactions on your cards will show up here.</p></div>
            }
            else
            {
                <div>
                    @foreach (var t in Model.Activity)
                    {
                        <partial name="_ActivityRow" model="t" />
                    }
                </div>
            }
        </section>
    }
</main>
