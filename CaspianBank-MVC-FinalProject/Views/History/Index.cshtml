@model HistoryIndexVM
@using System.Globalization
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Transaction history";
    var inv = CultureInfo.InvariantCulture;
    var f = Model.Filter;
    var r = Model.Result;

    string Money(decimal value) { return value.ToString("N2", inv) + " AZN"; }
    string Day(DateTime? value) { return value.HasValue ? value.Value.ToString("yyyy-MM-dd", inv) : string.Empty; }

    // Səhifələmə linkləri bütün filtrləri saxlayır (boş dəyərlər URL-ə düşmür)
    string PageUrl(int page)
    {
        return Url.Action("Index", "History", new
        {
            cardId = f.CardId,
            type = f.Type,
            direction = f.Direction,
            from = Day(f.From),
            to = Day(f.To),
            search = f.Search,
            page
        }) ?? string.Empty;
    }

    var hasFilter = f.CardId.HasValue || !string.IsNullOrEmpty(f.Type) || !string.IsNullOrEmpty(f.Direction)
                    || f.From.HasValue || f.To.HasValue || !string.IsNullOrWhiteSpace(f.Search);

    // Hansı dövr düyməsi aktivdir: tarix filtrinin hazır dövrlərdən birinə uyğun gəlib-gəlmədiyinə görə (JS ilə eyni qaydalar)
    string ActivePeriod()
    {
        if (!f.From.HasValue && !f.To.HasValue)
        {
            return "all";
        }
        var today = DateTime.Today;
        if (!f.From.HasValue || !f.To.HasValue || f.To.Value.Date != today)
        {
            return string.Empty;
        }
        var from = f.From.Value.Date;
        if (from == today) return "day";
        if (from == today.AddDays(-6)) return "week";
        if (from == new DateTime(today.Year, today.Month, 1)) return "month";
        if (from == new DateTime(today.Year, 1, 1)) return "year";
        return string.Empty;
    }
    var active = ActivePeriod();

    // Çıxarış pəncərəsinin ilkin dəyərləri: filtrdəki tarixlər (yoxdursa son 30 gün) və filtrdəki kart (yoxdursa ilk kart)
    var statementCardId = f.CardId ?? Model.Cards.FirstOrDefault()?.Id;
    var statementTo = f.To ?? DateTime.Today;
    var statementFrom = f.From ?? statementTo.AddDays(-30);

    var firstPage = Math.Max(1, r.Page - 2);
    var lastPage = Math.Min(r.TotalPages, r.Page + 2);

    CardUIVM? CardOf(int id) { return Model.Cards.FirstOrDefault(c => c.Id == id); }
}
<main id="content" class="page page-activity">
    <header class="page-head spread">
        <div>
            <p class="eyebrow">Activity</p>
            <h1>Transaction history</h1>
            <p class="lede">Every movement across your cards. Filter the view, or open a statement.</p>
        </div>
        @if (Model.Cards.Count > 0)
        {
            <button class="btn btn-secondary" type="button" data-open-modal="statement-modal">Generate statement</button>
        }
    </header>

    <partial name="_Flash" />

    @if (Model.ApiUnavailable)
    {
        <div class="empty">
            <h3>We can't load your history</h3>
            <p>The service is unavailable right now. Please try again in a moment.</p>
            <a class="btn btn-secondary" asp-action="Index">Try again</a>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <p class="flash flash-error" role="alert">@Model.Error</p>
        }

        <div class="pulse-row">
            <article class="pulse"><span>Movements</span><strong>@r.TotalCount</strong></article>
            <article class="pulse"><span>Money in</span><strong class="amount-in">+@Money(r.TotalIn)</strong></article>
            <article class="pulse"><span>Money out</span><strong class="amount-out">−@Money(r.TotalOut)</strong></article>
        </div>

        <section class="surface surface-tight">
            <form method="get" asp-controller="History" asp-action="Index" class="toolbar filters" id="history-form">
                <div class="field grow">
                    <span class="field-label" id="period-label">Period</span>
                    <div class="segment" role="group" aria-labelledby="period-label">
                        <button type="button" data-period="all" class="@(active == "all" ? "is-active" : "")">All</button>
                        <button type="button" data-period="day" class="@(active == "day" ? "is-active" : "")">Day</button>
                        <button type="button" data-period="week" class="@(active == "week" ? "is-active" : "")">Week</button>
                        <button type="button" data-period="month" class="@(active == "month" ? "is-active" : "")">Month</button>
                        <button type="button" data-period="year" class="@(active == "year" ? "is-active" : "")">Year</button>
                    </div>
                </div>
                <div class="field">
                    <label for="h-from">From</label>
                    <input class="input" id="h-from" type="date" name="From" value="@Day(f.From)" min="2020-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="field">
                    <label for="h-to">To</label>
                    <input class="input" id="h-to" type="date" name="To" value="@Day(f.To)" min="2020-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="field">
                    <label for="h-dir">Type</label>
                    <select class="select" id="h-dir" name="Direction" data-select>
                        <option value="">All</option>
                        <option value="in" selected="@(f.Direction == "in")">Income</option>
                        <option value="out" selected="@(f.Direction == "out")">Expense</option>
                    </select>
                </div>
                <div class="field">
                    <label for="h-card">Card</label>
                    <select class="select" id="h-card" name="CardId" data-card-pick>
                        <option value="" data-all selected="@(!f.CardId.HasValue)">All cards</option>
                        @foreach (var c in Model.Cards)
                        {
                            <option value="@c.Id" selected="@(f.CardId == c.Id)"
                                    data-tier="@c.Tier" data-last4="@c.Last4" data-money="@Money(c.Balance)" data-design="@c.DesignImage">@c.Tier · •••• @c.Last4</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="h-kind">Kind</label>
                    <select class="select" id="h-kind" name="Type" data-select>
                        <option value="">Any</option>
                        <option value="TopUp" selected="@(f.Type == "TopUp")">Top up</option>
                        <option value="TransferOut" selected="@(f.Type == "TransferOut")">Transfer sent</option>
                        <option value="TransferIn" selected="@(f.Type == "TransferIn")">Transfer received</option>
                        <option value="Commission" selected="@(f.Type == "Commission")">Commission</option>
                        <option value="CardFee" selected="@(f.Type == "CardFee")">Card fee</option>
                    </select>
                </div>
                <div class="field is-wide">
                    <label for="h-search">Search</label>
                    <div class="input-group has-prefix">
                        <span class="input-prefix" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
                        </span>
                        <input class="input" id="h-search" name="Search" maxlength="50" placeholder="Reference or note" autocomplete="off" value="@f.Search" />
                    </div>
                </div>
                @if (hasFilter)
                {
                    <a class="btn btn-secondary btn-sm hist-reset" asp-action="Index">Reset</a>
                }
            </form>

            <div class="table-wrap">
                <table class="data-table" id="history-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Card</th>
                            <th>Type</th>
                            <th class="num">Amount</th>
                            <th class="num">Balance after</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in r.Items)
                        {
                            var card = CardOf(t.CardId);
                            <tr>
                                <td>@t.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm", inv)</td>
                                <td>
                                    <span class="tx-line"><span class="tx-mark @(t.IsIncome ? "is-in" : "")" aria-hidden="true"></span><span>@t.Description@if (!string.IsNullOrEmpty(t.Note)){<small class="hint"> · “@t.Note”</small>}</span></span>
                                </td>
                                <td>
                                    @if (card is not null)
                                    {
                                        <span class="tx-card"><partial name="_CardThumb" model="card" view-data="@(new ViewDataDictionary(ViewData) { { "Row", true } })" /><span>@card.Tier · •••• @card.Last4</span></span>
                                    }
                                    else
                                    {
                                        @t.CardLabel
                                    }
                                </td>
                                <td><span class="badge @(t.IsIncome ? "badge-success" : "badge-danger")">@(t.IsIncome ? "Income" : "Expense")</span></td>
                                <td class="num"><span class="@(t.IsIncome ? "amount-in" : "amount-out")">@(t.IsIncome ? "+" : "−")@t.Amount.ToString("N2", inv) AZN</span></td>
                                <td class="num">@Money(t.BalanceAfter)</td>
                            </tr>
                        }
                        @if (r.Items.Count == 0)
                        {
                            <tr class="empty-row">
                                <td colspan="6">
                                    <div class="empty">
                                        <h3>@(hasFilter ? "No transactions" : "No activity yet")</h3>
                                        <p>@(hasFilter ? "Nothing matches these filters." : "Top ups, transfers and fees on your cards will appear here.")</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @if (r.TotalPages > 1)
        {
            <nav class="pager" aria-label="Pages">
                @if (r.Page > 1)
                {
                    <a class="pager-link" href="@PageUrl(r.Page - 1)">‹ Previous</a>
                }
                @if (firstPage > 1)
                {
                    <a class="pager-link" href="@PageUrl(1)">1</a>
                    @if (firstPage > 2)
                    {
                        <span class="pager-gap">…</span>
                    }
                }
                @for (var p = firstPage; p <= lastPage; p++)
                {
                    <a class="pager-link @(p == r.Page ? "is-current" : "")" href="@PageUrl(p)" aria-current="@(p == r.Page ? "page" : null)">@p</a>
                }
                @if (lastPage < r.TotalPages)
                {
                    @if (lastPage < r.TotalPages - 1)
                    {
                        <span class="pager-gap">…</span>
                    }
                    <a class="pager-link" href="@PageUrl(r.TotalPages)">@r.TotalPages</a>
                }
                @if (r.Page < r.TotalPages)
                {
                    <a class="pager-link" href="@PageUrl(r.Page + 1)">Next ›</a>
                }
            </nav>
        }

        @if (Model.Cards.Count > 0)
        {
            <div class="modal" id="statement-modal" hidden>
                <div class="modal-backdrop" data-close-modal></div>
                <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="statement-title">
                    <h2 id="statement-title">Generate statement</h2>
                    <p class="lede">A printable statement of one card for the dates you choose (up to one year), with the opening and closing balance.</p>
                    <form method="get" asp-controller="History" asp-action="Statement" class="form-stack">
                        <div class="field">
                            <label for="s-card">Card</label>
                            <select class="select" id="s-card" name="cardId" data-card-pick>
                                @foreach (var c in Model.Cards)
                                {
                                    <option value="@c.Id" selected="@(statementCardId == c.Id)"
                                            data-tier="@c.Tier" data-last4="@c.Last4" data-money="@Money(c.Balance)" data-design="@c.DesignImage">@c.Tier · •••• @c.Last4</option>
                                }
                            </select>
                        </div>
                        <div class="form-row">
                            <div class="field">
                                <label for="s-from">From</label>
                                <input class="input" id="s-from" type="date" name="from" value="@Day(statementFrom)" min="2020-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="field">
                                <label for="s-to">To</label>
                                <input class="input" id="s-to" type="date" name="to" value="@Day(statementTo)" min="2020-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>
                        <div class="modal-actions">
                            <button class="btn btn-secondary" type="button" data-close-modal>Cancel</button>
                            <button class="btn btn-primary" type="submit">Open statement</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
</main>

@section Scripts {
    <script src="~/js/wheel-date.js"></script>
}
